    @RequestMapping("/noOnboardApiLicenseKey")
    public  ArrayList<ReportLogBean> noOnboardApiLicenseKey(@RequestBody String reports){
        logger.info("calling  mspPartnerPolicyService from ReportsController for noOnboardDeviceList");
        org.json.JSONObject jsonObject = new org.json.JSONObject(reports);
        DateTimeFormatter formatter1 = DateTimeFormatter.ofPattern("dd-MM-yyyy");
        ArrayList<ReportLogBean> rptBean = new ArrayList<ReportLogBean>();
        String startDate = jsonObject.get("strtDate").toString();
        System.out.println("strtDate" + startDate);

        DateTimeFormatter formatter = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss");
        LocalDateTime startDateTime = LocalDateTime.parse(startDate + " 00:00:00", formatter);
        String endDate = jsonObject.get("endDate").toString();
        System.out.println("strtDate" + endDate);
        System.out.println(startDateTime);
        LocalDateTime endDateTime = LocalDateTime.parse(endDate + " 23:59:59", formatter);
        System.out.println(endDateTime);
        if(jsonObject.get("mode").toString().equals("API"))        {
            System.out.println("enter into" +jsonObject.get("mode").toString());
//            List<MSPPartnerPolicy> report =   mspPartnerPolicyService.getOnboardedApi(startDateTime ,endDateTime );
            List<PartnerPolicy> report =   partnerPolicyService.getOnboardedApi();

//        List<MSPDeviceModelRegistration> report = deviceModelRegistrationMSPService.noOnboardedDevice(jsonObject.get("mode").toString(),startDateTime,endDateTime);
        for(PartnerPolicy val : report){
            ReportLogBean bean= new ReportLogBean();
            bean.setPartnerId(val.getPartId());
            bean.setApi_license(val.getId());
            LocalDateTime validFrom = val.getValidFrom();
            String dateValidFrom = validFrom.format(formatter1);
            bean.setValidFrom(dateValidFrom);
            LocalDateTime validTo = val.getValidTo();
            String dateValidTo = validTo.format(formatter1);

            bean.setValidTo(dateValidTo);
            bean.setActiveStatus(val.isActive());
            rptBean.add(bean);
        }
        }else{
//            List<MSPMosipLicense> report =   mspMsipLicenseService.getOnboardedLicense(startDateTime ,endDateTime );
            List<MispLicenseKey> report =   mispLicenseKeyService.getOnboardedLicense();
            for(MispLicenseKey val : report){
                ReportLogBean bean= new ReportLogBean();
                bean.setPartnerId(val.getId());
                bean.setApi_license(val.getKey());
                LocalDateTime validFrom = val.getValidFrom();

                String dateValidFrom = validFrom.format(formatter1);

                bean.setValidFrom(dateValidFrom);
                LocalDateTime validTo = val.getValidTo();
                String dateValidTo = validTo.format(formatter1);

                bean.setValidTo(dateValidTo);
                bean.setActiveStatus(val.isActive());
                rptBean.add(bean);
            }
        }
        return rptBean;
    }
