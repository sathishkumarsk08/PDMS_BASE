	@RequestMapping(value = "/deleteUserCreation", method = RequestMethod.POST)
	public String deleteUserCreation(@RequestBody String id){
		String returnVal="";
		logger.info("calling from RPController for DeletePartnerReasons");
		int val=userService.deleteById(id);
		if(val >= 1){
			returnVal="User Deleted Successfully";
		}else{
			returnVal="User Deleted Failed";
		}
		return returnVal;	}

