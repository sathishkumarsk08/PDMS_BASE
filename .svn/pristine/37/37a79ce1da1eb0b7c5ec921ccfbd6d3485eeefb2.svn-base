	@RequestMapping(value = "/forgetPwd")
	public String emailExistorNot(@RequestBody String emailDet) throws JsonParseException, ParseException, NoSuchAlgorithmException, JSONException {

		JSONParser jsonParser = new JSONParser();
		emailDet.replace("","");
		org.json.simple.JSONObject jsonObject =new org.json.simple.JSONObject();
		jsonObject = (org.json.simple.JSONObject) jsonParser.parse(emailDet);
		String uname = (String) jsonObject.get("uname");

		JSONObject returnVal = new JSONObject("{\"mail\":\"\",\"update\":\"\",\"response\":\"\"}");
		Userdetails user = userService.getuserBymail(uname);
if(user != null){
	if (user.getActivestatus() == '1' ) {
		String initialPwd = createInitialPwd();
		user.setPassword(new MacAddress().md5Encode((initialPwd).getBytes()));
		user.setVerifycodePwd(initialPwd);
		user.setLoginStatus(null);

		String subject = "Forget Password";

		String mailTemplate = "Dear " + user.getFirstnameEn() + ", <br>\n<br>\n\t\n You can access following credentials.<br>\n Username : " + user.getUserName() + " <br>\n Password : " + initialPwd + " <br>\n<br>\n\n" +

				"                                 You can change password at any time for security reasons.<br>\n<br>\n\n" +
				"                                 Note : While changing the password for the first time and then every time you change the password, user are advised to use strong password that should have atleast 8 digits that are combination of lower case letters,  upper case letters, numbers and special characters <br>\n<br>\n\n" +
				"                                 Thanks & Regards,  <br>\n<br>\n\n" +
				"                                 PhilSys";

//			boolean mailResponse = new ApiController().sendmailprocess( reg.getEmailId(), "Signed Certificate", mailTemplate);
////				boolean mailResponse = new ApiController().sendmailprocess( "arunkrishna1410@gmail.com", "PARTNER Captcha", mailTemplate);
//			if(mailResponse){
//				System.out.println("------partnerId send------");
//
//			}else{
//				returnVal = "";
//			}
		try {
			EmailNotifyResponseDto response = mailService.emailNotification(uname, subject, mailTemplate,"");
			System.out.println("mail testing:" + response);
			if (response.getErrors() == null) {
				boolean out = userdao.updateAll(user);
				returnVal.put("mail", "success");
				returnVal.put("update", out);
				returnVal.put("response", "true");
			}
		} catch (Exception e) {
			e.printStackTrace();
		}

	}// chnage password screen
	else if (user != null && user.getLoginStatus() == null) {
		returnVal.put("response", "false");
	} // emai
	else if (user == null) {
		returnVal.put("response", "false");
	}
}else{
	returnVal.put("response", "false");
}
		return returnVal.toString();
	}
	@RequestMapping(value = "/pwdChange")
	public String forgotPasswordChange(HttpServletRequest request, ModelMap model, @RequestBody String password){
		String returnVal="true";
		try {
			logger.info("calling  from UserCreationController for pwdChange");
//			HttpSession session = request.getSession();
//			Userdetails user=(Userdetails)session.getAttribute("userDetails");

			JSONParser jsonParser = new JSONParser();
			password.replace("","");
			org.json.simple.JSONObject jsonObject =new org.json.simple.JSONObject();
			jsonObject = (org.json.simple.JSONObject) jsonParser.parse(password);
			Userdetails	user = userservice.getUserDetailsByUserid( jsonObject.get("userId").toString());
			String newpwd = (String) jsonObject.get("newpwd");
			String retypepwd = (String) jsonObject.get("retypepwd");
			String encpassword = new MacAddress().md5Encode(retypepwd.getBytes());

			userService.changepwdmail(newpwd,encpassword,user.getEmail());
//			users.setPassword(newpwd);
//			users.setVerifycodePwd(encpassword);
			System.out.println("new password"+newpwd);
			System.out.println("new password"+retypepwd);


		} catch (Exception e) {
			logger.error("calling  from UserCreationController for pwdChange",e.getMessage());
			e.printStackTrace();
		}

		return returnVal;
	}
	@RequestMapping(value = "/approveUsers", method = RequestMethod.POST)
	public String approveRegisters(@RequestBody String userid) throws JsonParseException, ParseException {
		logger.info("calling  from UserCreationController for approveUsers");
		System.out.println("approveRegisters in usercreation controller");
		String returnVal = "false";

		try{
			int out = userService.approveUser(userid);

			Userdetails userdetails = userService.getUserDetailsByUserid(userid);
			//System.out.println(userdetailsList.toString());
//		= userdetailsList.get(0);
			System.out.println(userdetails.getEmail() + "Email");
			System.out.println(userdetails.getFirstnameEn() + "FSTNAME");
			String template = "Greetings "+ userdetails.getFirstnameEn() +", <br>\n<br>\n\tYour Registration in Philippine's Identification System - PMS has been \n" +
					"                                 approved.You can access the same using following credentials.<br>\n Username : "+ userdetails.getEmail() +" <br>\n Password : "+ userdetails.getVerifycodePwd() +" <br>\n<br>\n\n" +
					"                                 Please access the IDA System by clicking http://61.95.183.11:8000/PMS <br>\n<br>\n\n" +
					"                                 You can change password at any time for security reasons.<br>\n<br>\n\n" +
					"                                 Note : While changing the password for the first time and then every time you change the password, user are advised to use strong password that should have atleast 8 digits that are combination of lower case letters,  upper case letters, numbers and special characters <br>\n<br>\n\n" +
					"                                 Thanks & Regards,  <br>\n<br>\n\n" +
					"                                 IDENTIFICATION SYSTEM OF PHILIPPINE.";
//		String emailId = "shiyamalakgisl@gmail.com";
//		String emailId = "gusantonylara@gmail.com";
			new ApiController().sendmailprocess(userdetails.getEmail(),"PHILIPPINE",template);

			returnVal = "true";
		}
		catch (Exception e){
			logger.error("calling  from UserCreationController for approveUsers",e.getMessage());
			returnVal = "false";
		}

		return returnVal;
	}
	@RequestMapping(value = "/declineUsers", method = RequestMethod.POST)
	public String declineRegisters(@RequestBody String userid) throws JsonParseException, ParseException {
		logger.info("calling  userService from UserCreationController for declineUsers");
		System.out.println("declineRegisters in usercreation controller"+userid);
		String returnVal = "true";
