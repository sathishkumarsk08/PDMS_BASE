	@RequestMapping(value = "/createUser", method = RequestMethod.POST)
	public String showWelcomePage(@RequestBody Userdetails userdet , HttpServletRequest request) throws JsonProcessingException {
		logger.info("calling userService from UserCreationController for createUser");

		String userRoleType = null;
		if(userdet.getUserRole() == 2){
            userRoleType = "Partner Admin";
		}else if(userdet.getUserRole() == 3){
			userRoleType = "Policy Admin";
		}

		auditRequestFactory.buildRequest(AuditModules.PDMS_USER,AuditEvents.USER_EVENT,"NO_ID","NO_IDTYPE","New "+userRoleType + " User creation request",request);

		System.out.println("saveUserDetails method in usercreationcontroller");
		String returnVal="false";
		try {
			System.out.println(userdet.getUserName()+"username");
			Userdetails user = userService.getuserByuser(userdet.getUserName(),userdet.getEmail());
			Userdetails getInput = new Userdetails();
			if(user==null || userdet.getUserRole() == null){
				Integer maxSno = 0;
				String mfid = null;
				int userIdGenerate = userService.maxUserid();

				if (userIdGenerate != 0) {
					maxSno = userIdGenerate;
				} else {
					maxSno = 1;
				}
				if (maxSno.toString().length() == 1) {
					mfid = "0000" + maxSno;
				}
				if (maxSno.toString().length() == 2) {
					mfid = "000" + maxSno;
				}
				if (maxSno.toString().length() == 3) {
					mfid = "00" + maxSno;
				}
				if (maxSno.toString().length() == 4) {
					mfid = "0" + maxSno;
				}
				System.out.println("user id: " + userIdGenerate);
				userdet.setUserid(mfid);
				userdet.setSno(userIdGenerate);
				userdet.setEnteredDate(new Date());
				userdet.setActivestatus('0');
				userdet.setUserRole(userdet.getUserRole());
				userdet.setMobileNumber(userdet.getMobileNumber());
				userdet.setPcnnumber(userdet.getPcnnumber());
				userdet.setOrgfile(userdet.getOrgfile());
				userdet.setPcnfile(userdet.getPcnfile());

//				userdet.setUsername(userdet.getUsername());

//	userdet.setBelongsTo(userdet.getBelongsTo());

				userdet.setIsloggedin(0);
				String password = userdet.getPassword();
				userdet.setVerifycodePwd(password);
				String encpassword = new MacAddress().md5Encode(password.getBytes());
				userdet.setPassword(encpassword);
				boolean out = userdao.saveAll(userdet);

				auditRequestFactory.buildRequest(AuditModules.PDMS_USER,AuditEvents.USER_EVENT,"NO_ID","NO_IDTYPE","New "+userRoleType + " User creation success and userid :"+mfid,request);

				returnVal="true";// registered success
				String template = "Greetings "+ userdet.getFirstnameEn() +", <br>\tYour Registration in Philippine's Identification System - PMS has been \n" +
						"                                 approved.You can access the same using following credentials.<br>\n Username : "+ userdet.getUserName() +" <br>\n Password : "+ password+" <br>\n" +

						"                                 You can change password at any time for security reasons.<br>\n" +
						"                                 Note : While changing the password for the first time and then every time you change the password, user are advised to use strong password that should have atleast 8 digits that are combination of lower case letters,  upper case letters, numbers and special characters <br>\n" +
						"                                 Thanks & Regards,  <br>\n" +
						"                                PhilSys.";
//		String emailId = "shiyamalakgisl@gmail.com";
//		String emailId = "gusantonylara@gmail.com";
//				new ApiController().sendmailprocess(userdet.getEmail(),"PHILIPPINE",template);
				EmailNotifyResponseDto response = mailService.emailNotification(userdet.getEmail(), "User credentials", template , "");
			}else{
				returnVal="false"; //login -- already registered
				auditRequestFactory.buildRequest(AuditModules.PDMS_USER,AuditEvents.USER_EVENT,"NO_ID","NO_IDTYPE","New "+userRoleType + " User creation failed",request);
			}

		} catch (Exception e) {
			logger.error("calling userService from UserCreationController for createUser",e.getMessage());
			auditRequestFactory.buildRequest(AuditModules.PDMS_USER,AuditEvents.USER_EVENT,"NO_ID","NO_IDTYPE","New "+userRoleType + " User creation failed",request);

			e.printStackTrace();
		}
		return returnVal; //same screen refresh

	}


