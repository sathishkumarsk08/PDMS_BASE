	@RequestMapping(value = "/viewUserList")
	public ArrayList<Userdetails> viewUserDetail(HttpServletRequest request) throws JsonProcessingException {
		logger.info("calling  userService from UserCreationController for viewUserList");
		auditRequestFactory.buildRequest(AuditModules.PDMS_USER,AuditEvents.USER_EVENT,"NO_ID","NO_IDTYPE","View all users request",request);
		ArrayList<Userdetails> userList = new ArrayList<>();
		try {
			userList = (ArrayList<Userdetails>) userService.viewUserDetail();
			auditRequestFactory.buildRequest(AuditModules.PDMS_USER,AuditEvents.USER_EVENT,"NO_ID","NO_IDTYPE","View all users success",request);
		}catch (Exception e){
			auditRequestFactory.buildRequest(AuditModules.PDMS_USER,AuditEvents.USER_EVENT,"NO_ID","NO_IDTYPE","View all users failed",request);
			e.printStackTrace();
		}


		return userList;
	}
