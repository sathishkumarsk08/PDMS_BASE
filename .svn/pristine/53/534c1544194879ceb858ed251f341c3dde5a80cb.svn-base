    @RequestMapping(value = "/login", method = RequestMethod.POST)
    public UserdetailBean showWelcomePage(@RequestBody String logindet, HttpServletRequest request) throws JsonParseException, ParseException, NoSuchAlgorithmException {
        logger.info("calling  from LoginController for login");
//        String logindet="";
    
        String returnval = "";
//        Userdetails userDetail = new Userdetails();
        Userdetails user = null;
        UserdetailBean userdetails = new UserdetailBean();
       
        int userRole = 0;
        System.out.println("login=LoginController:showWelcomePage");
        
        String Jsonobject = null;
        try {

            session = request.getSession();
            System.out.println("logindet :" + logindet);
//             session = request.getSession();
            //	session.setMaxInactiveInterval(600);
            JSONParser jsonParser = new JSONParser();
     
            logindet.replace("", "");
            JSONObject jsonObject = new JSONObject();
            jsonObject = (JSONObject) jsonParser.parse(logindet);
            String uname = (String) jsonObject.get("uname");
            String pwd = (String) jsonObject.get("pwd");


//          String  encodePwd = new MacAddress().md5Encode(pwd.getBytes());

      
            user = userservice.getUserLoginDetail(uname, pwd);
            String rolename = mspRoles.getRoleType(user.getUserRole());
            System.out.println("role name"+rolename+",roleId"+user.getUserRole());
       
            if (user != null) {
                session.setAttribute("userId", user.getUserid());
                session.setMaxInactiveInterval(600);
//                System.out.println("login userId:"+session.getAttribute("userId"));
                List<ParentBean> userMenu = menuCreation(user.getUserRole().toString());
                RegistratedCount val1 = countRegistration( user.getUserid(),user.getUserRole());
                userdetails.setCount(val1);
                userdetails.setUserid(user.getUserid());
                userdetails.setEmail(user.getEmail());
                userdetails.setBelongsTo(user.getBelongsTo());
                userdetails.setFirstnameEn(user.getFirstnameEn());
//                userdetails.setPlaceAssigned(user.getPlaceAssigned());
                userdetails.setLockstatus(user.getLockstatus());
//                userdetails.setActiveDeactive(user.getActiveDeactive());
                userdetails.setLoginStatus(user.getLoginStatus());
                userdetails.setActivestatus(user.getActivestatus());
                userdetails.setUserRoleId(user.getUserRole());
                userdetails.setRoleName(user.getUserName());
                userdetails.setUserMenu(userMenu);
                Date val = user.getLogoutTime();
                if(val != null){
                    SimpleDateFormat sdf3 = new SimpleDateFormat("yyyy-MM-dd HH:mm:ss");
                    userdetails.setLoginStatus(sdf3.format(val));

                }
            }
         
            System.out.println("testing data:" + userdetails);
//            logger.info("Login sucessful.");
        } catch (Exception e) {
            e.printStackTrace();
        }
        return userdetails;
    }

    private RegistratedCount countRegistration(String userid, int userRole) {
        RegistratedCount count = new RegistratedCount();
        ArrayList<PolicyType> viewpolicytype = new ArrayList<PolicyType>();
        List<String> rejected = new ArrayList<>();
        List<String> approved = new ArrayList<>();
        List<String> waiting = new ArrayList<>();
        int policyCount ;
        try{

            if(userRole == 1 || userRole == 3){
                count.setUserCount(userservice.getcount());
                count.setPolicyGroupCount(policyGroupService.getRoleBasedCount());
                rejected =(List<String>) mspPolicyTypeService.getRejectedPolicies();
                approved =(List<String>) mspPolicyTypeService.getApprovedPolicies();
                waiting =(List<String>) mspPolicyTypeService.getWaitingPolicies();
                viewpolicytype = (ArrayList<PolicyType>) policyTypeService.viewListPolicyType(waiting);
                policyCount = viewpolicytype.size();
                viewpolicytype = (ArrayList<PolicyType>) policyTypeService.viewListPolicyType(approved);
                policyCount+= viewpolicytype.size();
                viewpolicytype = (ArrayList<PolicyType>) policyTypeService.viewListPolicyType(rejected);
                policyCount+= viewpolicytype.size();
                System.out.println("policy count:"+policyCount);
//                count.setPoliciesCount(policyTypeService.getCount());
                count.setPoliciesCount(policyCount);
                count.setPartnerRegistrationCount(partnerRegistrationService.getAuthPartnerCount());
                count.setDeviceRegistrationCount(partnerRegistrationService.getDeviceCount());
                List<String> deviceCount =partnerRegistrationService.getOnlyDeviceCount();
                count.setOnlyDeviceRegistrationCount(deviceModelRegistrationMSPService.getOnlyDeviceCount(deviceCount));
            }else{
                count.setUserCount(userservice.getcount());
                count.setPolicyGroupCount(policyGroupService.getCount(userid));
                rejected =(List<String>) mspPolicyTypeService.getRejectedPolicies(userid);
                approved =(List<String>) mspPolicyTypeService.getApprovedPolicies(userid);
                waiting =(List<String>) mspPolicyTypeService.getWaitingPolicies(userid);
                viewpolicytype = (ArrayList<PolicyType>) policyTypeService.viewListPolicyType(waiting);
                policyCount = viewpolicytype.size();
                viewpolicytype = (ArrayList<PolicyType>) policyTypeService.viewListPolicyType(approved);
                policyCount+= viewpolicytype.size();
                viewpolicytype = (ArrayList<PolicyType>) policyTypeService.viewListPolicyType(rejected);
                policyCount+= viewpolicytype.size();
//                count.setPoliciesCount(policyTypeService.getCount(userid));
                count.setPoliciesCount(policyCount);
                count.setPartnerRegistrationCount(partnerRegistrationService.getAuthPartnerCount(userid));
                count.setDeviceRegistrationCount(partnerRegistrationService.getDeviceCount(userid));
                List<String> deviceCount =partnerRegistrationService.getOnlyDeviceCount(userid);
                count.setOnlyDeviceRegistrationCount(deviceModelRegistrationMSPService.getOnlyDeviceCount(deviceCount));
            }

        }catch (Exception e){
            e.printStackTrace();
        }
        return count;
    }
