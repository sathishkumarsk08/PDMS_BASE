    @RequestMapping(value ="/logout")
    public String logout(@RequestBody String userId){
        String returnVal="";
        logger.info("calling  userService from logout ");
        Date timestamp = new Date(System.currentTimeMillis());
        int val = userservice.updateLogOut(userId,timestamp);
        if(val >= 1){
            returnVal= "true";
        }else{
            returnVal= "false";
        }
        return returnVal;
    }
