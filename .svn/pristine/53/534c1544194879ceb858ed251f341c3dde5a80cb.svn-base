    @RequestMapping(value = "/firstLoginChangePassword")
    //public String firstLoginChangePassword(ModelMap model, @RequestParam String userOldPassword,
    //	@RequestParam String password, HttpServletRequest request) {
    public String firstLoginpwdchnage(@RequestBody String logindet) throws com.fasterxml.jackson.core.JsonParseException, NoSuchAlgorithmException, ParseException {
        logger.info("calling  from  LoginController for firstLoginChangePassword");

        //HttpSession session = request.getSession();
        //	session.setMaxInactiveInterval(600);
        JSONParser jsonParser = new JSONParser();
     
        logindet.replace("", "");
        org.json.simple.JSONObject jsonObject = new org.json.simple.JSONObject();
        jsonObject = (org.json.simple.JSONObject) jsonParser.parse(logindet);
        String newPass = (String) jsonObject.get("newpwd");
        String oldpwd = (String) jsonObject.get("oldpwd");
        String emailID = (String) jsonObject.get("email");
      
        System.out.println("Old Pwd :" + oldpwd);
        String oldPasswordEncrip = null;
        String newPasswordEncrip = null;
     
        String returnVal = null;
        try {

            if (oldpwd != null) {
                oldPasswordEncrip = new MacAddress().md5Encode(oldpwd.getBytes());
            }
            if (newPass != null) {
                newPasswordEncrip = new MacAddress().md5Encode(newPass.getBytes());
            }
           
            Userdetails user = userservice.findbyOldPwd(oldpwd, emailID);
            System.out.println("firstLoginChangePassword Method" + user.getUserid());
            if (user != null) {
                if (user.getPassword().equals(oldPasswordEncrip)) {

                    if (!oldPasswordEncrip.equals(newPasswordEncrip)) {
                        user.setPassword(newPasswordEncrip);
                        user.setVerifycodePwd(newPass);
                   
                       user.setLoginStatus("pwdChanged");

                        boolean out = userDao.UpdateStatus(user, user.getUserid());

//                         int out = userservice.updatePasswordDetails("pwdChanged", user.getUserid());

                        if (out) {
                       
                            returnVal = "true";//login page
                            //"PASSWORD UPDATED SUCCESSFULLY.";

                        } else {

                          
                            returnVal = "false";//"Error While Processing.Please Try Again Later";
                        }
                 
                   } else {
                        
                        returnVal = "false";//"Old Password and New Password should not be same ";
                    }

                } else {                
                   returnVal= "false";//"Invalid Old Password";
                }
            } else {
               
                returnVal = "false";//"No Data Found";
            }

        } catch (Exception e) {
          
            logger.error("calling  from  LoginController for firstLoginChangePassword", e.getMessage());
            e.printStackTrace();
        }

        return returnVal;
    }

    @RequestMapping(value = "/changePasswordDetails")
    public String changePasswordDetails(HttpServletRequest request, ModelMap model) {
        logger.info("calling  from  LoginController for changePasswordDetails");
        try {

            HttpSession session = request.getSession(false);
//            session.setMaxInactiveInterval(600);
            Userdetails user = (Userdetails) session.getAttribute("userdetails");

            if (user != null) {
                model.addAttribute("userdetail", user);
            }
        } catch (Exception e) {
        
           logger.error("calling  from  LoginController for changePasswordDetails",e.getMessage());
          e.printStackTrace();
        }
        return "changePassword";
    }

    @RequestMapping(value = "/updatePassword")
    public String updatePassword(HttpServletRequest request, ModelMap model, @RequestParam String password) {
        logger.info("calling  from  LoginController for updatePassword");
        try {
            HttpSession session = request.getSession(false);
            session.setMaxInactiveInterval(600);
            Userdetails user = (Userdetails) session.getAttribute("userdetails");
            String encpassword = new MacAddress().md5Encode(password.trim().getBytes());
            int out = userservice.updatePasswordDetails(encpassword, password, user.getUserid());
            if (out > 0) {
                model.put("successMessage", "PASSWORD UPDATED SUCCESSFULLY. PLEASE LOGIN TO CONTINUE..");
            } else {
                model.put("errorMessage", "ERROR WHILE UPDATING PASSWORD!!PLEASE TRY LATER");
            }
        } catch (Exception e) {
      
            e.printStackTrace();
        }
        return "login";
    }

 
    //    @RequestMapping(value="/userMenu",method = RequestMethod.POST)
    public List<ParentBean> menuCreation(String roleid) {
        logger.info("calling  from  LoginController for userMenu");
    
        System.out.println("roleId:" + roleid);
        int roleId = Integer.parseInt(roleid);
        List<MSPFeatureMaster> parentId = null;
        List<MSPFeatureMaster> firstSubMenuList = null;
        List<MSPFeatureMaster> secondSubMenuList = null;
        String submenu = "2", childSubMenu = "3";
        SecondChildBean secondChildBean = null;

        ParentBean parentBean = null;
        List<ParentBean> parentArray = new ArrayList<ParentBean>();
        try {
            parentId = mspFeatureMasterService.getParentManu(roleId);
            List<Integer> parentIdList = mspFeatureMasterService.getParentManuId(roleId);
            firstSubMenuList = mspFeatureMasterService.getSubMenu(roleId, parentIdList);
            List<Integer> submenuIdList = mspFeatureMasterService.getSubMenuId(roleId, parentIdList);
            secondSubMenuList = mspFeatureMasterService.getSubMenuChild(roleId, submenuIdList);

            for (int i = 0; i < parentId.size(); i++) {
                parentBean = new ParentBean();
                parentBean.setMenuName(parentId.get(i).getMenuName());
                parentBean.setMenuURL(parentId.get(i).getMenuUrl().toString());
                parentBean.setMenuImage(parentId.get(i).getMenuImage().toString());
                int getParentId = parentId.get(i).getId();
//                firstSubMenuList =  mspFeatureMasterService.getSubMenu(roleId , getParentId);
//                System.out.println("fist child  ending time:"+ APIConnection.getUTCCurrentDateTime());
                List<FristChildBean> firstChildArray = new ArrayList<FristChildBean>();
                if (firstSubMenuList.size() > 0) {
                    for (int j = 0; j < firstSubMenuList.size(); j++) {
                        FristChildBean firstChildBean = new FristChildBean();
                        int childid = Integer.valueOf(firstSubMenuList.get(j).getParentId());
                        int submenufeatureid = Integer.valueOf(firstSubMenuList.get(j).getId());

                        firstChildBean.setMenuName(firstSubMenuList.get(j).getMenuName());
                        firstChildBean.setMenuURL(firstSubMenuList.get(j).getMenuUrl());
                        firstChildBean.setMenuImage(firstSubMenuList.get(j).getMenuImage());

                        if (getParentId == childid) {
                            firstChildArray.add(firstChildBean);
                        }
//                        int getFirstMenuId = firstSubMenuList.get(j).getId();
//                        System.out.println("second child starting time:"+ APIConnection.getUTCCurrentDateTime());
//                        secondSubMenuList =  mspFeatureMasterService.getSubMenuChild(roleId , getFirstMenuId);
//                        System.out.println("second child ending time:"+ APIConnection.getUTCCurrentDateTime());
                        List<SecondChildBean> secondChildArray = new ArrayList<SecondChildBean>();
                        if (secondSubMenuList.size() > 0) {
                            for (int k = 0; k < secondSubMenuList.size(); k++) {
                                 
                                secondChildBean = new SecondChildBean();

                                int subchildid = Integer.parseInt(secondSubMenuList.get(k).getParentId());

                                secondChildBean.setMenuName(secondSubMenuList.get(k).getMenuName());
                                secondChildBean.setMenuURL(secondSubMenuList.get(k).getMenuUrl());
                                secondChildBean.setMenuImage(secondSubMenuList.get(k).getMenuImage());

                                if (submenufeatureid == subchildid) {
                                    secondChildArray.add(secondChildBean);
                                }
                            }
                            firstChildBean.setChildren(secondChildArray);

               
                        } else {
                            firstChildBean.setChildren(secondChildArray);

                        }

                    }
                    parentBean.setChildren(firstChildArray);

             
                } else {
                    parentBean.setChildren(firstChildArray);
                }
                parentBean.setChildren(firstChildArray);
                parentArray.add(parentBean);

            }

           
//            System.out.println("final array:" + parentBean);


        } catch (Exception e) {
            logger.error("calling  from  LoginController for userMenu", e.getMessage());
            e.printStackTrace();
        }
        return parentArray;
    }
