package com.msp.Audit.Factory;

import com.fasterxml.jackson.core.JsonProcessingException;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.google.gson.Gson;
import com.msp.Audit.*;
import com.msp.common.APIConnection;
import com.msp.common.Encryption;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Component;

import javax.servlet.http.HttpServletRequest;
import java.net.InetAddress;
import java.net.UnknownHostException;
import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;
import java.util.Map;
import java.util.ResourceBundle;

@Component
public class AuditRequestFactory {
    private static final String DEFAULT_HOST_NAME = "localhost";

    private static final String DEFAULT_HOST_ADDRESS = "127.0.0.1";


    @Autowired
    private Encryption encrypt;

    @Autowired
    private Gson gson;
    /**
     * Builds the request.
     *
     * @param module the module
     * @param event the event
     * @param id the id
     * @param idType the id type enum
     * @param desc the desc
     * @return the audit request dto
     */
//    public RequestWrapper<AuditRequestDto> buildRequest(AuditModule module, AuditEvents event, String id, IdType idType, String desc) throws JsonProcessingException {
//        return buildRequest(module, event, id, idType.name(), desc);
//    }

    /**
     * Builds the request.
     *
     * @param module the module
     * @param event the event
     * @param id the id
     * @param idType the id type name
     * @param desc the desc
     * @return the audit request dto
     */
    public RequestWrapper<AuditRequestDto> buildRequest(AuditModules module, AuditEvents event, String id, String idType, String desc, HttpServletRequest servletRequest) throws JsonProcessingException {
        AuditRequestDto request = new AuditRequestDto();
        ResourceBundle bundle = APIConnection.readConfig();

        String hostName;
        String hostAddress;

        try {
            InetAddress inetAddress = InetAddress.getLocalHost();
            hostName = inetAddress.getHostName();
            hostAddress = inetAddress.getHostAddress();
        } catch (UnknownHostException ex) {
            ex.printStackTrace();
            hostName = DEFAULT_HOST_NAME;
            hostAddress = servletRequest.getRemoteHost();
        }

        request.setEventId(event.getEventId());
        request.setEventName(event.getEventName());
        request.setEventType(event.getEventType());
        request.setActionTimeStamp(encrypt.getUTCCurrentDateTime().format(DateTimeFormatter.ofPattern("yyyy-MM-dd'T'HH:mm:ss.SSS'Z'")));
//        System.out.println("encrypt.getUTCCurrentDateTime()1 :"+ encrypt.getUTCCurrentDateTime().format(DateTimeFormatter.ofPattern("yyyy-MM-dd'T'HH:mm:ss.SSS'Z'")));
//        System.out.println("local time "+ LocalDateTime.now());
        request.setHostName(hostName);
        request.setHostIp(hostAddress);
        request.setApplicationId(bundle.getString("application.id"));
        request.setApplicationName(bundle.getString("application.name"));
        request.setSessionUserId(bundle.getString("auth.appid"));
        request.setSessionUserName(bundle.getString("auth.username"));
        request.setIdType(idType);
        request.setCreatedBy(bundle.getString("auth.username"));
        request.setModuleName(module.getModuleName());
        request.setModuleId(module.getModuleId());
        request.setDescription(desc);
        request.setId(id);
        return createRequest(request);
    }
    public <T> RequestWrapper<T> createRequest(T t) throws JsonProcessingException {
        RequestWrapper<T> request = new RequestWrapper<>();
        ResourceBundle bundle = APIConnection.readConfig();
        request.setRequest(t);
        request.setId("pdms");
        request.setRequestTime(encrypt.getUTCCurrentDateTime().toString());
//        System.out.println("encrypt.getUTCCurrentDateTime()2 :"+ encrypt.getUTCCurrentDateTime().toString());
        request.setVersion("v1");
        System.out.println("request2:" +request);
        String url = bundle.getString("audit.rest.uri");
        System.out.println("url ="+ bundle.getString("audit.rest.uri"));
        System.out.println("gson data :" +gson.toJson(request));
        String record = APIConnection.connectApi(url,
                "POST", gson.toJson(request), "Cookie");
        ObjectMapper objectMapper = new ObjectMapper();
        Map<String, Object> stringObjectMap = objectMapper.readValue(record, Map.class);
        AuditResponseDto response = gson.fromJson(gson.toJson(stringObjectMap.get("response")), AuditResponseDto.class);
        return request;
    }


}
