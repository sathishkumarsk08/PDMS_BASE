package com.msp.pms.msppmsmodel;

import lombok.Data;
import lombok.Getter;
import lombok.Setter;

import javax.persistence.*;
import java.time.LocalDateTime;
@Entity
@Table(name = "device_model_register" ,schema ="msppms")
@Data
@Getter
@Setter
public class MSPDeviceModelRegistration implements java.io.Serializable{
    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    @Column(name = "dev_reg_sno")
    private Integer Regno;
    @Column(name = "device_id")
        private String id;
    @Column(name = "org_name")
        private String name;
    @Column(name = "partner_type")
        private String partnerType;
    @Column(name = "mobile_no")
        private String mobilenumber;
    @Column(name = "email_id")
        private String email;
    @Column(name = "dev_status")
        private String status;
    @Column(name = "dev_created_by")
        private Integer createdBy;
    @Column(name = "dev_crdtimes")
        private LocalDateTime crDtTime;
    @Column(name = "user_id")
        private Integer userId;
    @Column(name = "dev_updated_by")
        private Integer updBy;
    @Column(name = "dev_updtimes")
        private LocalDateTime upDtTime;
    @Column(name = "is_deleted")
        private boolean isDeleted;
    @Column(name = "dev_del_dtimes")
        private LocalDateTime delDateTime;
    @Column(name = "dev_suspended")
        private String suspended;
    @Column(name = "dev_blacklisted")
        private String blacklisted;
    @Column(name = "dev_revoked")
        private String revoked;
    @Column(name = "policy_group")
        private Integer policyType;
    @Column(name = "cert_alias_device")
        private String certAlias;
    @Column(name = "cert_alias_ftm")
    private String certAliasFTM;
    @Column(name = "device_ftm")
    private String deviceFtm;
    @Column(name = "flag")
    private Integer flag;
    @Column(name = "brand_name")
    private String brandName;
    @Column(name = "device_model")
    private String deviceModel;
    @Column(name = "device_type")
    private String deviceType;
    @Column(name = "device_status")
    private String deviceStatus;
    @Column(name = "address")
    private String address;
    @Column(name = "sus_black_status")
    private String susBlackStatus;


    public String getSusBlackStatus() {
        return susBlackStatus;
    }

    public void setSusBlackStatus(String susBlackStatus) {
        this.susBlackStatus = susBlackStatus;
    }

