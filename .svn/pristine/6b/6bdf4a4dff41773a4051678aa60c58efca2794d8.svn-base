    @RequestMapping("/policy")
    public String getPolicy(HttpServletRequest request) throws NoSuchAlgorithmException, KeyManagementException, JsonProcessingException {
        logger.info("calling from RPController for policy");
        turnOffSslChecking();
        APIConnection.authenticate();
        ResourceBundle bundle = APIConnection.readConfig();
        mspAuditLogs.setAuditRequestDto(PartnerManageEnum.GET_ALL_POLICIES,request);
        auditRequestFactory.buildRequest(AuditModules.PDMS_POLICY_GROUP, AuditEvents.POLICY_GRP_EVENT,"NO_ID","NO_IDTYPE","Get all policy request",request);

        //         /v1/policymanager/policies
        return APIConnection.connectApi(bundle.getString("base.url") + bundle.getString("version") + bundle.getString("policymanager.url"),
                "GET", "", "Cookie");
    }

    @RequestMapping(value = "/createGroupPlicy")
    public String createGroupPolicy(@RequestBody String groupname, HttpServletRequest request) throws NoSuchAlgorithmException,
            KeyManagementException, JsonProcessingException {
        logger.info("calling from RPController for createGroupPolicy");
        mspAuditLogs.setAuditRequestDto(PartnerManageEnum.CREATE_POLICY_GROUP,request);
        auditRequestFactory.buildRequest(AuditModules.PDMS_POLICY_GROUP, AuditEvents.POLICY_GRP_EVENT,"NO_ID","NO_IDTYPE","Create policy group request",request);

        System.out.println("1.enter in Policy group ");
        turnOffSslChecking();
        APIConnection.authenticate();
        String returnVal = null;
        ResourceBundle bundle = APIConnection.readConfig();
//        System.out.println("username "+loginController.getUserName());

        org.json.JSONObject template = new org.json.JSONObject(bundle.getString("template"));
        org.json.JSONObject jsonObject = new org.json.JSONObject(groupname);

        try {
            org.json.JSONObject requestTemp = template.getJSONObject("request");
            requestTemp.put("name", jsonObject.get("policyGroupName"));
            requestTemp.put("desc", jsonObject.get("policyGroupDescription"));
            template.put("requesttime", APIConnection.formatToISOString(APIConnection.getUTCCurrentDateTime()));
            template.put("request", requestTemp);


        } catch (Exception e) {
            logger.error("calling from RPController for createGroupPolicy",e.getMessage());
            e.printStackTrace();
        }
        System.out.println("2. Template to Msoip:" + template.toString());
        //         /v1/policymanager/policies/group/new
        String record = APIConnection.connectApi(bundle.getString("base.url") + bundle.getString("version") + bundle.getString("policymanager.url") +
                "/group/new", "POST", template.toString(), "Cookie");

        System.out.println("3. output from Mosip :" + record);
        org.json.JSONObject jsoninput = new org.json.JSONObject(record);
        String responseData = (jsoninput.get("response")).toString();
        if (responseData.equals("null")) {
            mspAuditLogs.setAuditRequestDto(PartnerManageEnum.CREATE_POLICY_GROUP_FAILURE,request);
            auditRequestFactory.buildRequest(AuditModules.PDMS_POLICY_GROUP, AuditEvents.POLICY_GRP_EVENT,"NO_ID","NO_IDTYPE","Failed to create policy group",request);

            returnVal = "false";
            JSONArray responseApi = jsoninput.getJSONArray("errors");
            org.json.JSONObject rec = responseApi.getJSONObject(0);
            returnVal = rec.getString("message");
//            mspPolicyGroupService.deleteById("xyz");

        } else {
            returnVal = "true";
            org.json.JSONObject jsoninput1 = new org.json.JSONObject(responseData);
            System.out.println("response data :" + jsoninput1);
            System.out.println("response value:" + jsoninput1.get("id"));
            PolicyGroupPms policy = new PolicyGroupPms();
            policy.setId(jsoninput1.get("id").toString());
            policy.setName(jsonObject.get("policyGroupName").toString());
            policy.setDescr(jsonObject.get("policyGroupDescription").toString());
            policy.setUserId(jsonObject.get("userId").toString());
            policy.setCrBy(jsonObject.get("userId").toString());
            policy.setStatus("true");
            policy.setCrDtimes(APIConnection.getUTCCurrentDateTime());
            mspPolicyGroupService.save(policy);
//            mspPolicyGroupService.changeId( jsoninput1.get("id").toString(),"xyz");
            PolicyGroupService.changeUserId(jsonObject.get("userId").toString(),jsoninput1.get("id").toString());
            System.out.println("4. data saved in local pms :");
            mspAuditLogs.setAuditRequestDto(PartnerManageEnum.CREATE_POLICY_GROUP_SUCCESS,request);
            auditRequestFactory.buildRequest(AuditModules.PDMS_POLICY_GROUP, AuditEvents.POLICY_GRP_EVENT,"NO_ID","NO_IDTYPE",jsoninput1.get("id") +"Create policy group success",request);

        }
        return record;

    }

    @RequestMapping(value = "/viewPolicyGroup")
    public ArrayList<PolicyGroup> viewUserDetail(@RequestParam String userId, HttpServletRequest request) throws JSONException, JsonProcessingException {
        logger.info("calling from RPController for viewPolicyGroup");
        mspAuditLogs.setAuditRequestDto(PartnerManageEnum.GET_ALL_POLICY_GROUPS,request);
        auditRequestFactory.buildRequest(AuditModules.PDMS_POLICY_GROUP, AuditEvents.POLICY_GRP_EVENT,"NO_ID","NO_IDTYPE","Getting all policy groups",request);

        System.out.println("userdetail userId:"+ userId);
        ArrayList<PolicyGroup> userList = null;
        try {
//			userList = (ArrayList<PolicyGroupPms>) mspPolicyGroupService.viewPolicyDetail();
            int role = userservice.getUserRole(userId);
            System.out.println("roleId"+role);
            if(role == 1){
                userList = (ArrayList<PolicyGroup>) PolicyGroupService.getListPolicyGroupName();
                System.out.println("length of array:"+userList.size());
            }else{
                userList = (ArrayList<PolicyGroup>) PolicyGroupService.getListPolicyGroupName(userId);
                System.out.println("length of array:"+userList.size());
            }
            System.out.println("testing" + userList);
            mspAuditLogs.setAuditRequestDto(PartnerManageEnum.GET_POLICY_GROUP_SUCCESS,request);
            auditRequestFactory.buildRequest(AuditModules.PDMS_POLICY_GROUP, AuditEvents.POLICY_GRP_EVENT,"NO_ID","NO_IDTYPE","getting policy group success",request);


        } catch (Exception e) {
            mspAuditLogs.setAuditRequestDto(PartnerManageEnum.GET_POLICY_GROUP_FAILURE,request);
            auditRequestFactory.buildRequest(AuditModules.PDMS_POLICY_GROUP, AuditEvents.POLICY_GRP_EVENT,"NO_ID","NO_IDTYPE","getting policy group failure",request);

            logger.error("calling from RPController for viewPolicyGroup",e.getMessage());
            e.printStackTrace();
        }
        return userList;
    }

