    @RequestMapping(value = "/checkPolicyGroup")
    public String checkPolicyGroupName(@RequestParam String policyGroupName)  {
        logger.info("calling mspPolicyGroup Service from RPController for policyGroupNameApi");
        String validation="false";
            int val= PolicyGroupService.checkPolicy(policyGroupName);
            if(val >= 1)
                validation = "true";
            return validation;
    }
    @RequestMapping("/deletePolicyGroup")
    public String deletePolicyGroup(@RequestBody String id, HttpServletRequest request) throws JsonProcessingException {
        String returnVal="";
        mspAuditLogs.setAuditRequestDto(PartnerManageEnum.DELETE_POLICY_GROUP,request);
        auditRequestFactory.buildRequest(AuditModules.PDMS_POLICY_GROUP, AuditEvents.POLICY_GRP_EVENT,"NO_ID","NO_IDTYPE",id +"policy group delete request",request);


        try{
            int count = partnerRegistrationService.checkPolicyGroupId(id);
            int policyCount = policyTypeService.checkPolicyGroupId(id);
            if (count >= 1 || policyCount >= 1){
                mspAuditLogs.setAuditRequestDto(PartnerManageEnum.DELETE_POLICY_GROUP_FAILURE,request);
                auditRequestFactory.buildRequest(AuditModules.PDMS_POLICY_GROUP, AuditEvents.POLICY_GRP_EVENT,"NO_ID","NO_IDTYPE",id +"policy group delete failed",request);

                returnVal="Policy Group linked to Partner/Policy";
            }else{
                mspPolicyGroupService.deleteById(id);
                PolicyGroupService.deleteById(id);
                mspAuditLogs.setAuditRequestDto(PartnerManageEnum.DELETE_POLICY_GROUP_SUCCESS,request);
                auditRequestFactory.buildRequest(AuditModules.PDMS_POLICY_GROUP, AuditEvents.POLICY_GRP_EVENT,"NO_ID","NO_IDTYPE",id +"policy group delete success",request);

                returnVal = "Policy Deleted Successfully";
            }

        }catch (Exception e){
            mspAuditLogs.setAuditRequestDto(PartnerManageEnum.DELETE_POLICY_GROUP_FAILURE,request);
            auditRequestFactory.buildRequest(AuditModules.PDMS_POLICY_GROUP, AuditEvents.POLICY_GRP_EVENT,"NO_ID","NO_IDTYPE",id +"policy group delete failed",request);

            e.printStackTrace();
            returnVal = "Policy Deleted Failed";
        }
        return returnVal;
    }

    public static void turnOffSslChecking() throws NoSuchAlgorithmException, KeyManagementException {
        // Install the all-trusting trust manager
        final SSLContext sc = SSLContext.getInstance("SSL");
        sc.init(null, UNQUESTIONING_TRUST_MANAGER, null);
        HttpsURLConnection.setDefaultSSLSocketFactory(sc.getSocketFactory());
        // Create all-trusting host name verifier
        HostnameVerifier allHostsValid = new HostnameVerifier() {
            public boolean verify(String hostname, SSLSession session) {
                return true;
            }
        };
        // Install the all-trusting host verifier
        HttpsURLConnection.setDefaultHostnameVerifier(allHostsValid);
    }
}
