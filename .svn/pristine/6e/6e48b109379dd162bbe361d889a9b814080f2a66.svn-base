        @PostMapping("/partnerRegList")
    public List<PartnerSusBlackBean> partnerRegList( @RequestBody Map<String, String> requestParams, HttpServletRequest request) throws JSONException {
        logger.info("calling from RPController for view Partner Registration");
        mspAuditLogs.setAuditRequestDto(PartnerManageEnum.GET_PARTNER,request);
        List<PartnerRegistration> regpartner = null;
        List<PartnerSusBlackBean> listPartner = new ArrayList<>();
        List<String> regMSPPartner = null;
        String userId = requestParams.get("userId");
        String val = requestParams.get("val");
        try {
            int role = userservice.getUserRole(userId);
//            regpartner =  partnerRegistrationService.partnerRegList(authPartner);
            processRegistrationFilterType("suspended", role, listPartner, userId,"partner",val);
            processRegistrationFilterType("blacklist", role, listPartner, userId,"partner",val);
            processRegistrationFilterType("", role, listPartner, userId,"partner",val);
            mspAuditLogs.setAuditRequestDto(PartnerManageEnum.GET_PARTNER_SUCCESS,request);
//            regpartner =  partnerRegistrationService.partnerRegAuthMISPList();
//			regpartner = (ArrayList<MSPPartnerRegistration>) partnerRegistrationMSPService.viewPartnerReg(partStatus,status);
//            if(authPartner.equals("Auth_Partner")){
//                regpartner =  partnerRegistrationService.partnerRegList(authPartner);
//            }else {
//                regpartner =  partnerRegistrationService.deviceRegList(authPartner);
//            }


        } catch (Exception e) {
            mspAuditLogs.setAuditRequestDto(PartnerManageEnum.GET_PARTNER_FAILURE,request);
            logger.error("calling from RPController for view Partner Registration", e.getMessage());
            e.printStackTrace();
        }
        return listPartner;
    }
