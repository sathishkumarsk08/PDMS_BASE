        try {
            int role = userservice.getUserRole(userId);
            processRegistrationFilterType("suspended", role, listPartner, userId,"device",val);
            processRegistrationFilterType("blacklist", role, listPartner, userId,"device",val);
            processRegistrationFilterType("", role, listPartner, userId,"device",val);
//            if(role == 1){
//                regpartner =  partnerRegistrationService.deviceFTMRegListFilter(val);
//            }else{
//                regpartner =  partnerRegistrationService.deviceFTMRegListFilter(userId , val);
//            }

//            regpartner =  partnerRegistrationService.partnerRegAuthMISPList();
//			regpartner = (ArrayList<MSPPartnerRegistration>) partnerRegistrationMSPService.viewPartnerReg(partStatus,status);
//            if(authPartner.equals("Auth_Partner")){
//                regpartner =  partnerRegistrationService.partnerRegList(authPartner);
//            }else {
//                regpartner =  partnerRegistrationService.deviceRegList(authPartner);
//            }


        } catch (Exception e) {
            logger.error("calling from RPController for view Partner Registration", e.getMessage());
            e.printStackTrace();
        }
        return listPartner;
    }

    @RequestMapping(value = "/partnerRegAuthMISPList")
    public List<PartnerSusBlackBean> partnerRegAuthMISPList(@RequestBody String userId, HttpServletRequest request) throws JSONException, JsonProcessingException {
        logger.info("calling from RPController for view Partner Registration");
        final String transactionId=Transaction.generateTransaction();
        mspAuditLogs.setAuditRequestDto(PartnerManageEnum.GET_PARTNER,request);
        auditRequestFactory.buildRequest(AuditModules.PDMS_PARTNER,AuditEvents.PARTNER_EVENT,"NO_ID",transactionId,"Get all partners" ,request);
        List<PartnerRegistration> regpartner = null;
        List<PartnerSusBlackBean> listPartner = new ArrayList<>();
        List<String> regMSPPartner = null;

        try {
            int role = userservice.getUserRole(userId);
        
            processRegistrationType("suspended", role, listPartner, userId,"partner");
            processRegistrationType("blacklist", role, listPartner, userId,"partner");
            processRegistrationType("revoke", role, listPartner, userId,"partner");
            processRegistrationType("", role, listPartner, userId,"partner");
            mspAuditLogs.setAuditRequestDto(PartnerManageEnum.GET_PARTNER_SUCCESS,request);
            auditRequestFactory.buildRequest(AuditModules.PDMS_PARTNER,AuditEvents.PARTNER_EVENT,"NO_ID",transactionId,"Get partners success" ,request);

//            System.out.println("count partner registration:" + regpartner.size());

        } catch (Exception e) {
            mspAuditLogs.setAuditRequestDto(PartnerManageEnum.GET_PARTNER_FAILURE,request);
            auditRequestFactory.buildRequest(AuditModules.PDMS_PARTNER,AuditEvents.PARTNER_EVENT,"NO_ID",transactionId,"Get partners failure" ,request);

            logger.error("calling from RPController for view Partner Registration", e.getMessage());
            e.printStackTrace();
        }
        return listPartner;
    }


    private void processRegistrationFilterType(String regType, int role, List<PartnerSusBlackBean> listPartner, String userId, String type,String filterVal) {
        List<PartnerRegistration> regpartner;
        List<String> regMSPPartner;
        String regStatus="";

        if(regType.equals("suspended")) {
            regStatus = "Suspended";
        }else if(regType.equals("blacklist")){
            regStatus = "Blacklist";
        }

        if(regType.equals("suspended") || regType.equals("blacklist")) {
            if(type.equals("partner")){
                regMSPPartner = partnerRegistrationMSPService.getMSPFilterSusBlackPartnerRegAuthList(regType,filterVal);
            }else{
                regMSPPartner =  deviceModelRegistrationMSPService.getMSPSusBlackPartnerRegAuthList(regType);
            }

        }else{
            if(type.equals("partner")){
                regMSPPartner = partnerRegistrationMSPService.getMSPFilterNotInPSusBlackPartnerRegAuthList(filterVal);
            }else{
                regMSPPartner = deviceModelRegistrationMSPService.getMSNotInPSusBlackPartnerRegAuthList();
            }

        }

        try {
            if (role == 1) {
               
                if(type.equals("partner")){
                    regpartner = partnerRegistrationService.partnerRegAuthMISPList(regMSPPartner);
                }else{
                    regpartner = partnerRegistrationService.filterPartnerRegList(filterVal,regMSPPartner);
                }

            } else {
                
                if(type.equals("partner")){
                    regpartner = partnerRegistrationService.partnerRegAuthMISPList(userId,regMSPPartner);
                }else{
                    regpartner = partnerRegistrationService.filterPartnerRegListRole(userId, regMSPPartner,filterVal);
                }

            }

            for (PartnerRegistration val : regpartner) {
                PartnerSusBlackBean bean = createPartnerBean(val, regStatus);
                listPartner.add(bean);
            }

        } catch (Exception e) {
            logger.error("Error processing registration type: " + regType, e.getMessage());
            e.printStackTrace();
        }
    }
    private void processRegistrationType(String regType, int role, List<PartnerSusBlackBean> listPartner, String userId, String type) {
        List<PartnerRegistration> regpartner;
        List<String> regMSPPartner;
        String regStatus="";

        if(regType.equals("suspended")) {
            regStatus = "Suspended";
        }else if(regType.equals("blacklist")){
            regStatus = "Blacklist";
        }else if(regType.equals("revoke")){
            regStatus = "Revoke";
        }


            if(regType.equals("suspended") || regType.equals("blacklist") || regType.equals("revoke")) {
            if(type.equals("partner")){
                regMSPPartner = partnerRegistrationMSPService.getMSPSusBlackPartnerRegAuthList(regType);
            }else{
                regMSPPartner =  deviceModelRegistrationMSPService.getMSPSusBlackPartnerRegAuthList(regType);
            }

        }else{
            if(type.equals("partner")){
                regMSPPartner = partnerRegistrationMSPService.getMSNotInPSusBlackPartnerRegAuthList();
            }else{
                regMSPPartner = deviceModelRegistrationMSPService.getMSNotInPSusBlackPartnerRegAuthList();
            }

        }

        try {
            if (role == 1) {
                if(type.equals("partner")){
                    regpartner = partnerRegistrationService.partnerRegAuthMISPList(regMSPPartner);
                }else{
                    regpartner = partnerRegistrationService.deviceRegAuthMISPList(regMSPPartner);
                }

            } else {
                if(type.equals("partner")){
                    regpartner = partnerRegistrationService.partnerRegAuthMISPList(userId, regMSPPartner);
                }else{
                    regpartner = partnerRegistrationService.deviceRegAuthMISPList(userId, regMSPPartner);
                }

            }

            for (PartnerRegistration val : regpartner) {
                PartnerSusBlackBean bean = createPartnerBean(val, regStatus);
                listPartner.add(bean);
            }

        } catch (Exception e) {
            logger.error("Error processing registration type: " + regType, e.getMessage());
            e.printStackTrace();
        }
    }

    private PartnerSusBlackBean createPartnerBean(PartnerRegistration val, String status) {
        PartnerSusBlackBean bean = new PartnerSusBlackBean();
        bean.setId(val.getId());
        bean.setGroupId(val.getGroupId());
        bean.setName(val.getName());
        bean.setAddress(val.getAddress());
        bean.setContact(val.getContact());
        bean.setEmail(val.getEmail());
        bean.setCertificate(val.getCertificate());
        bean.setUserId(val.getUserId());
        bean.setPartnerType(val.getPartnerType());
        bean.setApprovalStatus(val.getApprovalStatus());
        bean.setActive(val.getActive());
        bean.setCrBy(val.getCrBy());
        bean.setCrDTime(val.getCrDTime());
        bean.setUpdBy(val.getUpdBy());
        bean.setUpdDTime(val.getUpdDTime());
        bean.setIsDeleted(val.getDeleted());
        bean.setDelDTime(val.getDelDTime());
       
        if(status.equals("Suspended") ||status.equals("Blacklist") || status.equals("Revoke")) {
            bean.setStatus(status);
        }else{
            if(val.getActive())
                        bean.setStatus("Active");
            else
                        bean.setStatus("De-Active");
        }

        return bean;
    }









