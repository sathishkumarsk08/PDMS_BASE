    @RequestMapping(value = "/editPartnerLicense")
    public String editPartnerLicense(@RequestBody String groupname , HttpServletRequest request) throws NoSuchAlgorithmException,
            KeyManagementException, JsonProcessingException {
        logger.info("calling from RPController for activate license key");
        final String transactionId=Transaction.generateTransaction();
        System.out.println("1.enter in Partner Licence ");
        System.out.println("testing:" + groupname);
        String returnVal = "false";

        boolean status = false;

        org.json.JSONObject jsonObject = new org.json.JSONObject(groupname);

        auditRequestFactory.buildRequest(AuditModules.PDMS_PARTNER,AuditEvents.PARTNER_EVENT,"NO_ID",transactionId,jsonObject.get("licenseKeyStatus").toString()+" request for this tsp license key :"+jsonObject.get("licenseKey").toString() ,request);

        String val= jsonObject.get("licenseKeyStatus").toString();
        try {
            if(val.equals( "Active")){
                status = true;
            }else if(val.equals( "De-Active")){
                status = false;
            }

          int checkMosipLicense =  mispLicenseKeyService.updateStatus(status,jsonObject.get("providerId").toString() , jsonObject.get("licenseKey").toString()  )   ;
          int checkMSPLicense =   mspMsipLicenseService.UpdateStatus(status,jsonObject.get("providerId").toString(), jsonObject.get("licenseKey").toString() );
          if(checkMosipLicense >= 1 || checkMSPLicense >= 1){
              returnVal = "true";
              auditRequestFactory.buildRequest(AuditModules.PDMS_PARTNER,AuditEvents.PARTNER_EVENT,"NO_ID",transactionId,jsonObject.get("licenseKeyStatus").toString()+" success for this tsp license key :"+jsonObject.get("licenseKey").toString() ,request);

          }else {
              returnVal = "false";
              auditRequestFactory.buildRequest(AuditModules.PDMS_PARTNER,AuditEvents.PARTNER_EVENT,"NO_ID",transactionId,jsonObject.get("licenseKeyStatus").toString()+" failed for this tsp license key :"+jsonObject.get("licenseKey").toString() ,request);
          }
            System.out.println("4. data saved in local pms :");
        }catch (Exception e){
            returnVal = "false";
            auditRequestFactory.buildRequest(AuditModules.PDMS_PARTNER,AuditEvents.PARTNER_EVENT,"NO_ID",transactionId,jsonObject.get("licenseKeyStatus").toString()+" failed for this tsp license key :"+jsonObject.get("licenseKey").toString() ,request);

            e.printStackTrace();
        }
        return returnVal;
    }

    @RequestMapping(value = "/editPartnerLicensedeactive")
    public String editPartnerLicensedeactive(@RequestBody String groupname) throws NoSuchAlgorithmException,
            KeyManagementException {
        logger.info("calling from RPController for deactivate license key");
        System.out.println("1.enter in Partner Licence ");
        System.out.println("testing:" + groupname);
        turnOffSslChecking();
        APIConnection.authenticate();
        String returnVal = null;
        ResourceBundle bundle = APIConnection.readConfig();
        org.json.JSONObject template = new org.json.JSONObject(bundle.getString("template"));
        org.json.JSONObject jsonObject = new org.json.JSONObject(groupname);
        try {
            org.json.JSONObject requestTemp = template.getJSONObject("request");
            requestTemp.put("providerId", jsonObject.get("providerId"));
            requestTemp.put("licenseKeyStatus", jsonObject.get("licenseKeyStatus"));
            requestTemp.put("licenseKey", jsonObject.get("licenseKey"));
            template.put("requesttime", APIConnection.formatToISOString(APIConnection.getUTCCurrentDateTime()));
            template.put("request", requestTemp);
            template.put("id", "mosip.partnermanagement.misp.status.update");
            System.out.println("template:" + template.toString());
        } catch (Exception e) {
            logger.error("calling from RPController for deactivate license key", e.getMessage());
            e.printStackTrace();
        }
        System.out.println("2. Template to Msoip:" + template.toString());
        //         /v1/policymanager/policies/group/newSystem.out.println();
        System.out.println("url:" + bundle.getString("base.url") + bundle.getString("version") + bundle.getString("partnermanager.partner.misp"));
        String record = APIConnection.connectApi(bundle.getString("base.url") + bundle.getString("version") + bundle.getString("partnermanager.partner.misp"), "PUT", template.toString(), "Cookie");
        System.out.println("3. output from Mosip :" + record);
        org.json.JSONObject jsoninput = new org.json.JSONObject(record);
        String responseData = (jsoninput.get("response")).toString();
        if (responseData.equals("null")) {
            returnVal = "false";
            JSONArray responseApi = jsoninput.getJSONArray("errors");
            org.json.JSONObject rec = responseApi.getJSONObject(0);
            returnVal = rec.getString("message");

        } else {
            returnVal = "true";
            System.out.println("id :" + jsonObject.get("providerId").toString());
            mspMsipLicenseService.UpdateStatusfalse(jsonObject.get("providerId").toString());
            System.out.println("4. data saved in local pms :");
        }
        return record;
    }

