    @RequestMapping("/createPartner")
    public String reigsterPartner(@RequestBody String partnerRegister, HttpServletRequest request) throws JsonParseException, JsonMappingException, JsonProcessingException, IOException, NoSuchAlgorithmException, KeyManagementException {
        logger.info("calling Partner Registration Service from RPController for partner creation");
        final String transactionId= Transaction.generateTransaction();

        String record = "";
        String returnVal = "";
        String selectedParType="";
        try {
            MSPPartnerRegistration partnerreg = new MSPPartnerRegistration();
            turnOffSslChecking();
            APIConnection.authenticate();
            org.json.JSONObject jsonObject = new org.json.JSONObject(partnerRegister);

            if(jsonObject.get("selectedType").toString().equals("Auth_Partner")){
                selectedParType = "RP";
            }else if(jsonObject.get("selectedType").toString().equals("TSP")){
                selectedParType = "TSP";
            }else {
                selectedParType = "RP+TSP";
            }

            mspAuditLogs.setAuditRequestDto(PartnerManageEnum.CREATE_PARTNER,request);
            auditRequestFactory.buildRequest(AuditModules.PDMS_PARTNER, AuditEvents.PARTNER_EVENT, "NO_ID", transactionId, "Create "+selectedParType+" Partner request", request);

            System.out.println("testing" + jsonObject);
            ResourceBundle bundle = APIConnection.readConfig();
//            String disclosure = jsonObject.get("disclosure").toString();
//            String otherDocum = jsonObject.get("otherDocum").toString();
//            String selfAssessment = jsonObject.get("selfAssessment").toString();
//            String psaApproval = jsonObject.get("psaApproval").toString();
            Integer maxSno = 0;
            String partnerId = null;
            String text = null;
            String textMSP = null;
            String parterType = null;
            int generInt ;
            int generIntMSP ;
            String userIdGenerate = partnerRegistrationService.maxUserid();
//            String userIdMSPGenerate = partnerRegistrationMSPService.maxUserid();
            String policyGrp = jsonObject.get("policyGroup").toString();
            String PolicyGroupId = policyGroupService.getPolicyGroupId(policyGrp);
             if(jsonObject.get("selectedType").toString().equals("TSP")){
//                parterType = "MISP_Partner";
                parterType = "Credential_Partner";
            }else if(jsonObject.get("selectedType").toString().equals("RP+TSP") || jsonObject.get("selectedType").toString().equals("Auth_Partner")){
                parterType = "Auth_Partner";
            }

            if (userIdGenerate == null || userIdGenerate.length() == 0 || userIdGenerate.length() <= 5) {
                if(jsonObject.get("selectedType").toString().equals("RP+TSP") ){
                    partnerId = "AP_TSP" + APIConnection.formatToGenerateID(APIConnection.getUTCCurrentDateTime()) + "00001";
                    partnerreg.setSelectedType("both");
                }else if(jsonObject.get("selectedType").toString().equals("TSP")){
                    partnerId = "TSP" + APIConnection.formatToGenerateID(APIConnection.getUTCCurrentDateTime()) + "00001";
                    partnerreg.setSelectedType("tsp");
                }else if(jsonObject.get("selectedType").toString().equals("Auth_Partner")){
                    partnerId = "AP" + APIConnection.formatToGenerateID(APIConnection.getUTCCurrentDateTime()) + "00001";
                    partnerreg.setSelectedType("rp");
                }

            } else{
                String sentence=userIdGenerate;
                String name= new StringBuilder(sentence).reverse().toString();
                String val= name.substring(0,5);
                String name2= new StringBuilder(val).reverse().toString();
                text = String.format("%0" + name2.length() + "d", Long.parseLong(name2) + 1);
                if(jsonObject.get("selectedType").toString().equals("RP+TSP") ){
                    partnerId = "AP_TSP" + APIConnection.formatToGenerateID(APIConnection.getUTCCurrentDateTime()) + text;
                    partnerreg.setSelectedType("both");
                }else if(jsonObject.get("selectedType").toString().equals("TSP")){
                    partnerId = "TSP" + APIConnection.formatToGenerateID(APIConnection.getUTCCurrentDateTime()) + text;
                    partnerreg.setSelectedType("tsp");
                }else if(jsonObject.get("selectedType").toString().equals("Auth_Partner")){
                    partnerId = "AP" + APIConnection.formatToGenerateID(APIConnection.getUTCCurrentDateTime()) + text;
                    partnerreg.setSelectedType("rp");
                }

            }
            org.json.JSONObject template = new org.json.JSONObject(bundle.getString("template"));
            org.json.JSONObject requestTemp = template.getJSONObject("request");
            requestTemp.put("address", jsonObject.get("address"));
            requestTemp.put("partnerId", partnerId);
            requestTemp.put("contactNumber", jsonObject.get("contactNumber"));
            requestTemp.put("emailId", jsonObject.get("emailId"));
            requestTemp.put("organizationName", jsonObject.get("organizationName"));
            requestTemp.put("partnerType", parterType);
            requestTemp.put("policyGroup", jsonObject.get("policyGroup").toString());
            template.put("requesttime", APIConnection.formatToISOString(APIConnection.getUTCCurrentDateTime()));
            template.put("request", requestTemp);
            System.out.println("2. Template to Msoip -partner creation:" + template.toString());
            partnerreg.setPartnerId(partnerId);
            partnerreg.setOrganisationName(jsonObject.get("organizationName").toString());
            partnerreg.setAuthenticationRepName(jsonObject.get("address").toString());
            partnerreg.setPartnerType(parterType);
            partnerreg.setMobileNumber(jsonObject.get("contactNumber").toString());
            partnerreg.setEmailId(jsonObject.get("emailId").toString());
            partnerreg.setPolicyGroup(PolicyGroupId);
//            partnerreg.setPsaApproval(psaApproval);
//            partnerreg.setSelfAssessment(selfAssessment);
//            partnerreg.setNonDisclosureAgreement(disclosure);
//            partnerreg.setOtherDocument(otherDocum);
            partnerreg.setPartStatus("InProgress");
            if(jsonObject.get("partnerType").toString().equals("Auth_Partner")){
                partnerreg.setTspPartner(jsonObject.get("tspId").toString());
            }
            partnerreg.setUserId(jsonObject.get("userId").toString());
            partnerreg.setPartcreatedBy((jsonObject.get("userId").toString()));
            partnerreg.setPartcrDtTime(APIConnection.getUTCCurrentDateTime());
            partnerreg.setFlag(0);

            try {
                int mosipPartnerTable = partnerRegistrationService.getMOSIPOrganizationEmailId(jsonObject.get("partnerType").toString(), jsonObject.get("emailId").toString(), jsonObject.get("organizationName").toString());

                System.out.println("moisp count" + mosipPartnerTable);

                int pmsPartnerTable = partnerRegistrationMSPService.getPMSOrganizationEmailId(jsonObject.get("partnerType").toString(), jsonObject.get("emailId").toString(), jsonObject.get("organizationName").toString());

                System.out.println("pms count" + pmsPartnerTable);

                if (mosipPartnerTable >= 1 && pmsPartnerTable >= 1) {

//                    EmailNotifyResponseDto response = new EmailNotifyResponseDto();
