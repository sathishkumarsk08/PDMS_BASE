    @RequestMapping("/createDeviceRegistration")
    public String reigsterdevice(@RequestBody String deviceRegister) throws JsonParseException,
            JsonMappingException,
            JsonProcessingException,
            IOException,
            NoSuchAlgorithmException,
            KeyManagementException {
        logger.info("calling from RPController for createDeviceRegistration");

        Integer maxSno = 0;
        String deviceId = null;
        String text = null;
        String returnVal = "";
        String userIdGenerate = mspDeviceRegistrationService.maxUserid();
        System.out.println("userId" + userIdGenerate);
        if (userIdGenerate == null || userIdGenerate.length() == 0) {
            deviceId = "DR" + APIConnection.formatToGenerateID(APIConnection.getUTCCurrentDateTime()) + "00001";
            System.out.println(deviceId);
        } else {
            text = userIdGenerate.substring(10);
            text = String.format("%0" + text.length() + "d", Long.parseLong(text) + 1);
            System.out.println("checking:" + text);
            deviceId = "DR" + APIConnection.formatToGenerateID(APIConnection.getUTCCurrentDateTime()) + text;
        }
        try {
            org.json.JSONObject jsonObject = new org.json.JSONObject(deviceRegister);
            System.out.println("testring:"+jsonObject);
            DeviceRegistrationPms devicereg = new DeviceRegistrationPms();
            devicereg.setId(deviceId);
            devicereg.setName(jsonObject.get("deviceName").toString());
            devicereg.setType(jsonObject.get("deviceType").toString());
            devicereg.setLocation(jsonObject.get("location").toString());
            devicereg.setSerialNumber(jsonObject.get("serialNumber").toString());
//		devicereg.setValidity(LocalDateTime.parse(jsonObject.get("validity").toString()));
            devicereg.setModel(jsonObject.get("deviceModel").toString());
            String startDate = jsonObject.get("validity").toString();
            System.out.println("validity" + startDate);
            System.out.println(startDate);
            DateTimeFormatter formatter = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm");
            LocalDateTime startDateTime = LocalDateTime.parse(startDate + " 00:00", formatter);
            devicereg.setValidity(startDateTime);
            devicereg.setCertificate(jsonObject.get("deviceCertif").toString());
            devicereg.setSupportingCertificate(jsonObject.get("supportingDoc").toString());
            devicereg.setEmail(jsonObject.get("email").toString());
            devicereg.setMobile(jsonObject.get("mobile").toString());
            devicereg.setCrDtTime(APIConnection.getUTCCurrentDateTime());
            mspDeviceRegistrationService.save(devicereg);
            returnVal = "true";
        } catch (Exception e) {
            logger.error("calling from RPController for createDeviceRegistration", e.getMessage());
            returnVal = "false";
            e.printStackTrace();
        }
        return returnVal;
    }



