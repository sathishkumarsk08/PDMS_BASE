    }

    @RequestMapping("/getPartnerTypes")
    public ArrayList<partnerBean> partnerTypes() {
        logger.info("calling partnerService from RPController for getPartnerTypes");
        ArrayList<partner> type = (ArrayList<partner>) partnerService.getPartnersType();
        ArrayList<partnerBean> partnerTypes = new ArrayList<partnerBean>();
        for (partner report1 : type) {
            partnerBean bean = new partnerBean();
            bean.setPartnerType(report1.getPartnerType());
            bean.setPartnerDesc(report1.getPartnerDesc());
            partnerTypes.add(bean);
        }
        System.out.println("partner Types" + partnerTypes);
        return partnerTypes;
