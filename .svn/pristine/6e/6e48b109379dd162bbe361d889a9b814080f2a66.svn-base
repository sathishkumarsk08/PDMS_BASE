    /***** Checking FP Device Starts *****/
    @RequestMapping("/fpCapture")
    public void FPDeviceChk() throws JsonParseException,
            JsonMappingException,
            JsonProcessingException,
            IOException,
            KeyManagementException,
            NoSuchAlgorithmException {
        logger.info("calling from RPController for fpCapture");
        turnOffSslChecking();
        HttpURLConnection urlConnection = null;
        BufferedReader reader = null;
        OutputStream ouputStream = null;
        String text = null;
        JSONObject status = null;
        JSONObject jsonObject = new JSONObject();
        URL url1 = new URL("http://127.0.0.1:4501/capture");
        HttpURLConnection con = (HttpURLConnection) url1.openConnection();
        con.setRequestMethod("GET"); // CAPTURE
        con.setRequestProperty("Content-Type", "application/json; utf-8");
        //con.setRequestProperty();
        con.setRequestProperty("Accept", "application/json");
        con.setDoOutput(true);

        String jsonInputString = "{\n" +
                "\t\"env\":\"Developer\",\n" +
                "\t\"purpose\":\"Auth\",\n" +
                "\t\"specVersion\":\"0.9.5\",\n" +
                "\t\"timeout\":10000,\n" +
                "\t\"captureTime\":\"2021-07-23T06:07:42Z\",\n" +
                "\t\"domainUri\":\"https://extint1.mosip.net\",\n" +
                "\t\"transactionId\":\"1627020462568\",\n" +
                "\t\"bio\":[{\"type\":\"Finger\",\"count\":1,\"bioSubType\":[\"Left IndexFinger\"],\n" +
                "\t\"requestedScore\":40,\"deviceId\":\"17007113\",\"deviceSubId\":0,\"previousHash\":\"E3B0C44298FC1C149AFBF4C8996FB92427AE41E4649B934CA495991B7852B855\"}],\n" +
                "\t\"customOpts\":null}";


        try (OutputStream os = con.getOutputStream()) {
            logger.info("calling from RPController for fpCapture");
            byte[] input = jsonInputString.getBytes("utf-8");
            os.write(input, 0, input.length);
        }

        try (BufferedReader br = new BufferedReader(
                new InputStreamReader(con.getInputStream(), "utf-8"))) {
            logger.info("calling  from RPController for fpCapture");
            StringBuilder response = new StringBuilder();
            String responseLine = null;
            while ((responseLine = br.readLine()) != null) {
                response.append(responseLine.trim());
            }
            System.out.println(response.toString());
        }

    }


