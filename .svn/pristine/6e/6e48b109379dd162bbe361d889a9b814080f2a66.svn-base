    public String updateIDATable(String organisation, String domain) {

        ArrayList<KeyManagerCaCertStore> type = (ArrayList<KeyManagerCaCertStore>) keyMgrCaCertStoreService.getOrganisationRecord("%O="+organisation+",%", domain);

        System.out.println("keymanagement row" + type.size());

        for (int i = 0; i < type.size(); i++) {

           int count = idaCaCertStoreService.isCertificateAlreadyExist(type.get(i).getCertId());

           if(count == 0){
               IDACaCertStore store = new IDACaCertStore();
               store.setCertData(type.get(i).getCertData());
               store.setCertId(type.get(i).getCertId());
               store.setCertIssuer(type.get(i).getCertIssuer());
               store.setCertAfter(type.get(i).getCertAfter());
               store.setCertBefore(type.get(i).getCertBefore());
               store.setCertSerial(type.get(i).getCertSerial());
               store.setCertSubject(type.get(i).getCertSubject());
               store.setCertThumbprint(type.get(i).getCertThumbprint());
               store.setCrBy(type.get(i).getCrBy());
               store.setCrDTimes(type.get(i).getCrDTimes());
               store.setDelDTime(type.get(i).getDelDTime());
               store.setDeleted(type.get(i).isDeleted());
               store.setIssuerId(type.get(i).getIssuerId());
               store.setPartDomain(type.get(i).getPartDomain());
               store.setUpdBy(type.get(i).getUpdBy());
               store.setUpdDTimes(type.get(i).getUpdDTimes());
               idaCaCertStoreService.save(store);
               System.out.println("----------IDA CA CERT STORE UPDATED:" + i + "---------------");

           }

        }


        return "";
    }

    @RequestMapping(value = "/createpartnertype", method = RequestMethod.POST)
    public String createpartnertype(@RequestBody MasterPartnerBean partnerType) throws NoSuchAlgorithmException,
            KeyManagementException {
        logger.info("calling from RPController for createpartnertype");
//        mspAuditLogs.setAuditRequestDto();
        System.out.println(partnerType);
//		JSONObject jsonObject1=new JSONObject();
        String returnVal = "false";
        try {
            PartnerType partner = new PartnerType();
            partner.setPartnerType(partnerType.getPartnerType());
            partner.setPartnerDesc(partnerType.getPartnerDesc());
            partner.setCreatedBy(partnerType.getUserId());

            if (partnerType.getUploadBy().equals("true")) {
                partner.setPolicyRequired(true);
                partner.setActive(true);
            } else {
                partner.setPolicyRequired(false);
                partner.setActive(false);
            }

            partner.setCreatedDatetime(APIConnection.getUTCCurrentDateTime());
            try{
                PartnerType val=  mspPartnerTypeService.save(partner);
                returnVal = "true";
            }catch (Exception e){

                returnVal ="false";
                e.printStackTrace();

            }


            partner type = new partner();
            type.setPartnerType(partnerType.getPartnerType());
            type.setPartnerDesc(partnerType.getPartnerDesc());
            type.setCreatedBy(partnerType.getUserId());

            if (partnerType.getUploadBy().equals("true")) {
                type.setPolicyRequired(true);
                type.setIsActive(true);
            } else {
                type.setPolicyRequired(false);
                type.setIsActive(false);
            }
//            type.setCreatedBy("110011");
            type.setCreatedDatetime(APIConnection.getUTCCurrentDateTime());
            try{
                partner val=   partnerService.save(type);
                returnVal = "true";
            }catch (Exception e){
                partnerService.deleteById( partnerType.getPartnerType());
                returnVal ="false";
                e.printStackTrace();
            }


            returnVal = "true";
        } catch (Exception e) {
            e.printStackTrace();
            returnVal = "false";
        }

        return returnVal;
    }

