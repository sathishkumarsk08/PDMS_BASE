    @RequestMapping("/deviceCert")
    public String deviceCert(@RequestBody String deviceCert, HttpServletRequest request) throws JsonParseException, JsonMappingException, JsonProcessingException, IOException, NoSuchAlgorithmException, KeyManagementException {
        System.out.println("1.enter in certificate upload ca/intermediate ");
        logger.info("calling  from RPController for device Certificate");
        final String transactionId=Transaction.generateTransaction();
        turnOffSslChecking();
        APIConnection.authenticate();
        ResourceBundle bundle = APIConnection.readConfig();
        String returnVal = "";
        org.json.JSONObject jsonObject = new org.json.JSONObject(deviceCert);
        String partnerId = jsonObject.get("partnerId").toString();
        String val1 = jsonObject.get("certificateData").toString();
        String certType = jsonObject.get("certType").toString();

        AuditModules auditModules = null;
        AuditEvents auditEvents = null;
        String type = null;
        if(partnerId.startsWith("AP") || partnerId.startsWith("TSP")){
              auditModules = AuditModules.PDMS_PARTNER;
              auditEvents = AuditEvents.PARTNER_EVENT;
              type = "Partner";
        }else {
            auditModules = AuditModules.PDMS_DEVICE;
            auditEvents = AuditEvents.DEVICE_EVENT;
            type = "Device";
        }

        auditRequestFactory.buildRequest(auditModules,auditEvents,"NO_ID",transactionId,"upload "+certType+" certificate request for this "+type+" :"+partnerId,request);

        mspAuditLogs.setAuditRequestDto(PartnerManageEnum.CREATE_ROOT_OR_INTERMEDIATE_CERTIFICATE,request);

//		String certificate=  BEGIN_CERT + LINE_SEPARATOR + val1 + LINE_SEPARATOR + END_CERT;
        org.json.JSONObject template = new org.json.JSONObject(bundle.getString("template"));
//		File file =
//		File file = ResourceUtils.getFile("classpath:write.txt");
//		FileWriter fw = new FileWriter(file, true);
//		BufferedWriter writer = new BufferedWriter(fw);
        try {
//			writer.write(val1);
//			writer.flush();
//			writer.close();
//			String rpsign=mosipUrl.sign(val1, false,
//					true, false, null, "rp");
            template.put("requesttime", APIConnection.formatToISOString(APIConnection.getUTCCurrentDateTime()));
//			template.put("request",digitalCert);
            org.json.JSONObject requestTemp = template.getJSONObject("request");
            requestTemp.put("certificateData", val1);
//			requestTemp.put("partnerId",jsonObject.get("partnerId"));

            if (jsonObject.get("partnerDomain").toString().equals("Device_Provider")) {
                jsonObject.remove("partnerDomain");
                jsonObject.put("partnerDomain", "DEVICE");
            } else if (jsonObject.get("partnerDomain").toString().equals("FTM_Provider")) {
                jsonObject.remove("partnerDomain");
                jsonObject.put("partnerDomain", "FTM");
            } else if (jsonObject.get("partnerDomain").toString().equals("Auth_Partner")) {
                jsonObject.remove("partnerDomain");
                jsonObject.put("partnerDomain", "AUTH");
            } else if (jsonObject.get("partnerDomain").toString().equals("MISP_Partner")||jsonObject.get("partnerDomain").toString().equals("TSP")||jsonObject.get("partnerDomain").toString().equals("Credential_Partner")) {
                jsonObject.remove("partnerDomain");
                jsonObject.put("partnerDomain", "AUTH");
            }
            requestTemp.put("partnerDomain", jsonObject.get("partnerDomain"));
            template.put("request", requestTemp);
        } catch (Exception e) {
            logger.error("calling  from RPController for  device Certificate", e.getMessage());
            e.printStackTrace();
        }


        System.out.println("2. Template to Msoip -certificate ca/intermediate:" + template.toString());
        //         /v1/partnermanager/partners/certificate/ca/upload

        String record = APIConnection.connectApi(bundle.getString("base.url") + bundle.getString("version") + bundle.getString("partnermanager.partner.url") +
                "/certificate/ca/upload", "POST", template.toString(), "Cookie");
        System.out.println("3. output from Mosip - certificate ca/intermediate :" + record);
        org.json.JSONObject jsoninput = new org.json.JSONObject(record);
        String responseData = (jsoninput.get("response")).toString();
        System.out.println("response " + responseData);
        if (responseData.equals("null")) {
            auditRequestFactory.buildRequest(auditModules,auditEvents,"NO_ID",transactionId,"upload "+certType+" certificate failed for this "+type+" :"+partnerId,request);

            mspAuditLogs.setAuditRequestDto(PartnerManageEnum.CREATE_ROOT_OR_INTERMEDIATE_CERTIFICATE_FAILURE,request);

        } else {

            mspAuditLogs.setAuditRequestDto(PartnerManageEnum.CREATE_ROOT_OR_INTERMEDIATE_CERTIFICATE_SUCCESS,request);

            String orgName = partnerRegistrationService.getPartnerDetails(partnerId);
            updateIDATable(orgName, jsonObject.get("partnerDomain").toString());

            auditRequestFactory.buildRequest(auditModules,auditEvents,"NO_ID",transactionId,"upload "+certType+" certificate success for this "+type+" :"+partnerId,request);


            if(allCertificatesCount(partnerId) == 4){
                partnerRegistrationService.certificateAliasUpdateForRootInter(partnerId);
                partnerRegistrationMSPService.certificateAliasUpdateForRootInter(partnerId);
                deviceModelRegistrationMSPService.certificateAliasUpdateForRootInter(partnerId);
            }

        }
        return record;
    }

    private int allCertificatesCount(String partnerId){

            PartnerRegistration partner = partnerRegistrationService.getalldata(partnerId);
            String partnerDomain = "";
        KeyManagerPartnerCertStore partnerCert = null;

//            if(partner != null){

                if (partner.getPartnerType().equals("Auth_Partner") || partner.getPartnerType().equals("MISP_Partner") || partner.getPartnerType().equals("Credential_Partner"))
                    partnerDomain = "AUTH";
                else if (partner.getPartnerType().equals("Device_Provider"))
                    partnerDomain = "DEVICE";
                else if (partner.getPartnerType().equals("FTM_Provider"))
                    partnerDomain = "FTM";


                ArrayList<KeyManagerCaCertStore> otherCertificates = (ArrayList<KeyManagerCaCertStore>) keyMgrCaCertStoreService.getOrganisationRecord("%O="+partner.getName()+",%", partnerDomain);


                    try {
                         partnerCert =  keyMgrPartCertStoreService.getCertAliasRecord(partner.getCertificate());
                    }catch (Exception e){
                        System.out.println(e.getMessage());
                    }



              if(partnerCert != null){
                  return otherCertificates.size() + 1;
              }else {
                  return otherCertificates.size();
              }

//            }

    }

