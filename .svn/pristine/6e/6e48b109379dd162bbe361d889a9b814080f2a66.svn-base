    @RequestMapping(value="/showTSPPartner")
    public List<PartnerRegistration> showTSPPartner(@RequestBody String policyGroup, HttpServletRequest request){
        logger.info("getting list of TSP Partner list");
        String policyGroupId = policyGroupService.getPolicyGroupId(policyGroup);
        mspAuditLogs.setAuditRequestDto(PartnerManageEnum.GET_ALL_TSP_PARTNER,request);
       return partnerRegistrationService.findAllTSPPartner(policyGroupId);

    }
    @RequestMapping(value="/getPolicyGroup")
    public PoliciesPartnerTypeBean getPolicyGroup(@RequestBody String policyGroupId, HttpServletRequest request){
//               org.json.JSONObject jsonObject = new org.json.JSONObject(policyGroupId);
//        policyGroupId =jsonObject.get("policyGroupId").toString();
        logger.info("getting list of Policy Group Policies Partner list");
        mspAuditLogs.setAuditRequestDto(PartnerManageEnum.GET_POLICY_GROUP_SUCCESS,request);
        PoliciesPartnerTypeBean authBean = new PoliciesPartnerTypeBean();
       PolicyGroup outletDet = policyGroupService.editPolicygroupId(policyGroupId);
       List<PolicyType> policies = policyTypeService.getPoliciesGroupBased(policyGroupId);
       List<PartnerRegistration> partnerRegistration =partnerRegistrationService.findAllPoliciesGroupPartner(policyGroupId);
       List<PolicyGroup> group = new ArrayList<>();
        group.add(outletDet);
        authBean.setPolicyGroup(group);
        authBean.setPolicyType(policies);
        authBean.setPartner(partnerRegistration);
        return authBean;

    }

