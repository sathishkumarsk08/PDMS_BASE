    @RequestMapping("/generateapikey")
    public ArrayList<PolicyGroupTypeBean> generateapikey() throws JSONException {
        logger.info("calling mspPolicyTypeService from RPController for generate-apikey");
        ArrayList<PolicyGroupTypeBean> trnBean = new ArrayList<PolicyGroupTypeBean>();

        try {
            List<Object[]> list = mspPolicyTypeService.generateapikey();
            for (Object[] report1 : list) {
                PolicyGroupTypeBean bean = new PolicyGroupTypeBean();
                bean.setPolicyTypeId((String) report1[0]);
                bean.setPolicyTypeName((String) report1[1]);
                bean.setPartnerId((String) report1[2]);
                bean.setPolicyGroupId((String) report1[3]);
                bean.setPolicyGroupName((String) report1[4]);
                trnBean.add(bean);
            }

        } catch (Exception e) {
            logger.error("calling mspPolicyTypeService from RPController for generate-apikey", e.getMessage());
            e.printStackTrace();
        }
        return trnBean;
    }

