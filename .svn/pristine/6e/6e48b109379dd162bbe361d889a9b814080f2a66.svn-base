    @RequestMapping("/idapartnercert")
    public String getIdaPartnerCert() throws NoSuchAlgorithmException, KeyManagementException {
        logger.info("calling from RPController for ida partner certificate");
        turnOffSslChecking();
        APIConnection.authenticate();
        ResourceBundle bundle = APIConnection.readConfig();
        String returnVal = "";
        String record = APIConnection.connectApi(bundle.getString("base.url") + "/idauthentication" + bundle.getString("version") + "/internal/getCertificate?applicationId=IDA&referenceId=PARTNER",
                "GET", "", "Cookie");
        System.out.println("3. output from Mosip -partner ida certificate :" + record);
        org.json.JSONObject jsoninput = new org.json.JSONObject(record);
        String responseData = (jsoninput.get("response")).toString();
        System.out.println("response " + responseData);
        if (responseData.equals("null")) {
            returnVal = record;
        } else {
            org.json.JSONObject jsoninput1 = new org.json.JSONObject(responseData);
            returnVal = jsoninput1.get("certificate").toString();
        }
        return returnVal;
    }

