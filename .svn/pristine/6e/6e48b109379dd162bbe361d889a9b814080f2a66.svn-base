                                mailTemplatePartnerRegistration(jsonObject.get("organizationName").toString(), partnerId, policyGrp, jsonObject.get("emailId").toString(), jsonObject.get("contactNumber").toString());
                                notificationSystem.savePartnerRegistration(partnerreg,jsonObject.get("userId").toString());
                                 returnVal=responseData;
                            }
                        } catch (Exception e) {
                            returnVal = record;
