        Optional<List<X509Certificate>> partnerList =list1.entrySet().stream().filter(stringListEntry -> stringListEntry.getValue().size() == 1).map(Map.Entry::getValue).findFirst();
        X509Certificate partnerCertificate = null;
        X509Certificate rootCertificate = null;
        X509Certificate interCertificate = null;
