    static private void addEncryptedFileToZip(String signedCertificate,String IDACertificate , String destZipFile)
            throws Exception {
        //This is name and path of zip file to be created
        ZipFile zipFile = new ZipFile(destZipFile);
//        System.out.println("test" + zipFile);
        //Add files to be archived into zip file
        ArrayList<File> filesToAdd = new ArrayList<File>();
        filesToAdd.add(new File(signedCertificate));
        filesToAdd.add(new File(IDACertificate));
        ZipParameters parameters = new ZipParameters();
        parameters.setCompressionMethod(Zip4jConstants.COMP_DEFLATE); // set compression method to deflate compression
        parameters.setCompressionLevel(Zip4jConstants.DEFLATE_LEVEL_NORMAL);
        //Set the encryption flag to true
        parameters.setEncryptFiles(true);
        System.out.println("no of files " + filesToAdd.size());
        //Set the encryption method to AES Zip Encryption
        parameters.setEncryptionMethod(Zip4jConstants.ENC_METHOD_AES);

        parameters.setAesKeyStrength(Zip4jConstants.AES_STRENGTH_256);

        //Set password
//        parameters.setPassword("test@123");
         randomValue= createInitialPwd();

        parameters.setPassword(randomValue);
//        System.out.println("testparameters" + parameters);
        //Now add files to the zip file
        zipFile.addFiles(filesToAdd, parameters);

    }




    @RequestMapping(value = "/deletePartnerLicense")
    public String deletePartnerLicense(@RequestBody String licensePartId , HttpServletRequest request) throws Exception {
        String returnVal = "false";
        String status="";
        String partnerId = "";
        final String transactionId=Transaction.generateTransaction();
        org.json.JSONObject jsonObject = new org.json.JSONObject(licensePartId);
        try {
           status = jsonObject.get("status").toString();
           partnerId = jsonObject.get("partId").toString();
           if( jsonObject.get("status").equals("TSP")){

               auditRequestFactory.buildRequest(AuditModules.PDMS_PARTNER,AuditEvents.PARTNER_EVENT,"NO_ID",transactionId,"delete request for this tsp license key :"+jsonObject.get("licenseKey").toString(),request);

            int checkLicenseKey =  mispLicenseKeyService.DeleteLicenseKey(jsonObject.get("partId").toString(),jsonObject.get("licenseKey").toString());
              int checkMSPLicenseKey =  mspMsipLicenseService.DeleteLicenseKey(jsonObject.get("partId").toString(),jsonObject.get("licenseKey").toString());
            if(checkLicenseKey >= 1 || checkMSPLicenseKey >= 1 ){
                returnVal = "true";
                auditRequestFactory.buildRequest(AuditModules.PDMS_PARTNER,AuditEvents.PARTNER_EVENT,"NO_ID",transactionId,"tsp license key :"+jsonObject.get("licenseKey").toString()+" is deleted successfully",request);

            }
            else {
                auditRequestFactory.buildRequest(AuditModules.PDMS_PARTNER,AuditEvents.PARTNER_EVENT,"NO_ID",transactionId,"tsp license key :"+jsonObject.get("licenseKey").toString()+" is deleted failed",request);
            }

          }else{

               auditRequestFactory.buildRequest(AuditModules.PDMS_PARTNER,AuditEvents.PARTNER_EVENT,"NO_ID",transactionId,"delete request for this api key :"+jsonObject.get("licenseKey").toString(),request);

               int checkAPIKey =  partnerPolicyService.DeleteApiKey(jsonObject.get("partId").toString(),jsonObject.get("licenseKey").toString());
              int checkMSPAPIKey =  mspPartnerPolicyService.DeleteApiKey(jsonObject.get("partId").toString(),jsonObject.get("licenseKey").toString());
              if(checkAPIKey >= 1 || checkMSPAPIKey >= 1 ){
                  returnVal = "true";
                  auditRequestFactory.buildRequest(AuditModules.PDMS_PARTNER,AuditEvents.PARTNER_EVENT,"NO_ID",transactionId,"api key :"+jsonObject.get("licenseKey").toString()+" is deleted successfully",request);
              }
              else {
                  auditRequestFactory.buildRequest(AuditModules.PDMS_PARTNER,AuditEvents.PARTNER_EVENT,"NO_ID",transactionId,"api key :"+jsonObject.get("licenseKey").toString()+" is deleted failed",request);
              }
          }
        } catch (Exception e) {
           auditRequestFactory.buildRequest(AuditModules.PDMS_PARTNER,AuditEvents.PARTNER_EVENT,"NO_ID",transactionId,jsonObject.get("status").toString()+" Key :"+jsonObject.get("licenseKey").toString()+"  is deleted failed",request);
            e.printStackTrace();
           returnVal = "false";

        }
      return returnVal;
    }


