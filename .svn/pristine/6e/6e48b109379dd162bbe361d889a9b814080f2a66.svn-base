    private void mailTemplatePartnerRegistration(String organizationName, String partnerId, String policyGrp, String emailId, String contactNumber) {

        try {

//			JsonMapper jsonMapper = new JsonMapper();
            String subject = "Partner Registrartion Successful";
            String mailTemplate = "Dear " + organizationName + ", congratulations.<br>\n<br>\n\n" +
                    "                              Thank you for joining as a Auth_Partner   <br>\n<br>\n\n" +
                    "                              Partner Id: "+ partnerId+ ",  <br>\n<br>\n\n" +
                    "                               Policy Group "+ policyGrp+ ",   <br>\n<br>\n\n" +
                    "                                Thanks & Regards,  <br>\n<br>\n\n" +
                    "                               PhilSys";
            String smsTemplate = "Dear " + organizationName + " , congratulations. Thank you for joining as a Auth_Partner";

            EmailNotifyResponseDto response = mailService.emailNotification(emailId, subject, mailTemplate, "");
            System.out.println("mail testing:" + response);
            String val = AdminApprovalController.sendSMS(smsTemplate, contactNumber);
            System.out.println("5. Mail & sms send success :" + val);

        } catch (Exception e) {
            e.printStackTrace();
            logger.error("Response from RPController for partner creation", e.getMessage());
        }

    }

    private void mailTemplate(String organizationName, String partnerId, String policyGrp, String emailId, String contactNumber) {

        try {

//			JsonMapper jsonMapper = new JsonMapper();
            String subject = "Partner Registrartion Details";
            String mailTemplate = "Dear " + organizationName + ", <br>\n<br>\n\n" +
                    "                                PartnerId :  " + partnerId + " <br>\n<br>\n\n" +
                    "                                Policy Type :  " + policyGrp + " <br>\n<br>\n\n" +
                    "                                registered Successfully,  <br>\n<br>\n\n" +
                    "                                Thanks & Regards,  <br>\n<br>\n\n" +
                    "                               PhilSys";
            String smsTemplate = "PartnerId :" + partnerId + "Policy Type :  " + policyGrp + " registered Successfully";

            EmailNotifyResponseDto response = mailService.emailNotification(emailId, subject, mailTemplate, "");
            System.out.println("mail testing:" + response);
            String val = AdminApprovalController.sendSMS(smsTemplate, contactNumber);
            System.out.println("5. Mail & sms send success :" + val);

        } catch (Exception e) {
            e.printStackTrace();
            logger.error("Response from RPController for partner creation", e.getMessage());
        }

    }


