    @RequestMapping(value="/editPartnerRegistration")
    public MSPPartnerRegistration editPartnerRegistration(@RequestBody String partnerId){
        logger.info("calling  userService from UserCreationController for viewUserList");
        return partnerRegistrationMSPService.getalldata(partnerId);
    }
    @RequestMapping(value="/deletePartnerType")
    public String deletePartnerType(@RequestBody String id){
        logger.info("calling  partner type for deleting partner type");
        String returnVal="";
        try{
            partnerService.deleteById(id);
            mspPartnerTypeService.deleteById(id);
            returnVal = "Partner Type Deleted Successfully";

        }catch(Exception e){
            e.printStackTrace();
            returnVal = "Partner Type Deleted Failed";
        }
        return returnVal;
    }


