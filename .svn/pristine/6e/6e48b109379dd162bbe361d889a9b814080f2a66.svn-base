    @RequestMapping("/getPartners")
    public String getPartners(@RequestBody String partner) throws ParseException, NoSuchAlgorithmException, KeyManagementException {
        logger.info("calling APIConnection from RPController for getPartners");
        turnOffSslChecking();
        APIConnection.authenticate();
        ResourceBundle bundle = APIConnection.readConfig();
        org.json.JSONObject jsonObject = new org.json.JSONObject(partner);
        //         /v1/partnermanager/partners?partnerType="+sample
        return APIConnection.connectApi(bundle.getString("base.url") + bundle.getString("version") + bundle.getString("partnermanager.partner.url") +
                "/partners?partnerType=" + jsonObject.get("partnerType"), "GET", "", "Cookie");
    }

