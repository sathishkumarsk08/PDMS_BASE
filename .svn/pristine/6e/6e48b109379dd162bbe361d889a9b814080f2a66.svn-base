    //    @RequestMapping( value = "/getMispLicense")
    public String getMispLicense(String partId) throws JsonParseException, JsonMappingException, JsonProcessingException, IOException, NoSuchAlgorithmException, KeyManagementException {
        logger.info("calling from Admin Approval Controller getMispLicense");
        System.out.println("1.enter in misp license ");
        turnOffSslChecking();
        APIConnection.authenticate();
        ResourceBundle bundle = APIConnection.readConfig();
        org.json.JSONObject template = new org.json.JSONObject(bundle.getString("template"));
//        org.json.JSONObject jsonObject = new org.json.JSONObject(license);
        String returnVal = "";
        try {
            org.json.JSONObject requestTemp = template.getJSONObject("request");
            requestTemp.put("providerId", partId);
            template.put("requesttime", APIConnection.formatToISOString(APIConnection.getUTCCurrentDateTime()));
            template.put("request", requestTemp);
        } catch (Exception e) {
            e.printStackTrace();
        }
        System.out.println("2. Template to Msoip:" + template.toString());
        //         /v1/partnermanager/misps
        String record = APIConnection.connectApi(bundle.getString("base.url") + bundle.getString("version") + bundle.getString("partnermanager.partner.misp"),
                "POST", template.toString(), "Cookie");
        System.out.println("3. output from Mosip :" + record);
        org.json.JSONObject jsoninput = new org.json.JSONObject(record);
        String responseData = (jsoninput.get("response")).toString();
        if (responseData.equals("null")) {
            returnVal = "false";
        } else {
            returnVal = "true";
            org.json.JSONObject jsoninput1 = new org.json.JSONObject(responseData);

            MSPMosipLicense lic = new MSPMosipLicense();
            lic.setId(partId);
            lic.setKey(jsoninput1.get("licenseKey").toString());
            String startDate = jsoninput1.get("licenseKeyExpiry").toString();
            String validFrom = jsoninput.get("responsetime").toString();
//            DateTimeFormatter formatter = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss");
//            DateTimeFormatter formatter = DateTimeFormatter.ofPattern("yyyy-MM-dd'T'HH:mm:ss.SSSXXX");
//            DateTimeFormatter output =  DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss");
//            Date d = sdf.parse(time);
//            String formattedTime = output.format(d);
//            LocalDateTime startDateTime = LocalDateTime.parse(startDate, formatter);
            LocalDateTime startDateTime = LocalDateTime.parse(startDate, DateTimeFormatter.ISO_DATE_TIME);
//            LocalDateTime validDateTime = LocalDateTime.parse(validFrom, formatter);
            lic.setValidFrom(APIConnection.getUTCCurrentDateTime());
            lic.setValidTo((startDateTime));
            lic.setActive(true);
            lic.setCrBy("11011");
            lic.setCrDtimes(APIConnection.getUTCCurrentDateTime());
            lic.isDeleted(false);
            mspMsipLicenseService.save(lic);
//            MSPPartnerRegistration reg = partnerRegistrationMSPService.getEmailId(jsonObject.get("partnerId").toString());
            PartnerRegistration reg = partnerRegistrationService.getEmailId(partId);
            ResourceBundle mailBundle = APIConnection.readConfig();
//			JsonMapper jsonMapper = new JsonMapper();
            String subject = "MISP License Key";
            String mailTemplate = "Dear " + reg.getName() + ", <br>\n<br>\n\n" +
                    "                                Partner Key(MISP License ) :  " + jsoninput1.get("licenseKey").toString() + " <br>\n<br>\n\n" +
                    "                                Thanks & Regards,  <br>\n<br>\n\n" +
                    "                               PhilSys";

//            boolean mailResponse = new ApiController().sendmailprocess( reg.getEmailId(), "Partner Key", mailTemplate);
//				boolean mailResponse = new ApiController().sendmailprocess( "arunkrishna1410@gmail.com", "PARTNER Captcha", mailTemplate);
//            if(mailResponse){
//                System.out.println("------License send------");
//
//            }else{
//                returnVal = "";
//            }
            try {
                EmailNotifyResponseDto response = mailService.emailNotification(reg.getEmail(), subject, mailTemplate, "");
                System.out.println("mail testing:" + response);
            } catch (Exception e) {
                e.printStackTrace();
            }
            System.out.println("4. data saved in local pms :");
        }
        return record;
    }

