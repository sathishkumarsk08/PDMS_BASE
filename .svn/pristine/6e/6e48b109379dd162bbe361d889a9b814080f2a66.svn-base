    public void signatureCertificateMailTransfer(String partnerId,String signatureValue, String IDAPartnerValue) throws Exception {
        String sOsName = System.getProperty("os.name");
        String signedFileName =partnerId+"_signedcertificate.txt";
        String IDAFileName =partnerId+"_IDAcertificate.txt";
        String signedFilePath1 = "";
        String IDAFilePath1 = "";
        String destZipFile =partnerId+"_SignedCertificate.zip" ;
        EmailNotifyResponseDto response= new EmailNotifyResponseDto();
        try {
            PartnerRegistration reg = partnerRegistrationService.getEmailId(partnerId);

            if (sOsName.startsWith("Windows")) {
                System.out.println("WINDOWS OS");
                signedFilePath1 = new FileSystemResource("").getFile().getAbsolutePath() + "\\" + signedFileName;
                IDAFilePath1 = new FileSystemResource("").getFile().getAbsolutePath() + "\\" + IDAFileName;
                try (FileWriter fileWriter = new FileWriter(signedFilePath1)) {
                    fileWriter.write(signatureValue);
                }
                try (FileWriter fileWriter = new FileWriter(IDAFilePath1)) {
                    fileWriter.write(IDAPartnerValue);
                }

            } else {

                if ((sOsName.startsWith("Linux")) || (sOsName.startsWith("Mac")) || (sOsName.startsWith("HP-UX"))) {
                    System.out.println("LINUX OS");
                    signedFilePath1 = new FileSystemResource("").getFile().getAbsolutePath() + "/" + signedFileName;
                    IDAFilePath1 = new FileSystemResource("").getFile().getAbsolutePath() + "/" + IDAFileName;
                    try (FileWriter fileWriter = new FileWriter(signedFilePath1)) {
                        fileWriter.write(signatureValue);
                    }
                    try (FileWriter fileWriter = new FileWriter(IDAFilePath1)) {
                        fileWriter.write(IDAPartnerValue);
                    }
                } else {
                    System.out.println("The current operating system '" + sOsName + "' is not supported.");
                }
            }
            File file = new File(destZipFile);
            addEncryptedFileToZip(signedFilePath1, IDAFilePath1, destZipFile);
            MultiValueMap<String, String> fileMap = new LinkedMultiValueMap<>();
            ContentDisposition contentDisposition = ContentDisposition
                    .builder("form-data")
                    .name("attachments")
                    .filename(file.getName())
                    .build();
            fileMap.add(HttpHeaders.CONTENT_DISPOSITION, contentDisposition.toString());
            fileMap.add(HttpHeaders.CONTENT_TYPE, "application/pdf");
            HttpEntity<byte[]> fileEntity = new HttpEntity<>(Files.readAllBytes(file.toPath()), fileMap);
            String subject = "Signed Certificate";
            String mailTemplate = "Dear " + reg.getName() + ", <br>\n<br>\n\n" +
//                    "                                Signed Certificate :  " + jsoninput1.get("signedCertificateData").toString() + " <br>\n<br>\n\n" +
                    "                              Enclosed signed certificate  <br>\n<br>\n\n" +
                    "                             Password to decrypt the attachment will be sent in separate mail.  <br>\n<br>\n\n" +
                    "                              Note: This is a system(PDMS) generated mail. <br>\n<br>\n\n" +
                    "                               Thanks & Regards,  <br>\n<br>\n\n" +
                    "                               PhilSys";


            try {
                response = mailService.attachedEmailNotification(reg.getEmail(), subject, mailTemplate, fileEntity);

                System.out.println("mail testing:" + response);
                if (response.getResponse().getStatus().equals("success")) {
                    String passSubject = "Signed Certificate Password";
                    String passMailTemplate = "Dear " + reg.getName() + ", <br>\n<br>\n\n" +
                            "                            Password to Decrypt file: " + randomValue + " <br>\n<br>\n\n" +
                            "                     Thanks & Regards,  <br>\n<br>\n\n" +
                            "                      PhilSys";
                    EmailNotifyResponseDto passResponses = mailService.emailNotification(reg.getEmail(), passSubject, passMailTemplate, "");
                    String smsTemplate = "Dear " + reg.getName() + " , congratulations.  Password to Decrypt file: " + randomValue + "";

                    System.out.println("mail testing:" + response);
                    String val = AdminApprovalController.sendSMS(smsTemplate, reg.getContact());
                    Files.delete(Paths.get(signedFilePath1));
                    Files.delete(Paths.get(IDAFilePath1));
                    Files.delete(Paths.get(destZipFile));
                }

            } catch (Exception e) {
                e.printStackTrace();
            }
        }catch (Exception e){
            e.printStackTrace();
        }
    }

