    @RequestMapping("/delsigncert")
    public String delsigncert(@RequestBody String partnerId) throws JsonParseException, JsonMappingException, JsonProcessingException, IOException, NoSuchAlgorithmException, KeyManagementException, CertificateException, UnrecoverableEntryException, KeyStoreException, InvalidKeySpecException {
        logger.info("calling mspSignCertStoreService from RPController for delete signature certificate");
        PartnerRegistration partnerRegistration = null;
        System.out.println(partnerId);
////		partnerRegistration.setCertificate(null);
        mspSignCertStoreService.certdel(partnerId);
        JSONObject jsonObject = new JSONObject();


//		MSPPartnerRegistration reg = partnerRegistrationMSPService.getalldata(partnerId);
        PartnerRegistration reg = partnerRegistrationService.getalldata(partnerId);
        System.out.println(reg);
        String org = reg.getName();
        String parttype = reg.getPartnerType();
        String type = "";
        if (parttype.equals("Auth_Partner")) {
            type = "AUTH";
        } else if (parttype.equals("MISP_Partner")) {
            type = "AUTH";
        }else if (parttype.equals("Credential_Partner")) {
            type = "AUTH";
        } else if (parttype.equals("Device_Provider")) {
            type = "DEVICE";
        } else if (parttype.equals("FTM_Provider")) {
            type = "FTM";
        }

        try {
            KeyManagerPartnerCertStore type1 =  keyMgrPartCertStoreService.getCertAliasRecord(reg.getCertificate());
            ArrayList<KeyManagerCaCertStore> delType = (ArrayList<KeyManagerCaCertStore>) keyMgrCaCertStoreService.getOrganisationRecord("%O="+type1.getOrgname()+",%", type1.getPartDomain());

            KeyManagerCaCertStore keyManagerCaCertStore = null;
//            ArrayList<KeyManagerCaCertStore> delallcert = (ArrayList<KeyManagerCaCertStore>) keyMgrCaCertStoreService.certdeletion("%" + org + "%", type);
//		KeyManagerCaCertStore delallcert= keyMgrCaCertStoreService.certdeletion("%"+org+"%",type);
            System.out.println(delType.size());
            for (int i = 0; i < delType.size(); i++) {
                keyMgrCaCertStoreService.Delete(delType.get(i).getCertId());
            }
            int val = partnerRegistrationService.certificateAliasdel(partnerId);
            System.out.println(val);
            int val1 = partnerRegistrationMSPService.certificateAliasdel(partnerId);
            System.out.println(val1);
            int val2 = deviceModelRegistrationMSPService.certificateAliasdel(partnerId);
            System.out.println(val2);

        } catch (Exception e) {
            System.out.println("Action failed");
            e.printStackTrace();
            return "false";
        }
        KeyManagerPartnerCertStore keyManagerPartnerCertStore = null;

        ArrayList<KeyManagerPartnerCertStore> del1 = (ArrayList<KeyManagerPartnerCertStore>) keyMgrPartCertStoreService.certdeletion("%O="+org+",%", type);
        System.out.println(del1.size());
        for (int i = 0; i < del1.size(); i++) {
            keyMgrPartCertStoreService.Delete(del1.get(i).getCertId());
        }

        IDACaCertStore idaCaCertStore = null;
        ArrayList<IDACaCertStore> del2 = (ArrayList<IDACaCertStore>) idaCaCertStoreService.certdeletion("%O="+org+",%", type);
        System.out.println(del2);
        for (int i = 0; i < del2.size(); i++) {
            idaCaCertStoreService.Delete(del2.get(i).getCertId());
        }
        return "true";
    }

    @RequestMapping("/delpartnerscertifi")
    public String delpartnerscertifi(@RequestBody String partnerId) throws JsonParseException, JsonMappingException, JsonProcessingException, IOException, NoSuchAlgorithmException, KeyManagementException, CertificateException, UnrecoverableEntryException, KeyStoreException, InvalidKeySpecException {
        logger.info("calling mspSignCertStoreService from RPController for delete Root certificate");
        KeyManagerCaCertStore keyManagerCaCertStore = null;

        MSPPartnerRegistration reg = partnerRegistrationMSPService.getEmailId(partnerId);

        KeyManagerCaCertStore delrootcert = keyMgrCaCertStoreService.certdel("%" + reg.getOrganisationName() + "%");
        System.out.println(delrootcert);
        keyMgrCaCertStoreService.Delete(delrootcert.getCertId());

        KeyManagerPartnerCertStore keyManagerPartnerCertStore = null;
        KeyManagerPartnerCertStore del1 = keyMgrPartCertStoreService.certdel("%" + reg.getOrganisationName() + "%");
        System.out.println(del1);
        keyMgrPartCertStoreService.Delete(del1.getCertId());

        IDACaCertStore idaCaCertStore = null;
        IDACaCertStore del2 = idaCaCertStoreService.certdel("%" + reg.getOrganisationName() + "%");
        System.out.println(del2);
        idaCaCertStoreService.Delete(del2.getCertId());


        return partnerId;
    }

