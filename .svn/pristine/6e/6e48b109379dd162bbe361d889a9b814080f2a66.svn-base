        if(partnerList.isPresent()){
            partnerCertificate=partnerList.get().get(0);
            map.put("partner",partnerCertificate);
        }

        Optional<List<X509Certificate>> listOfCer= list1.values().stream().filter(x509Certificates -> x509Certificates.size() > 1).findFirst();
        if(listOfCer.isPresent()){
            rootCertificate=listOfCer.get().stream().filter(x->x.getSubjectDN().equals(x.getIssuerDN())).findFirst().get();
            interCertificate=listOfCer.get().stream().filter(x->!x.getSubjectDN().equals(x.getIssuerDN())).findFirst().get();
            map.put("root",rootCertificate);
            map.put("inter",interCertificate);
        }
        System.out.println("group: "+gson.toJson(map));



//            for (int i = certificateList.size() - 1; i >= 0; i--) {
//                Certificate store = new Certificate();
        X509Certificate certificate = (X509Certificate) rootCertificate;

//        Date validFrom = certificate.getNotBefore();
//        Date validTo = certificate.getNotAfter();
//                 System.out.println("full root data:"+certificate);
//                 System.out.println("full root data eret:"+rootCertificate);

//        String thumbprint = apiController.calculateThumbprint(certificate.getEncoded());

//        System.out.println("root valid from:"+validFrom);
//        System.out.println("root valid to:"+validTo);
        System.out.println("root cert serial number:"+certificate.getSerialNumber());

        X509Certificate certificateInter = (X509Certificate) interCertificate;
//        Date interValidFrom = certificateInter.getNotBefore();
//        Date interValidTo = certificateInter.getNotAfter();
//                 System.out.println("full inter data:"+certificateInter);
//        System.out.println("inter valid from:"+interValidFrom);
//        System.out.println("inter valid to:"+interValidTo);
        System.out.println("inter cert serial number:"+certificateInter.getSerialNumber());


//                System.out.println("full partner data:"+type1.certData);
        System.out.println("partner valid from:"+type1.certBefore);
        System.out.println("partner valid to:"+type1.certAfter);
        System.out.println("partner cert serial number:"+type1.certSerial);


        List<Certificate> certList = new ArrayList<>();
        Certificate rootCert = new Certificate();
        Certificate interCert = new Certificate();
        Certificate partnerCert = new Certificate();

        rootCert.setDomain("ROOT");
        interCert.setDomain("INTERMEDIATE");
        partnerCert.setDomain("PARTNER");



        SimpleDateFormat inputFormat = new SimpleDateFormat("EEE MMM dd HH:mm:ss zzz yyyy");
        SimpleDateFormat outputFormat = new SimpleDateFormat("yyyy-MM-dd");

        try {
            Date rootValidFrom = inputFormat.parse(certificate.getNotBefore().toString());
            Date rootValidTo = inputFormat.parse(certificate.getNotAfter().toString());


            Date interValidFrom = inputFormat.parse(certificateInter.getNotBefore().toString());
            Date interValidTo = inputFormat.parse(certificateInter.getNotAfter().toString());

            String rootCertValidFrom = outputFormat.format(rootValidFrom);
            String rootCertValidTo = outputFormat.format(rootValidTo);
            rootCert.setCreatedDate(rootCertValidFrom);
            rootCert.setExpiryDate(rootCertValidTo);

            String interCertValidFrom = outputFormat.format(interValidFrom);
            String interCertValidTo = outputFormat.format(interValidTo);
            interCert.setCreatedDate(interCertValidFrom);
            interCert.setExpiryDate(interCertValidTo);

            System.out.println("rootCertValidFrom " + rootCertValidFrom);
            System.out.println("rootCertValidTo "+rootCertValidTo);

            System.out.println("interCertValidFrom "+interCertValidFrom);
            System.out.println("interCertValidTo "+interCertValidTo);

        } catch (java.text.ParseException e) {
            e.printStackTrace();
        }

        try {
            DateTimeFormatter inputFormatter = DateTimeFormatter.ofPattern("yyyy-MM-dd'T'HH:mm:ss");
            DateTimeFormatter outputFormatter = DateTimeFormatter.ofPattern("yyyy-MM-dd");

            LocalDateTime partnerValidFrom = LocalDateTime.parse(type1.certBefore.toString(), inputFormatter);
            LocalDateTime partnerValidTo = LocalDateTime.parse(type1.certAfter.toString(), inputFormatter);

            String partnerCertValidFrom = partnerValidFrom.format(outputFormatter);
            String partnerCertValidTo = partnerValidTo.format(outputFormatter);
            partnerCert.setCreatedDate(partnerCertValidFrom);
            partnerCert.setExpiryDate(partnerCertValidTo);

            System.out.println("partnerCertValidFrom "+partnerCertValidFrom);
            System.out.println("partnerCertValidTo "+partnerCertValidTo);
        } catch (Exception e) {
            e.printStackTrace();
        }

        try {
            String thumbprintRootCertificate = getThumbprint(certificate, "SHA-1");
            String thumbprintInterCertificate = getThumbprint(certificateInter, "SHA-1");

            rootCert.setThumbPrint(thumbprintRootCertificate);
            interCert.setThumbPrint(thumbprintInterCertificate);
            partnerCert.setThumbPrint(type1.certThumbprint);

            certList.add(rootCert);
            certList.add(interCert);
            certList.add(partnerCert);

            System.out.println("SHA-1 thumbprintRootCertificate: " + thumbprintRootCertificate);
            System.out.println("SHA-1 thumbprintInterCertificate: " + thumbprintInterCertificate);
            System.out.println("Partner thumbprint details:"+type1.certThumbprint);
        } catch (NoSuchAlgorithmException e) {
            System.err.println("SHA-1 algorithm not found");
        }



        return certList;
    }


    public static String getThumbprint(X509Certificate cert, String hashAlgorithm) throws NoSuchAlgorithmException, CertificateEncodingException {
        MessageDigest digest = MessageDigest.getInstance(hashAlgorithm);
        byte[] encodedCert = cert.getEncoded();
        byte[] hashedCert = digest.digest(encodedCert);
        return toHexString(hashedCert);
    }

    private static String toHexString(byte[] bytes) {
        StringBuilder hexString = new StringBuilder();
        for (byte b : bytes) {
            String hex = Integer.toHexString(0xff & b);
            if (hex.length() == 1) {
                hexString.append('0');
            }
            hexString.append(hex);
        }
        return hexString.toString();
    }


    @PostMapping("/deleteCert")
    public int deleteCert(@RequestBody String data){
        org.json.JSONObject jsonObject = new org.json.JSONObject(data);
        System.out.println("deleteCert " + jsonObject);
        System.out.println("domain " + jsonObject.get("domain").toString());
        System.out.println("deleteCert " + jsonObject.get("thumbPrint").toString());
        System.out.println("deleteCert " + jsonObject.get("organizationName").toString());

        if(jsonObject.get("domain").toString().equalsIgnoreCase("PARTNER")){
            return keyMgrPartCertStoreService.deletePartnerCert(jsonObject.get("thumbPrint").toString() , jsonObject.get("organizationName").toString());
        }else {
            return keyMgrCaCertStoreService.deleteCert(jsonObject.get("thumbPrint").toString() , jsonObject.get("organizationName").toString());
        }

    }

    @PostMapping("/deleteCertificate")
    public int deleteCertificate(@RequestBody String data , HttpServletRequest request) throws JsonProcessingException {
        org.json.JSONObject jsonObject = new org.json.JSONObject(data);
        final String transactionId=Transaction.generateTransaction();
        String domain = jsonObject.get("domain").toString();
        String certId = jsonObject.get("certId").toString();
        String signedCertId = jsonObject.get("signedCertId").toString();
        String partnerId = jsonObject.get("partnerId").toString();

        AuditModules auditModules = null;
        AuditEvents auditEvents = null;

        if(partnerId.startsWith("AP") || partnerId.startsWith("TSP")){
            auditModules = AuditModules.PDMS_PARTNER;
            auditEvents = AuditEvents.PARTNER_EVENT;
        }else {
            auditModules = AuditModules.PDMS_DEVICE;
            auditEvents = AuditEvents.DEVICE_EVENT;
        }

        auditRequestFactory.buildRequest(auditModules,auditEvents,"NO_ID",transactionId,"Delete "+domain+" Certificate request. certId :"+certId,request);

        int n = 0;

        if(domain.equals("PARTNER")){
            n+=  keyMgrPartCertStoreService.deletePartnerCertificate(certId);
            auditRequestFactory.buildRequest(auditModules,auditEvents,"NO_ID",transactionId,"Delete "+domain+" Certificate success. certId :"+certId,request);
            auditRequestFactory.buildRequest(auditModules,auditEvents,"NO_ID",transactionId,"Delete SIGNED Certificate request. certId :"+signedCertId,request);

            if(n!=0){
              n+= keyMgrCaCertStoreService.deleteCertificate(new String[]{signedCertId});
              n+= idaCaCertStoreService.deleteCertificate(signedCertId);
                auditRequestFactory.buildRequest(auditModules,auditEvents,"NO_ID",transactionId,"Delete SIGNED Certificate success. certId :"+signedCertId,request);


                partnerRegistrationService.certificateAliasdel(partnerId);
               partnerRegistrationMSPService.certificateAliasdel(partnerId);
               deviceModelRegistrationMSPService.certificateAliasdel(partnerId);

              return n;
           }else {
               return n;
           }
        }else {
             n+= keyMgrCaCertStoreService.deleteCertificate(new String[]{certId});
             n+= idaCaCertStoreService.deleteCertificate(certId);

            auditRequestFactory.buildRequest(auditModules,auditEvents,"NO_ID",transactionId,"Delete "+domain+" Certificate success. certId :"+certId,request);

            partnerRegistrationService.certificateAliasdelForRootInter(partnerId);
            partnerRegistrationMSPService.certificateAliasdelForRootInter(partnerId);
            deviceModelRegistrationMSPService.certificateAliasdel(partnerId);

             return n;
        }


    }

