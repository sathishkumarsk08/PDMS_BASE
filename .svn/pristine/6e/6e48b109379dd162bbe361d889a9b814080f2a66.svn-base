    @PostMapping("/fetchBulkDeviceData")
   
    public int fetchBulkDeviceData(@RequestBody String bulkDevList , HttpServletRequest request) throws JsonParseException,
            JsonMappingException,
            JsonProcessingException,
            IOException,
            NoSuchAlgorithmException,
            KeyManagementException {
        System.out.println("BulkDevList  " + bulkDevList);
        final String transactionId=Transaction.generateTransaction();
        org.json.JSONArray jsonArray = new org.json.JSONArray(bulkDevList);
        auditRequestFactory.buildRequest(AuditModules.PDMS_DEVICE,AuditEvents.DEVICE_EVENT,"NO_ID",transactionId,"upload bulk device request",request);
        System.out.println("BulkDevList JSONArray " + jsonArray);
        int successCount = 0;
        String val= "";
//        System.out.println("BulkDevList JSONArray2 " + jsonArray.get(2));

        for (Object newDevice : jsonArray){

            org.json.JSONObject newDev = new org.json.JSONObject(newDevice.toString());
            System.out.println(newDev);
//            System.out.println(newDev.get("deviceType"));
//            System.out.println(newDev.get("brandName"));
//            System.out.println(newDev.get("serialNumber"));
//            System.out.println(newDev.get("productId"));
//            System.out.println(newDev.get("mobile"));
//            System.out.println(newDev.get("deviceCertif"));
//            System.out.println(newDev.get("location"));
//            System.out.println(newDev.get("deviceModel"));
//            System.out.println(newDev.get("validity"));
//            System.out.println(newDev.get("deviceName"));
//            System.out.println(newDev.get("email"));
//            System.out.println(newDev.get("supportingDoc"));

            if(newDev.get("deviceType").toString().isBlank() || newDev.get("brandName").toString().isBlank() || newDev.get("serialNumber").toString().isBlank() ||
               newDev.get("productId").toString().isBlank() || newDev.get("mobile").toString().isBlank() || newDev.get("validity").toString().isBlank() ||
               newDev.get("location").toString().isBlank() || newDev.get("deviceModel").toString().isBlank() || newDev.get("email").toString().isBlank() || newDev.get("deviceName").toString().isBlank()

            ){
                 continue;
            }

            val = bulkDeviceRegistration(newDevice.toString());
            if(val.equals("true")){
                successCount++;
            }
//            org.json.JSONObject data = new org.json.JSONObject(newDevice.toString());
//            System.out.println(data.get("serialNumber").toString());
        }
        auditRequestFactory.buildRequest(AuditModules.PDMS_DEVICE,AuditEvents.DEVICE_EVENT,"NO_ID",transactionId,"upload bulk device success",request);

        return successCount;
    }


    public static void turnOffSslChecking() throws NoSuchAlgorithmException, KeyManagementException {
        // Install the all-trusting trust manager

        final SSLContext sc = SSLContext.getInstance("SSL");
        sc.init(null, UNQUESTIONING_TRUST_MANAGER, null);
        HttpsURLConnection.setDefaultSSLSocketFactory(sc.getSocketFactory());
        // Create all-trusting host name verifier
        HostnameVerifier allHostsValid = new HostnameVerifier() {
            public boolean verify(String hostname, SSLSession session) {
                return true;
            }
        };
        // Install the all-trusting host verifier
        HttpsURLConnection.setDefaultHostnameVerifier(allHostsValid);
    }


