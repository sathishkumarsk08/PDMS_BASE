//            FileInputStream inputStream = new FileInputStream(filePath1+"/certificate.txt");
        String newFile = "";
        String destZipFile = "signedcertificate.zip";
        String sOsName = System.getProperty("os.name");
        if (sOsName.startsWith("Windows")) {
            System.out.println("WINDOWS OS");
            filePath1 = new FileSystemResource("").getFile().getAbsolutePath() + "\\signedcertificate.txt";

        } else {

            if ((sOsName.startsWith("Linux")) || (sOsName.startsWith("Mac")) || (sOsName.startsWith("HP-UX"))) {
                System.out.println("LINUX OS");
                filePath1 = new FileSystemResource("").getFile().getAbsolutePath() + "/signedcertificate.txt";
//                    File catalinaBase = new File(System.getProperty("catalina.base")).getAbsoluteFile();
//                    newFile = new File(catalinaBase, "bin/signedcertificate.txt");
            } else {
                System.out.println("The current operating system '" + sOsName + "' is not supported.");
            }
        }
        filePath1 = new FileSystemResource("").getFile().getAbsolutePath() + "\\signedcertificate.txt";
        filePath1 = new FileSystemResource("").getFile().getAbsolutePath() + "\\signedcertificate.txt";
//        try (FileWriter fileWriter = new FileWriter(filePath)) {
//            fileWriter.write(value);
