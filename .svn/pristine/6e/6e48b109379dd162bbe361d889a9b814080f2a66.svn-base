        try{
            PartnerRegistration record = partnerRegistrationService.getalldata(partnerId);
            MSPDeviceModelRegistration device = deviceModelRegistrationMSPService.getIdDetail(partnerId);
            if(record != null) {
                authBean.setPartner(record);
                authBean.setDevice(device);
                authBean.setSusBlackStatus(device.getSusBlackStatus());

                    if (record.getPartnerType().equals("Auth_Partner") || record.getPartnerType().equals("MISP_Partner") || record.getPartnerType().equals("Credential_Partner"))
                        partnerDomain = "AUTH";
                    else if (record.getPartnerType().equals("Device_Provider"))
                        partnerDomain = "DEVICE";
                    else if (record.getPartnerType().equals("FTM_Provider"))
                        partnerDomain = "FTM";


                ArrayList<KeyManagerCaCertStore> type = (ArrayList<KeyManagerCaCertStore>) keyMgrCaCertStoreService.getOrganisationRecord("%O="+record.getName()+",%", partnerDomain);

                HashMap<String , KeyManagerCaCertStore> certificates = keyMgrCaCertStoreService.separateCert(type);

                try {
                     type1 =  keyMgrPartCertStoreService.getCertAliasRecord(record.getCertificate());
                }catch (Exception e){
                    System.out.println(e.getMessage());
                }


                if(certificates.containsKey("Root")){
                    Certificate rootCert = new Certificate();
                    rootCert.setDomain("ROOT");
                    rootCert.setCreatedDate(certificates.get("Root").certBefore.toString());
                    rootCert.setExpiryDate(certificates.get("Root").certAfter.toString());
                    rootCert.setCert_id(certificates.get("Root").certId);
                    certList.add(rootCert);
                }

                if(certificates.containsKey("Intermediate")){
                    Certificate interCert = new Certificate();
                    interCert.setDomain("INTERMEDIATE");
                    interCert.setCreatedDate(certificates.get("Intermediate").certBefore.toString());
                    interCert.setExpiryDate(certificates.get("Intermediate").certAfter.toString());
                    interCert.setCert_id(certificates.get("Intermediate").certId);
                    certList.add(interCert);
                }


                try{
                    Certificate partnerCert = new Certificate();
                    if(Objects.nonNull(type1)){
                        partnerCert.setDomain("PARTNER");
                        partnerCert.setCreatedDate(type1.certBefore.toString());
                        partnerCert.setExpiryDate(type1.certAfter.toString());
                        partnerCert.setCert_id(type1.certId);
                        certList.add(partnerCert);
                    }

                    if(certificates.containsKey("Signed")){
                        Certificate signedCert = new Certificate();
                        signedCert.setDomain("SIGNED");
                        signedCert.setCreatedDate(certificates.get("Signed").certBefore.toString());
                        signedCert.setExpiryDate(certificates.get("Signed").certAfter.toString());
                        signedCert.setCert_id(certificates.get("Signed").certId);
                        certList.add(signedCert);
                    }


                }catch (Exception e){
                    System.out.println(e.getMessage());
                }
                System.out.println("All Certs " + certList);
                System.out.println("All Certs Len " + certList.size());
                authBean.setCertificateList(certList);


//                    for (int i = 0; i < type.size(); i++) {
//                        Certificate store = new Certificate();
//                        if (i == 0) {
//                            store.setDomain("ROOT");
//                        } else if (i == 1) {
//                            store.setDomain("INTERMEDIATE");
//                        } else if (i == 2) {
//                            store.setDomain("SIGNED");
//                        }
//                        store.setCreatedDate(type.get(i).getCertBefore().toString());
//                        store.setExpiryDate(type.get(i).getCertAfter().toString());
//                        certList.add(store);
//                    }
////                    ArrayList<KeyManagerPartnerCertStore> del1 = (ArrayList<KeyManagerPartnerCertStore>) keyMgrPartCertStoreService.certdeletion("%" + record.getName() + "%", partnerDomain);
////                    for (int j = 0; j < type1.size(); j++) {
//                        Certificate partnerStore = new Certificate();
//                            partnerStore.setDomain("PARTNER");
//                        partnerStore.setCreatedDate(type1.getCertBefore().toString());
//                        partnerStore.setExpiryDate(type1.getCertAfter().toString());
//                        partnerStore.setViewCertificate(type1.getCertData().toString());
//                        certList.add(partnerStore);
////                    }
//
//                    authBean.setCertificateList(certList);

//                ArrayList<PartnerPolicy> polic = (ArrayList<PartnerPolicy>) partnerPolicyService.getPolicyList(partnerId);
//                List<Object[]> list = partnerPolicyService.getPolicyList(partnerId);
//                for (Object[] report1 : list) {
//                    Policies bean = new Policies();
//                    bean.setName((String) report1[0]);
//                    bean.setApikey((String) report1[1]);
//                    bean.setValidFrom(((String) report1[2]));
//                    bean.setValidTo((String) report1[3]);
//                    bean.setPolicyId((String) report1[4]);
//                    policList.add(bean);
//                }
//                authBean.setPoliciesList(policList);
//

            }


        }catch(Exception e){
            e.printStackTrace();
        }

        return authBean;
    }


    public List<? extends java.security.cert.Certificate> uploadPartnerCertificate(String certData, String partnerDomain) {

        X509Certificate reqX509Cert = (X509Certificate) apiController.convertToCertificate(certData);
        List<? extends java.security.cert.Certificate> certList = apiController.getCertificateTrustPath(reqX509Cert, partnerDomain);
//        System.out.println("certificate details:"+certList);
        return certList;
    }

}

