package com.msp.mosip_pms.repository;

import com.msp.mosip_pms.model.PartnerRegistration;
import org.springframework.data.jpa.repository.Modifying;
import org.springframework.data.jpa.repository.Query;
import org.springframework.data.repository.CrudRepository;
import org.springframework.data.repository.query.Param;
import org.springframework.stereotype.Component;
import org.springframework.stereotype.Repository;

import java.time.LocalDateTime;
import java.util.List;

@Component
@Repository
public interface PartnerRegistrationRepository extends CrudRepository<PartnerRegistration, String> {

    @Modifying(flushAutomatically = true)
    @Query(value = "update PartnerRegistration u set u.active=false  where u.id=:partnerId")
    public int DeActivate(String partnerId);

    @Modifying(flushAutomatically = true)
    @Query(value = "update  PartnerRegistration u set u.approvalStatus='InProgress', u.active='false' where u.id=:partnerId")
    int certificateAliasdel(String partnerId);

    @Query(nativeQuery = true, value = "select id from pms.partner order by cr_dtimes desc limit 1 ")
    public String maxPartnerId();


    @Query(value = "SELECT t  from PartnerRegistration t where t.approvalStatus=:status and t.active=:action and t.partnerType=:type ORDER BY t.crDTime DESC")
    List<PartnerRegistration> viewPartnerReg(String status, boolean action ,String type);


    @Query(value = "SELECT t.name from PartnerRegistration t  where t.id=:partnerId")
    public String getPartnerDetails(String partnerId);

    @Query(value = "SELECT t from PartnerRegistration t where t.id=:partnerId")
    PartnerRegistration  getEmailId(String partnerId);

    @Query(value = "SELECT t  from PartnerRegistration t  where t.id=:partnerId")
    List<PartnerRegistration> getPartnerDetailId(String partnerId);

    @Query(value = "SELECT t from PartnerRegistration t where t.id=:partnerId")
    PartnerRegistration getalldata(String partnerId);

    @Query(value = "SELECT t from PartnerRegistration t where t.partnerType='Device_Provider' and t.active=true ")
    List<PartnerRegistration> getAllDevice();

    @Query(value = "SELECT t from PartnerRegistration t where t.groupId=:policyGroupId and t.active=true and t.approvalStatus='approved'")
    List<PartnerRegistration> findAllPolicyGroupPartner(String policyGroupId);

    @Modifying(flushAutomatically = true)
    @Query(value = "update  PartnerRegistration u set u.active=true where u.id=:partnerId ")
    int updatePartnerStatus(String partnerId);

    @Query(nativeQuery = true, value = "select pg.name as policygrpname, pr.id, pr.name as partnername,pr.contact_no, pr.email_id,pr.approval_status  from pms.partner pr \n" +
            "inner join pms.policy_group pg\n" +
            "on pg.id = pr.policy_group_id\n" +
            "where pr.approval_status=:status and pr.policy_group_id=:policyGroupId and pr.is_active=true and pr.partner_type_code in ('MISP_Partner' ,'Auth_Partner','Credential_Partner') and pr.cr_dtimes between cast(:startDate as timestamp) and cast(:endDate as timestamp)")
    List<Object[]> noOnboardedPartner(String status, String policyGroupId,String startDate , String endDate);

    @Query(nativeQuery = true, value = "select pg.name as policygrpname, pr.id, pr.name as partnername,pr.contact_no, pr.email_id,pr.approval_status  from pms.partner pr \n" +
            "inner join pms.policy_group pg\n" +
            "on pg.id = pr.policy_group_id\n" +
            "where pr.approval_status=:status and pr.policy_group_id=:policyGroupId  and pr.cr_by=:userId " +
            "and pr.is_active=true and pr.partner_type_code in ('MISP_Partner' ,'Auth_Partner','Credential_Partner') and pr.cr_dtimes between cast(:startDate as timestamp) and cast(:endDate as timestamp)")
    List<Object[]> noOnboardedPartner(String status, String policyGroupId,String userId,String startDate ,String endDate);


    @Query(nativeQuery = true, value = "select count(*),pr.policy_group_id,pg.name from pms.partner pr\n" +
            "inner join pms.policy_group pg\n" +
            "on pg.id=pr.policy_group_id\n" +
            "group by pr.policy_group_id,pg.name\n")
    List<Object[]> noOfDashboardPolicyGrpList();

    @Query(nativeQuery = true, value = "select pr.id, pr.name as partnername,pr.contact_no, pr.email_id,pr.approval_status  from pms.partner pr \n" +
            "where pr.approval_status=:status and pr.is_active=true and pr.partner_type_code=:type and pr.cr_dtimes between cast(:startDate as timestamp) and cast(:endDate as timestamp)")
    List<Object[]> noOnboardedDevice(String status, String type , String startDate , String endDate);

    @Query(nativeQuery = true, value = "select pr.id, pr.name as partnername,pr.contact_no, pr.email_id,pr.approval_status  from pms.partner pr \n" +
            "where pr.approval_status=:status and pr.is_active=true and pr.partner_type_code=:type and pr.cr_by=:userId and pr.cr_dtimes between cast(:startDate as timestamp) and cast(:endDate as timestamp)")
    List<Object[]> noOnboardedDevice(String status, String type, String userId , String startDate , String endDate);

    @Query(value = "SELECT count(t) from PartnerRegistration t where t.partnerType=:partnerId and t.email=:emailId and t.name=:organizationName ")
    int getMOSIPOrganizationEmailId(String partnerId,String emailId, String organizationName);

    @Query(value = "SELECT t from PartnerRegistration t where t.partnerType=:partnerId and t.email=:emailId and t.name=:organizationName")
    PartnerRegistration getMOSIPPartnerId(String partnerId, String emailId, String organizationName);

    @Query(value = "SELECT t from PartnerRegistration t where t.name=:organizationName")
    PartnerRegistration findByOrganization(String organizationName);

    @Modifying(flushAutomatically = true)
    @Query(value = "update  PartnerRegistration u set u.groupId=:policies where u.id=:partId  and u.partnerType=:partnerType")
    int updatePolicyGroup(String policies, String partId, String partnerType);

    @Query(value = "SELECT t  from PartnerRegistration t where t.partnerType=:type  ORDER BY t.crDTime DESC")
    List<PartnerRegistration> partnerRegList(String type);

    @Query(value = "SELECT t  from PartnerRegistration t where t.id in :partnerId and t.partnerType=:type and t.crBy =:userId ORDER BY t.crDTime DESC")
    List<PartnerRegistration> filterPartnerRegListRole(String type,@Param("partnerId") List<String> partnerId,String userId);

    @Query(value = "SELECT t  from PartnerRegistration t where t.id in :partnerId and t.partnerType=:type  ORDER BY t.crDTime DESC")
    List<PartnerRegistration> filterPartnerRegList(String type,@Param("partnerId") List<String> partnerId);

    @Query(value = "SELECT t  from PartnerRegistration t where t.id in :partnerId and t.partnerType in ('MISP_Partner' ,'Auth_Partner','Credential_Partner') and t.crBy =:userId ORDER BY t.crDTime DESC")
    List<PartnerRegistration> partnerRegAuthMISPList(String userId,@Param("partnerId") List<String> partnerId);

    @Query(value = "SELECT t  from PartnerRegistration t where t.id in :partnerId and t.partnerType in ('MISP_Partner' ,'Auth_Partner','Credential_Partner') ORDER BY t.crDTime DESC")
    List<PartnerRegistration> partnerRegAuthMISPList(@Param("partnerId") List<String> partnerId);

    @Query(value = "SELECT t  from PartnerRegistration t where t.id in :partnerId and t.partnerType in ('Device_Provider' ,'FTM_Provider') and t.crBy =:userId ORDER BY t.crDTime DESC")
    List<PartnerRegistration> deviceRegAuthMISPList(String userId,@Param("partnerId") List<String> partnerId);

    @Query(value = "SELECT t  from PartnerRegistration t where t.id in :partnerId and t.partnerType in ('Device_Provider' ,'FTM_Provider') ORDER BY t.crDTime DESC")
    List<PartnerRegistration> deviceRegAuthMISPList(@Param("partnerId") List<String> partnerId);

//    @Query(nativeQuery = true,value = "SELECT *  from pms.partner t where t.partner_type_code=:type and t.id in (select r.partner_id from msppms.partner_registration_old r) ORDER BY t.cr_dtimes DESC")
//    List<PartnerRegistration> partnerRegList(String type);
//
//    @Query(nativeQuery = true,value = "SELECT *  from pms.partner t where t.partner_type_code=:type and t.id in (select r.device_id from msppms.device_model_register r) ORDER BY t.cr_dtimes DESC")
//    List<PartnerRegistration> deviceRegList(String type);

    PartnerRegistration findAllById(String partnerId);

    @Query(value = "SELECT count(t)  from PartnerRegistration t where t.email=:emailId ")
    int checkEmailId(String emailId);

    @Query(value = "SELECT count(t)  from PartnerRegistration t where t.groupId=:groupId ")
    int checkPolicyGroupId(String groupId);

    @Modifying(flushAutomatically = true)
    @Query(value = "update  PartnerRegistration u set u.crBy=:userId where u.id=:partnerId" )
    void changeUserId(String partnerId, String userId);

    @Query(value = "SELECT t from PartnerRegistration t where t.groupId=:policyGroupId and t.active=true and t.approvalStatus='approved' and t.partnerType in ('MISP_Partner','Credential_Partner')")
    List<PartnerRegistration> findAllTSPPartner(String policyGroupId);


    @Query(value = "SELECT t from PartnerRegistration t where t.groupId=:policyGroupId ")
    List<PartnerRegistration> findAllPoliciesGroupPartner(String policyGroupId);

    @Query(value = "SELECT count(t)  from PartnerRegistration t where t.id in :partnerId and t.partnerType in ('MISP_Partner' ,'Auth_Partner','Credential_Partner')")
    int getAuthPartnerCount(@Param("partnerId") List<String> partnerId);

    @Query(value = "SELECT count(t)  from PartnerRegistration t where t.id in :partnerId and  t.partnerType in ('MISP_Partner' ,'Auth_Partner','Credential_Partner') and t.crBy=:userId")
    int getAuthPartnerCount( String userId,@Param("partnerId") List<String> partnerId);

    @Query(value = "SELECT count(t)  from PartnerRegistration t where t.partnerType in ('Device_Provider' ,'FTM_Provider')")
    int getDeviceCount();

    @Query(value = "SELECT count(t)  from PartnerRegistration t where t.partnerType in ('Device_Provider' ,'FTM_Provider') and t.crBy=:userId")
    int getDeviceCount( String userId);

    @Query(value = "SELECT t  from PartnerRegistration t where t.partnerType in ('Device_Provider' ,'FTM_Provider') and t.crBy =:userId ORDER BY t.crDTime DESC")
    List<PartnerRegistration> deviceFTMRegList(String userId);

    @Query(value = "SELECT t  from PartnerRegistration t where t.partnerType in ('Device_Provider' ,'FTM_Provider') ORDER BY t.crDTime DESC")
    List<PartnerRegistration> deviceFTMRegList();
    @Query(value = "SELECT t  from PartnerRegistration t where t.partnerType=:val and t.crBy =:userId ORDER BY t.crDTime DESC")
    List<PartnerRegistration> deviceFTMRegListFilter(String userId , String val);

    @Query(value = "SELECT t  from PartnerRegistration t where t.partnerType=:val ORDER BY t.crDTime DESC")
    List<PartnerRegistration> deviceFTMRegListFilter(String val);

    @Query(value = "SELECT count(t)  from PartnerRegistration t where t.id in :partnerId and t.partnerType in ('MISP_Partner' ,'Auth_Partner','Credential_Partner') and  t.certificate is NULL  and t.crBy=:userId and  t.approvalStatus='InProgress'")
    int getUploadPendingCount(String userId, @Param("partnerId") List<String> partnerId);

    @Query(value = "SELECT count(t)  from PartnerRegistration t where t.id in :partnerId and t.partnerType in ('MISP_Partner' ,'Auth_Partner','Credential_Partner') and t.active=true and t.crBy=:userId and t.approvalStatus='approved' ")
    int getActiveCount(String userId, @Param("partnerId") List<String> partnerId);

    @Query(value = "SELECT count(t)  from PartnerRegistration t where t.id in :partnerId and t.partnerType in ('MISP_Partner' ,'Auth_Partner','Credential_Partner') and t.active=false and t.crBy=:userId and t.approvalStatus='approved'")
    int getDeActiveCount(String userId , @Param("partnerId") List<String> partnerId );

    @Query(value = "SELECT count(t)  from PartnerRegistration t where t.id in :partnerId and t.partnerType in ('MISP_Partner' ,'Auth_Partner','Credential_Partner') and  t.certificate is NULL and  t.approvalStatus='InProgress'")
    int getUploadPendingCountRole(@Param("partnerId") List<String> partnerId);

    @Query(value = "SELECT count(t)  from PartnerRegistration t where t.id in :partnerId and  t.partnerType in ('MISP_Partner' ,'Auth_Partner','Credential_Partner') and t.active=true and t.approvalStatus='approved' ")
    int getActiveCountRole(@Param("partnerId") List<String> partnerId);

    @Query(value = "SELECT count(t)  from PartnerRegistration t where t.id in :partnerId and t.partnerType in ('MISP_Partner' ,'Auth_Partner','Credential_Partner') and t.active=false  and t.approvalStatus='approved'")
    int getDeActiveCountRole(@Param("partnerId") List<String> partnerId);

    @Query(value = "SELECT count(t)  from PartnerRegistration t where t.id in :iris and t.crBy=:userId and t.active=true")
    int getIrisCount(List<String> iris,String userId);

    @Query(value = "SELECT count(t)  from PartnerRegistration t where t.id in :iris  and t.active=true")
    int getIrisCountRole(List<String> iris);

    @Query(value = "SELECT t.id  from PartnerRegistration t where t.partnerType='Device_Provider' and t.approvalStatus='approved' and t.active=true")
    List<String> getOnlyDeviceCount();

    @Query(value = "SELECT t.id  from PartnerRegistration t where t.partnerType='Device_Provider' and t.approvalStatus='approved' and t.active=true and t.crBy=:userId")
    List<String> getOnlyDeviceCount( String userId);

    @Query(nativeQuery = true, value = "select pg.name as policygrpname, pr.id, pr.name as partnername,pr.contact_no, pr.email_id,pr.approval_status  from pms.partner pr \n" +
            "inner join pms.policy_group pg\n" +
            "on pg.id = pr.policy_group_id\n" +
            "where pr.id in :partnerId order by pr.cr_dtimes desc")
    List<Object[]> suspendedPartnerList(@Param("partnerId") List<String> partnerId);
    @Query(nativeQuery = true, value = "select pg.name as policygrpname, pr.id, pr.name as partnername,pr.contact_no, pr.email_id,pr.approval_status  from pms.partner pr \n" +
            "inner join pms.policy_group pg\n" +
            "on pg.id = pr.policy_group_id\n" +
            "where pr.id in :partnerId and pr.cr_by=:userId order by pr.cr_dtimes desc")
    List<Object[]> suspendedPartnerList(@Param("partnerId") List<String> partnerId, String userId);

    @Query(nativeQuery = true, value = "select pr.id, pr.name as partnername,pr.contact_no, pr.email_id,pr.approval_status  from pms.partner pr \n" +
            "where pr.id in :partnerId order by pr.cr_dtimes desc")
    List<Object[]> noOnboardedDevice(@Param("partnerId") List<String> partnerId);

    @Query(nativeQuery = true, value = "select pr.id, pr.name as partnername,pr.contact_no, pr.email_id,pr.approval_status  from pms.partner pr \n" +
            "where pr.id in :partnerId and pr.cr_by=:userId order by pr.cr_dtimes desc")
    List<Object[]> noOnboardedDevice(@Param("partnerId") List<String> partnerId, String userId);

    @Modifying(flushAutomatically = true)
    @Query(value = "update  PartnerRegistration u set u.approvalStatus='InProgress', u.active='false' where u.id=:partnerId")
    int certificateAliasdelForRootInter(String partnerId);

    @Modifying(flushAutomatically = true)
    @Query(value = "update  PartnerRegistration u set u.approvalStatus='approved', u.active='true' where u.id=:partnerId")
    int certificateAliasUpdateForRootInter(String partnerId);

}
