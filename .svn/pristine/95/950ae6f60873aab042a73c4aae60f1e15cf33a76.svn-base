    @RequestMapping(value = "/createPolicy")
    public String createPolicy(@RequestBody String groupname) throws NoSuchAlgorithmException,
            KeyManagementException {
        logger.info("calling from RPController for createPolicy");
        System.out.println("5.enter in Policy Type ");
        turnOffSslChecking();
        APIConnection.authenticate();
        ResourceBundle bundle = APIConnection.readConfig();
        MSPPolicyType policy = new MSPPolicyType();
        mspAuditLogs.setAuditRequestDto(PartnerManageEnum.CREATE_POLICY);
        String returnVal = "";
        org.json.JSONObject jsonObject = new org.json.JSONObject(groupname);
        org.json.JSONObject template = new org.json.JSONObject(bundle.getString("template"));
//        String[] manualAuthArray = new String[]{"IRIS", "FINGER", "FACE", "otp", "demo"};
//        String[] manualEkycArray = new String[]{"maritalStatus", "gender", "residenceStatus", "dateOfBirth", "firstName",
//                "middleName", "lastName", "suffix", "bloodType", "mobileno", "email", "presentZipcode" , "fullAddress",
//                "presentCity", "presentAddressLine1", "presentProvince", "presentBarangay","presentCountry", "pobCountry", "face","photo"};
        org.json.JSONObject allowedAuthType = null;
        try {

            policy.setPolicyTypeId("xyz");
            policy.setPolicyTypeName(jsonObject.get("policyTypeName").toString());
            policy.setPolicyTypeDescription("Auth Policy");
            policy.setActive(false);
            policy.setCrDtTime(APIConnection.getUTCCurrentDateTime());
            String PolicyGroupId = mspPolicyGroupService.getPolicyGroupId(jsonObject.get("policygroupname").toString());
            policy.setPolicyGroupId(PolicyGroupId);
            policy.setRejectApprovalStatus(1);
            policy.setPolicyType(jsonObject.get("policyType").toString());

            org.json.JSONObject requestTemp = template.getJSONObject("request");
//			requestTemp.put("desc",jsonObject.get("desc"));
            requestTemp.put("desc", "Auth Policy");
            requestTemp.put("name", jsonObject.get("policyTypeName"));
            requestTemp.put("version", "1.0");
            String authType = jsonObject.get("policyType").toString();
            org.json.JSONArray authArray = new org.json.JSONArray();
            org.json.JSONArray ekycArray = new org.json.JSONArray();
            allowedAuthType = new org.json.JSONObject();
            org.json.JSONObject authPolicies = null;
            if (authType.equals("auth")) {
                org.json.JSONArray allowedAuth = new org.json.JSONArray(jsonObject.get("authPolicies").toString());
                for (int i = 0; i < allowedAuth.length(); i++) {
                    authPolicies = new org.json.JSONObject();
                    String authVar = allowedAuth.get(i).toString();
                    if (authVar.equals("IRIS") || authVar.equals("FINGER") || authVar.equals("FACE")) {
                        authPolicies.put("authSubType", allowedAuth.get(i));
                        authPolicies.put("authType", "bio");
                    } else {
                        authPolicies.put("authSubType", "");
                        authPolicies.put("authType", allowedAuth.get(i));
                    }
                    authPolicies.put("mandatory", false);
                    authArray.put(authPolicies);
                }
                authPolicies = new org.json.JSONObject();
                authPolicies.put("authSubType", "");
                authPolicies.put("authType", "otp-request");
                authPolicies.put("mandatory", false);
                authArray.put(authPolicies);
                authPolicies = new org.json.JSONObject();
                authPolicies.put("authSubType", "");
                authPolicies.put("authType", "kyc");
                authPolicies.put("mandatory", false);
                authArray.put(authPolicies);

                allowedAuthType.put("allowedAuthTypes", authArray);

                org.json.JSONArray allowedKYC = new org.json.JSONArray(jsonObject.get("allowedKycAttributes").toString());

                for (int i = 0; i < allowedKYC.length(); i++) {
                    org.json.JSONObject ekycPolicies = new org.json.JSONObject();
                    ekycPolicies.put("attributeName", allowedKYC.get(i));
                    ekycArray.put(ekycPolicies);
                }
                allowedAuthType.put("allowedKycAttributes", ekycArray);

            } else {
//                // manual entry for authentication
//                for (int i = 0; i < manualAuthArray.length; i++) {
//                    authPolicies = new org.json.JSONObject();
//                    String authVar = manualAuthArray[i];
//                    if (authVar.equals("IRIS") || authVar.equals("FINGER") || authVar.equals("FACE")) {
//                        authPolicies.put("authSubType", manualAuthArray[i]);
//                        authPolicies.put("authType", "bio");
//                    } else {
//                        authPolicies.put("authSubType", "");
//                        authPolicies.put("authType", manualAuthArray[i]);
//                    }
//                    authPolicies.put("mandatory", false);
//                    authArray.put(authPolicies);
//                }
//                authPolicies = new org.json.JSONObject();
//                authPolicies.put("authSubType", "");
//                authPolicies.put("authType", "otp-request");
//                authPolicies.put("mandatory", false);
//                authArray.put(authPolicies);
//                authPolicies = new org.json.JSONObject();
//                authPolicies.put("authSubType", "");
//                authPolicies.put("authType", "kyc");
//                authPolicies.put("mandatory", false);
//                authArray.put(authPolicies);
//                allowedAuthType.put("allowedAuthTypes", authArray);
                org.json.JSONArray allowedKYC = new org.json.JSONArray(jsonObject.get("allowedKycAttributes").toString());

                for (int i = 0; i < allowedKYC.length(); i++) {
                    org.json.JSONObject ekycPolicies = new org.json.JSONObject();
                    ekycPolicies.put("attributeName", allowedKYC.get(i));
                    ekycArray.put(ekycPolicies);
                }
                allowedAuthType.put("allowedKycAttributes", ekycArray);
                allowedAuthType.put("allowedAuthTypes", authArray);

            }
            allowedAuthType.put("authTokenType", bundle.getString("authTokenType"));
            requestTemp.put("policies", allowedAuthType);
            requestTemp.put("policyGroupName", jsonObject.get("policygroupname").toString());
            requestTemp.put("policyType", jsonObject.get("policyType").toString());
            template.put("requesttime", APIConnection.formatToISOString(APIConnection.getUTCCurrentDateTime()));
            template.put("request", requestTemp);
            policy.setFileId(allowedAuthType.toString());
//            policy.setCreatedBy((Integer) jsonObject.get("userId"));
            mspPolicyTypeService.save(policy);
        } catch (Exception e) {
            logger.error("calling from RPController for createPolicy",e.getMessage());
            e.printStackTrace();
        }
        System.out.println("6. Template to Msoip:" + template.toString());
        //         /v1/policymanager/policies

        String record = APIConnection.connectApi(bundle.getString("base.url") + bundle.getString("version") + bundle.getString("policymanager.url"),
                "POST", template.toString(), "Cookie");

        org.json.JSONObject jsoninput = new org.json.JSONObject(record);
        String responseData=(jsoninput.get("response")).toString();
        if( responseData.equals("null")) {
            returnVal="false";
            mspAuditLogs.setAuditRequestDto(PartnerManageEnum.CREATE_POLICY_GROUP_FAILURE);
            mspPolicyTypeService.deleteById("xyz");

        } else {
            mspAuditLogs.setAuditRequestDto(PartnerManageEnum.CREATE_POLICY_GROUP_SUCCESS);
            returnVal = "true";
            org.json.JSONObject jsoninput1 = new org.json.JSONObject(responseData);
            System.out.println("response data :" + jsoninput1);
            System.out.println("response value:" + jsoninput1.get("id"));
            mspPolicyTypeService.changeId( jsoninput1.get("id").toString(),"xyz");
            mspPolicyTypeService.changeUserId(jsonObject.get("userId").toString(), jsoninput1.get("id").toString());
            policyTypeService.changeUserId(jsonObject.get("userId").toString(),jsoninput1.get("id").toString());
            notificationSystem.savePolicyType(policy,jsonObject.get("userId").toString(),jsoninput1.get("id").toString());
            System.out.println("8. data saved in local pms :");
        }
        return record;
    }
    @RequestMapping(value = "/viewPolicyType")
    public ArrayList<Policies> viewPolicyType(@RequestParam String userId) throws JSONException {
        logger.info("calling mspPolicyTypeService from RPController for viewPolicyType");
        ArrayList<PolicyType> viewpolicytype = new ArrayList<PolicyType>();
//        ArrayList<PolicyType> rejectAppPolicyType = null;
        ArrayList<Policies> policList = new ArrayList<>();
        List<String> rejected = new ArrayList<>();
        List<String> approved = new ArrayList<>();
        List<String> waiting = new ArrayList<>();
        try {
            int role = userservice.getUserRole(userId);


            if(role == 1 || role == 3){

                rejected =(List<String>) mspPolicyTypeService.getRejectedPolicies();
                 approved =(List<String>) mspPolicyTypeService.getApprovedPolicies();
               waiting =(List<String>) mspPolicyTypeService.getWaitingPolicies();

            }else{
                rejected =(List<String>) mspPolicyTypeService.getRejectedPolicies(userId);
                approved =(List<String>) mspPolicyTypeService.getApprovedPolicies(userId);
               waiting =(List<String>) mspPolicyTypeService.getWaitingPolicies(userId);

            }


//            viewpolicytype = (ArrayList<PolicyType>) policyTypeService.viewListPolicyType();


            viewpolicytype = (ArrayList<PolicyType>) policyTypeService.viewListPolicyType(waiting);

            for(PolicyType val : viewpolicytype){
                Policies s = new Policies();
               s.setPolicyId(val.getId());
               s.setName(val.getName());
               s.setDescr(val.getDescr());
               s.setPolicyType(val.getPolicyType());
               LocalDateTime localDateTime = val.getValidFromDate();
                DateTimeFormatter customFormatter = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss");
                String customFormattedDateTime = localDateTime.format(customFormatter);
               s.setValidFrom(customFormattedDateTime);
                LocalDateTime toDate = val.getValidToDate();
                String toDateTime = toDate.format(customFormatter);
                s.setValidTo(toDateTime);
                s.setPolicyFileId(val.getPolicyFileId());
                s.setActive(val.isActive());
                s.setPolicyGroupId(val.getPolicyGroupId());
                s.setStatus("Waiting");
                s.setCrby(val.getCrBy());
                if(val.getCrBy() != null && !val.getCrBy().isEmpty()){
                    Userdetails userdetails = userservice.getUserDetailsByUserid(val.getCrBy());
                    if (userdetails != null) {
                        s.setUserName(userdetails.getUserName());
                        if (userdetails.getUserRole() == 1) {
                            s.setUserRole("Super Admin");
                        } else if (userdetails.getUserRole() == 2) {
                            s.setUserRole("Partner Admin");
                        } else if (userdetails.getUserRole() == 3) {
                            s.setUserRole("Policy Admin");
                        }
                    }else{
                        s.setUserName("-");
                        s.setUserRole("-");
                    }
                }
                s.setPolicyGroupName(PolicyGroupService.getPolicyGroupDetail(val.getPolicyGroupId()));


                policList.add(s);
            }
            viewpolicytype = (ArrayList<PolicyType>) policyTypeService.viewListPolicyType(approved);
            for(PolicyType val : viewpolicytype){
                Policies s = new Policies();
                s.setPolicyId(val.getId());
                s.setName(val.getName());
                s.setDescr(val.getDescr());
                s.setPolicyType(val.getPolicyType());
                LocalDateTime localDateTime = val.getValidFromDate();
                DateTimeFormatter customFormatter = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss");
                String customFormattedDateTime = localDateTime.format(customFormatter);
                s.setValidFrom(customFormattedDateTime);
                LocalDateTime toDate = val.getValidToDate();
                String toDateTime = toDate.format(customFormatter);
                s.setValidTo(toDateTime);
                s.setPolicyFileId(val.getPolicyFileId());
                s.setActive(val.isActive());
                s.setStatus("Approved");
                s.setPolicyGroupId(val.getPolicyGroupId());
                s.setCrby(val.getCrBy());
                if(val.getCrBy() != null && !val.getCrBy().isEmpty()){
                    Userdetails userdetails = userservice.getUserDetailsByUserid(val.getCrBy());
                    if (userdetails != null) {
                        s.setUserName(userdetails.getUserName());
                        if (userdetails.getUserRole() == 1) {
                            s.setUserRole("Super Admin");
                        } else if (userdetails.getUserRole() == 2) {
                            s.setUserRole("Partner Admin");
                        } else if (userdetails.getUserRole() == 3) {
                            s.setUserRole("Policy Admin");
                        }
                    }else{
                        s.setUserName("-");
                        s.setUserRole("-");
                    }
                }
                s.setPolicyGroupName(PolicyGroupService.getPolicyGroupDetail(val.getPolicyGroupId()));
                policList.add(s);
            }
            viewpolicytype = (ArrayList<PolicyType>) policyTypeService.viewListPolicyType(rejected);
            for(PolicyType val : viewpolicytype){
                Policies s = new Policies();
                s.setPolicyId(val.getId());
                s.setName(val.getName());
                s.setDescr(val.getDescr());
                s.setPolicyType(val.getPolicyType());
                LocalDateTime localDateTime = val.getValidFromDate();
                DateTimeFormatter customFormatter = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss");
                String customFormattedDateTime = localDateTime.format(customFormatter);
                s.setValidFrom(customFormattedDateTime);
                LocalDateTime toDate = val.getValidToDate();
                String toDateTime = toDate.format(customFormatter);
                s.setValidTo(toDateTime);
                s.setPolicyFileId(val.getPolicyFileId());
                s.setActive(val.isActive());
                s.setStatus("Rejected");
                s.setPolicyGroupId(val.getPolicyGroupId());
                s.setCrby(val.getCrBy());
                if(val.getCrBy() != null && !val.getCrBy().isEmpty()){
                    Userdetails userdetails = userservice.getUserDetailsByUserid(val.getCrBy());
                    if (userdetails != null) {
                        s.setUserName(userdetails.getUserName());
                        if (userdetails.getUserRole() == 1) {
                            s.setUserRole("Super Admin");
                        } else if (userdetails.getUserRole() == 2) {
                            s.setUserRole("Partner Admin");
                        } else if (userdetails.getUserRole() == 3) {
                            s.setUserRole("Policy Admin");
                        }
                    }else{
                        s.setUserName("-");
                        s.setUserRole("-");
                    }
                }
                s.setPolicyGroupName(PolicyGroupService.getPolicyGroupDetail(val.getPolicyGroupId()));
                policList.add(s);
            }


//            for(PolicyType val : rejectAppPolicyType){
//                PolicyType  s = new PolicyType();
//                s.setActive("false");
//
//            }
            System.out.println("testing" + viewpolicytype);

        } catch (Exception e) {
            logger.error("calling mspPolicyTypeService from RPController for viewPolicyType",e.getMessage());
            e.printStackTrace();
        }
        return policList;
    }
    @RequestMapping(value = "/filterPolicy")
    public ArrayList<Policies> filterPolicy(@RequestParam String userId,@RequestParam String filterVal) throws JSONException {
        logger.info("calling mspPolicyTypeService from RPController for viewPolicyType");
        ArrayList<PolicyType> viewpolicytype = new ArrayList<PolicyType>();
//        ArrayList<PolicyType> rejectAppPolicyType = null;
        ArrayList<Policies> policList = new ArrayList<>();
        List<String> rejected = new ArrayList<>();
        List<String> approved = new ArrayList<>();
        List<String> waiting = new ArrayList<>();
        try {
            int role = userservice.getUserRole(userId);

            if(role == 1 || role == 3){
                rejected =(List<String>) mspPolicyTypeService.getRejectedPolicies();
                 approved =(List<String>) mspPolicyTypeService.getApprovedPolicies();
               waiting =(List<String>) mspPolicyTypeService.getWaitingPolicies();

            }else{
                rejected =(List<String>) mspPolicyTypeService.getRejectedPolicies(userId);
                 approved =(List<String>) mspPolicyTypeService.getApprovedPolicies(userId);
               waiting =(List<String>) mspPolicyTypeService.getWaitingPolicies(userId);
            }


          if(filterVal.equals("Waiting")) {
              viewpolicytype = (ArrayList<PolicyType>) policyTypeService.viewListPolicyType(waiting);

              for (PolicyType val : viewpolicytype) {
                  Policies s = new Policies();
                  s.setPolicyId(val.getId());
                  s.setName(val.getName());
                  s.setDescr(val.getDescr());
                  s.setPolicyType(val.getPolicyType());
                  LocalDateTime localDateTime = val.getValidFromDate();
                  DateTimeFormatter customFormatter = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss");
                  String customFormattedDateTime = localDateTime.format(customFormatter);
                  s.setValidFrom(customFormattedDateTime);
                  LocalDateTime toDate = val.getValidToDate();
                  String toDateTime = toDate.format(customFormatter);
                  s.setValidTo(toDateTime);
                  s.setPolicyFileId(val.getPolicyFileId());
                  s.setActive(val.isActive());
                  s.setPolicyGroupId(val.getPolicyGroupId());
                  s.setStatus("Waiting");
                  if(val.getCrBy() != null && !val.getCrBy().isEmpty()){
                      Userdetails userdetails = userservice.getUserDetailsByUserid(val.getCrBy());
                      if (userdetails != null) {
                          s.setUserName(userdetails.getUserName());
                          if (userdetails.getUserRole() == 1) {
                              s.setUserRole("Super Admin");
                          } else if (userdetails.getUserRole() == 2) {
                              s.setUserRole("Partner Admin");
                          } else if (userdetails.getUserRole() == 3) {
                              s.setUserRole("Policy Admin");
                          }
                      }else{
                          s.setUserName("-");
                          s.setUserRole("-");
                      }

                  }
                  s.setPolicyGroupName(PolicyGroupService.getPolicyGroupDetail(val.getPolicyGroupId()));
                  policList.add(s);
              }
          }else if(filterVal.equals("Approved")) {
              viewpolicytype = (ArrayList<PolicyType>) policyTypeService.viewListPolicyType(approved);
              for (PolicyType val : viewpolicytype) {
                  Policies s = new Policies();
                  s.setPolicyId(val.getId());
                  s.setName(val.getName());
                  s.setDescr(val.getDescr());
                  s.setPolicyType(val.getPolicyType());
                  LocalDateTime localDateTime = val.getValidFromDate();
                  DateTimeFormatter customFormatter = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss");
                  String customFormattedDateTime = localDateTime.format(customFormatter);
                  s.setValidFrom(customFormattedDateTime);
                  LocalDateTime toDate = val.getValidToDate();
                  String toDateTime = toDate.format(customFormatter);
                  s.setValidTo(toDateTime);
                  s.setPolicyFileId(val.getPolicyFileId());
                  s.setActive(val.isActive());
                  s.setPolicyGroupId(val.getPolicyGroupId());
                  s.setStatus("Approved");
                  if(val.getCrBy() != null && !val.getCrBy().isEmpty()){
                      Userdetails userdetails = userservice.getUserDetailsByUserid(val.getCrBy());
                      if (userdetails != null) {
                          s.setUserName(userdetails.getUserName());
                          if (userdetails.getUserRole() == 1) {
                              s.setUserRole("Super Admin");
                          } else if (userdetails.getUserRole() == 2) {
                              s.setUserRole("Partner Admin");
                          } else if (userdetails.getUserRole() == 3) {
                              s.setUserRole("Policy Admin");
                          }
                      }else{
                          s.setUserName("-");
                          s.setUserRole("-");
                      }
                  }
                  s.setPolicyGroupName(PolicyGroupService.getPolicyGroupDetail(val.getPolicyGroupId()));
                  policList.add(s);
              }
          }else if(filterVal.equals("Rejected")) {
              viewpolicytype = (ArrayList<PolicyType>) policyTypeService.viewListPolicyType(rejected);
              for (PolicyType val : viewpolicytype) {
                  Policies s = new Policies();
                  s.setPolicyId(val.getId());
                  s.setName(val.getName());
                  s.setDescr(val.getDescr());
                  s.setPolicyType(val.getPolicyType());
                  LocalDateTime localDateTime = val.getValidFromDate();
                  DateTimeFormatter customFormatter = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss");
                  String customFormattedDateTime = localDateTime.format(customFormatter);
                  s.setValidFrom(customFormattedDateTime);
                  LocalDateTime toDate = val.getValidToDate();
                  String toDateTime = toDate.format(customFormatter);
                  s.setValidTo(toDateTime);
                  s.setPolicyFileId(val.getPolicyFileId());
                  s.setActive(val.isActive());
                  s.setPolicyGroupId(val.getPolicyGroupId());
                  s.setStatus("Rejected");
                  if(val.getCrBy() != null && !val.getCrBy().isEmpty()){
                      Userdetails userdetails = userservice.getUserDetailsByUserid(val.getCrBy());
                      if (userdetails != null) {
                          s.setUserName(userdetails.getUserName());
                          if (userdetails.getUserRole() == 1) {
                              s.setUserRole("Super Admin");
                          } else if (userdetails.getUserRole() == 2) {
                              s.setUserRole("Partner Admin");
                          } else if (userdetails.getUserRole() == 3) {
                              s.setUserRole("Policy Admin");
                          }
                      }else{
                          s.setUserName("-");
                          s.setUserRole("-");
                      }
                  }
                  s.setPolicyGroupName(PolicyGroupService.getPolicyGroupDetail(val.getPolicyGroupId()));
                  policList.add(s);
              }
          }

//            for(PolicyType val : rejectAppPolicyType){
//                PolicyType  s = new PolicyType();
//                s.setActive("false");
//
//            }
            System.out.println("testing" + viewpolicytype);

        } catch (Exception e) {
            logger.error("calling mspPolicyTypeService from RPController for viewPolicyType",e.getMessage());
            e.printStackTrace();
        }
        return policList;
    }

    @RequestMapping(value = "/getPolicyGroupType")
    public ArrayList<PolicyGroupTypeBean> getPolicyGroupType(@RequestBody String active) throws JSONException {
        logger.info("calling mspPolicyTypeService  from RPController for getPolicyGroupType");

        ArrayList<MSPPolicyType> regpartner = null;

        ArrayList<PolicyGroupTypeBean> trnBean = new ArrayList<PolicyGroupTypeBean>();
        boolean status = false;
        if (active.equals("true")) {
            status = true;
        } else {
            status = false;
        }
        try {
//            List<Object[]> list = policyTypeService.getPolicyGroupType(status);
            List<Object[]> list = mspPolicyTypeService.getPolicyGroupType(status);
            for (Object[] report1 : list) {
                PolicyGroupTypeBean bean = new PolicyGroupTypeBean();
                bean.setPolicyTypeId((String) report1[0]);
                bean.setPolicyGroupId((String) report1[1]);
                bean.setPolicyTypeName((String) report1[2]);
                bean.setTypeSelected((String) report1[3]);
                bean.setStatus((boolean) report1[4]);
                bean.setPolicyGroupName((String) report1[5]);
                trnBean.add(bean);
            }
        } catch (Exception e) {
            logger.error("calling  mspPolicyTypeService from RPController for getPolicyGroupType",e.getMessage());
            e.printStackTrace();
        }
        return trnBean;
    }
    @RequestMapping(value = "/getApprovalRejectList")
    public ArrayList<PolicyGroupTypeBean> getApprovalRejectList(@RequestBody String active) throws JSONException {
        logger.info("calling mspPolicyTypeService  from RPController for getPolicyGroupType");

        ArrayList<MSPPolicyType> regpartner = null;

        ArrayList<PolicyGroupTypeBean> trnBean = new ArrayList<PolicyGroupTypeBean>();
        boolean status = false;
        if (active.equals("true")) {
            status = true;
        } else {
            status = false;
        }
        try {
            List<Object[]> list = policyTypeService.getPolicyGroupType(status);
//            List<Object[]> list = mspPolicyTypeService.getPolicyGroupType(status);
            for (Object[] report1 : list) {
                PolicyGroupTypeBean bean = new PolicyGroupTypeBean();
                bean.setPolicyTypeId((String) report1[0]);
                bean.setPolicyGroupId((String) report1[1]);
                bean.setPolicyTypeName((String) report1[2]);
                bean.setTypeSelected((String) report1[3]);
                bean.setStatus((boolean) report1[4]);
                bean.setPolicyGroupName((String) report1[5]);
                trnBean.add(bean);
            }
        } catch (Exception e) {
            logger.error("calling  mspPolicyTypeService from RPController for getPolicyGroupType",e.getMessage());
            e.printStackTrace();
        }
        return trnBean;
    }
    @RequestMapping("/publish")
    public String publishPolicy(@RequestBody String policy) throws JsonParseException, JsonMappingException, JsonProcessingException, IOException, NoSuchAlgorithmException, KeyManagementException {
        logger.info("calling from Admin Approval Controller publish");
        System.out.println("1.enter into publish policy ");
        turnOffSslChecking();
        APIConnection.authenticate();
        ResourceBundle bundle = APIConnection.readConfig();
        JSONObject jsonObject = new JSONObject(policy);
        mspAuditLogs.setAuditRequestDto(PartnerManageEnum.PUBLISH_POLICY);
        String   returnVal = "false";
        //         /v1/policymanager/policies/"+policy_Id+"/group/"+policyGroup_Id+"/publish"
        String record = APIConnection.connectApi(bundle.getString("base.url")+bundle.getString("version")+bundle.getString("policymanager.url")+
                "/"+jsonObject.get("policyId")+"/group/"+jsonObject.get("policygroupId")+"/publish","POST","","Cookie");
        System.out.println("3. output from Mosip -publish :"+ record);
        org.json.JSONObject jsoninput = new org.json.JSONObject(record);
        String responseData=(jsoninput.get("response")).toString();
        System.out.println("response "+responseData);
        if( responseData.equals("null")) {
            returnVal = "false";
            mspAuditLogs.setAuditRequestDto(PartnerManageEnum.CREATE_POLICY_FAILURE);
        } else{
            returnVal = "true";
            mspAuditLogs.setAuditRequestDto(PartnerManageEnum.CREATE_POLICY_SUCCESS);
            int activatePoilcy = mspPolicyTypeService.activatePolicy(true,jsonObject.get("policyId").toString(),jsonObject.get("policygroupId").toString());

            System.out.println("4. data sav ed in local pms -publish :");
        }
        return returnVal;
    }
    @RequestMapping("/rejectPolicy")
    public String rejectPolicy(@RequestBody String policy) throws JsonParseException, JsonMappingException, JsonProcessingException, IOException, NoSuchAlgorithmException, KeyManagementException {
        logger.info("calling from Admin Approval Controller publish");
        String returnVal="false";
        JSONObject jsonObject = new JSONObject(policy);
//        mspAuditLogs.setAuditRequestDto(PartnerManageEnum.PUBLISH_POLICY);
//            mspAuditLogs.setAuditRequestDto(PartnerManageEnum.CREATE_POLICY_SUCCESS);
            int activatePoilcy = mspPolicyTypeService.rejectPolicy(jsonObject.get("policyId").toString(),jsonObject.get("policygroupId").toString(),jsonObject.get("reason").toString());
             if(activatePoilcy >= 1){
                returnVal = "true";
            }else{
                returnVal = "false";
            }
            System.out.println("4. data saved in local pms -publish :");

        return returnVal;
    }
    @RequestMapping("/deletePolicyType")
    public String deletePolicyType(@RequestBody String id){
        String returnVal="";
        try{
            int count = partnerPolicyService.checkPolicyId(id);
            if(count >= 1)
            {
                returnVal=" Policy Type linked to Partner/API";
            }else{
                mspPolicyTypeService.deleteById(id);
                policyTypeService.deleteById(id);
                returnVal = "Policy Deleted Successfully";
            }


        }catch (Exception e){
            e.printStackTrace();
            returnVal = "Policy Deleted Failed";
        }
        return returnVal;
    }

    public static void turnOffSslChecking() throws NoSuchAlgorithmException, KeyManagementException {
        // Install the all-trusting trust manager
        final SSLContext sc = SSLContext.getInstance("SSL");
        sc.init(null, UNQUESTIONING_TRUST_MANAGER, null);
        HttpsURLConnection.setDefaultSSLSocketFactory(sc.getSocketFactory());
        // Create all-trusting host name verifier
        HostnameVerifier allHostsValid = new HostnameVerifier() {
            public boolean verify(String hostname, SSLSession session) {
                return true;
            }
        };
        // Install the all-trusting host verifier
        HttpsURLConnection.setDefaultHostnameVerifier(allHostsValid);
    }

}
