    @RequestMapping("/getPartnerTypeByCode")
    public partner getPartnerTypeByCode(@RequestBody String partnerType){
        partner mosipPartner = new partner();
        try{
             mosipPartner = partVal.getPartnerTypeByCode(partnerType);

        }catch(Exception e){
            e.printStackTrace();
        }
        return mosipPartner;
    }
    @RequestMapping("/updatePartnerReasonList")
    public String updatePartnerBlacklisted(@RequestBody MspPartnerRegSuspension reason){
        String returnVal = "";
        boolean status;
        try{
            MspPartnerRegSuspension  partReasonList = mspRegPartSuspension.getReason(reason.getSno());
           status = mspRegPartSuspension.updateList(reason , partReasonList.getReason());
            if(status){

                returnVal ="Partner "+ reason.getPerformedby() +" Updated Successfully";
            }else{
                returnVal ="Partner "+ reason.getPerformedby() +" Update Failed";
            }

        }catch(Exception e){
            e.printStackTrace();
        }
        return returnVal;
    }

    @RequestMapping("/updateDeviceReasonList")
    public String updateDeviceReasonList(@RequestBody MspDeviceStatus reason){
        String returnVal = "";
        boolean status;
        try{
            MspDeviceStatus  partReasonList = mspRegDeviceStatusService.getReason(reason.getSno());
            status = mspRegDeviceStatusService.updateList(reason , partReasonList.getReason());
            if(status){

                returnVal ="Device "+ reason.getPerformedby() +" Updated Successfully";
            }else{
                returnVal ="Device "+ reason.getPerformedby() +" Update Failed";
            }

        }catch(Exception e){
            e.printStackTrace();
        }
        return returnVal;
    }

