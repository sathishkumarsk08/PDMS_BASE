    @RequestMapping("/updatePolicygroup")
    public String updatePolicygroup(@RequestBody String policyGroup){
        org.json.JSONObject jsonObject = new org.json.JSONObject(policyGroup);
        PolicyGroup mosipPartner = new PolicyGroup();
        PolicyGroupPms mspPolicy = new PolicyGroupPms();
   
        String returnVal= "false";
        boolean status;
        boolean mspStatus;
        int updateVal;
        if(jsonObject.get("status").toString().equals("true")){
            status = true;
        }else{
            status = false;
        }
        mosipPartner.setName(jsonObject.get("policyGroupName").toString());
        mosipPartner.setDescr(jsonObject.get("policyGroupDescription").toString());
        mosipPartner.setActive(status);
        mosipPartner.setUpdBy(jsonObject.get("userId").toString());


        mspPolicy.setName(jsonObject.get("policyGroupName").toString());
        mspPolicy.setDescr(jsonObject.get("policyGroupDescription").toString());
        mspPolicy.setStatus(jsonObject.get("status").toString());
        mspPolicy.setUpdBy(jsonObject.get("userId").toString());

        try{
            
//            updateVal = mosipGroupService.getPolicyGroupDetails(jsonObject.get("policyGroupName").toString(),jsonObject.get("policyGroupDescription").toString(),status);
//            if(updateVal == 0){
                status = mosipGroupService.updateMOSIPPolicyGroup(mosipPartner,jsonObject.get("id").toString());
                if(status){
                    mspStatus = mspPolicyGroupService.updateMSPPolicyGroup(mspPolicy,jsonObject.get("id").toString());
                    if(mspStatus){
                      
//                        returnVal ="Policy Group Updated Successfully";
                        returnVal ="true";
                    }

                }else{
                 
//                    returnVal ="Policy Group Update Failed";
                    returnVal ="false";

                }
         
//            }else{
//                returnVal =" Policy Group Exists";
//            }

        }catch(Exception e){
            e.printStackTrace();
      
//            returnVal =" Policy Group Update Failed";
            returnVal ="false";
        }

        return returnVal;
    }
    @RequestMapping("/updateUserCreation")
    public String updateUserCreation(@RequestBody Userdetails user){

        String returnVal= "";
        boolean status;
        boolean mspStatus;
        int updateVal;

        try{
            updateVal = userdetailsService.getUserDetails(user.getEmail(),user.getPassword(),user.getUserid());
            if(updateVal == 0){
                String password = user.getPassword();
                String encpassword = new MacAddress().md5Encode(password.getBytes());
                Userdetails s= new Userdetails();
                s.setUserName(user.getUserName());
                s.setFirstnameEn(user.getFirstnameEn());
                s.setEmail(user.getEmail());
                s.setLastnameEn(user.getLastnameEn());
                s.setMiddleName(user.getMiddleName());
                s.setMobileNumber(user.getMobileNumber());
                s.setUserRole(user.getUserRole());
                s.setDesignation(user.getDesignation());
                s.setVerifycodePwd(user.getPassword());
                s.setPassword(encpassword);
                s.setPcnnumber(user.getPcnnumber());
                String strOrg = user.getOrgfile();
                String strPcn = user.getPcnfile();
                if (strOrg != null && !strOrg.isEmpty()) {
                    s.setOrgfile(strOrg);
                }   if (strPcn != null && !strPcn.isEmpty()) {
                    s.setPcnfile(strPcn);
                }

                status = userdetailsService.updateUserCreation(s,user.getUserid());
                if(status){
                        returnVal ="true";

                }else{
                    returnVal ="false";
                }
            }else{
                returnVal ="false";
            }

        }catch(Exception e){
            e.printStackTrace();
            returnVal ="false";
        }

        return returnVal;
    }


    @RequestMapping("/updatePolicyType")
    public String updatePolicyType(@RequestBody String policyType){
        org.json.JSONObject jsonObject = new org.json.JSONObject(policyType);
        System.out.println("value testing:" +jsonObject);
        PolicyType mosipPolicy = new PolicyType();
        MSPPolicyType mspPolicy = new MSPPolicyType();
        ResourceBundle bundle = APIConnection.readConfig();
      
        String returnVal= "false";
        boolean status;
        boolean mspStatus;
        int updateVal;
//        if(jsonObject.get("status").toString().equals("true")){
//            status = true;
//        }else{
//            status = false;
//        }
        org.json.JSONObject allowedAuthType = null;
        try{
            org.json.JSONArray authArray = new org.json.JSONArray();
            org.json.JSONArray ekycArray = new org.json.JSONArray();
            allowedAuthType = new org.json.JSONObject();
            org.json.JSONObject authPolicies = null;
            String PolicyGroupId = mspPolicyGroupService.getPolicyGroupId(jsonObject.get("policygroupname").toString());

            String moispPolicyGroupId = mosipGroupService.getPolicyGroupId(jsonObject.get("policygroupname").toString());
            org.json.JSONArray allowedAuth = new org.json.JSONArray(jsonObject.get("authPolicies").toString());
            for (int i = 0; i < allowedAuth.length(); i++) {
                authPolicies = new org.json.JSONObject();
                String authVar = allowedAuth.get(i).toString();
                if (authVar.equals("IRIS") || authVar.equals("FINGER") || authVar.equals("FACE")) {
                    authPolicies.put("authSubType", allowedAuth.get(i));
                    authPolicies.put("authType", "bio");
                } else {
                    authPolicies.put("authSubType", "");
                    authPolicies.put("authType", allowedAuth.get(i));
                }
                authPolicies.put("mandatory", false);
                authArray.put(authPolicies);
            }
            authPolicies = new org.json.JSONObject();
            authPolicies.put("authSubType", "");
            authPolicies.put("authType", "otp-request");
            authPolicies.put("mandatory", false);
            authArray.put(authPolicies);
            authPolicies = new org.json.JSONObject();
            authPolicies.put("authSubType", "");
            authPolicies.put("authType", "kyc");
            authPolicies.put("mandatory", false);
            authArray.put(authPolicies);

            allowedAuthType.put("allowedAuthTypes", authArray);
            org.json.JSONArray allowedKYC = new org.json.JSONArray(jsonObject.get("allowedKycAttributes").toString());

            for (int i = 0; i < allowedKYC.length(); i++) {
                org.json.JSONObject ekycPolicies = new org.json.JSONObject();
                ekycPolicies.put("attributeName", allowedKYC.get(i));
                ekycArray.put(ekycPolicies);
            }
            allowedAuthType.put("allowedKycAttributes", ekycArray);

            allowedAuthType.put("authTokenType", bundle.getString("authTokenType"));
//            requestTemp.put("policies", allowedAuthType);

            //MOSIP POLICY TYPE TABLE
            mosipPolicy.setPolicyGroupId(moispPolicyGroupId);
            mosipPolicy.setPolicyType(jsonObject.get("policyType").toString());
            mosipPolicy.setName(jsonObject.get("policyTypeName").toString());
            mosipPolicy.setActive(false);
//            if (jsonObject.get("status").toString().equals("Active")) {
//                mosipPolicy.setActive(true);
//            } else {
//                mosipPolicy.setActive(false);
//            }
                mosipPolicy.setPolicyFileId(allowedAuthType.toString());
                status = policyTypeService.updateMOSIPPolicyType(mosipPolicy,jsonObject.get("id").toString());
                if(status){
                    //MSP POLICY TYPE TABLE
                    mspPolicy.setPolicyGroupId(PolicyGroupId);
                    mspPolicy.setPolicyType(jsonObject.get("policyType").toString());
                    mspPolicy.setPolicyTypeName(jsonObject.get("policyTypeName").toString());
                    mspPolicy.setActive(false);
                    mspPolicy.setFileId(allowedAuthType.toString());
                    mspStatus = mspPolicyTypeService.updateMSPPolicyType(mspPolicy,jsonObject.get("id").toString());
                    if(mspStatus){
                      
                        returnVal ="true";
                    }

                }else{
                  
                    returnVal ="false";
                }


        }catch(Exception e){
            e.printStackTrace();
          
            returnVal ="false";
        }

        return returnVal;
    }

    @RequestMapping("/updatePartnerRegistration")
 
    public String updatePartnerRegistration(@RequestBody String partnerRegistration) {
        org.json.JSONObject jsonObject = new org.json.JSONObject(partnerRegistration);
        PartnerRegistration mosipPartner = new PartnerRegistration();
        MSPPartnerRegistration mspPolicy = new MSPPartnerRegistration();
     
        String returnVal= "false";
        boolean status;
        boolean mspStatus;
        int updateVal;

        mosipPartner.setAddress(jsonObject.get("address").toString());
        mosipPartner.setContact(jsonObject.get("contactNumber").toString());  
        
        mspPolicy.setAuthenticationRepName(jsonObject.get("address").toString());
        mspPolicy.setMobileNumber(jsonObject.get("contactNumber").toString());
        mspPolicy.setOtherDocument(jsonObject.get("otherDocum").toString());
        mspPolicy.setNonDisclosureAgreement(jsonObject.get("disclosure").toString());
        mspPolicy.setSelfAssessment(jsonObject.get("selfAssessment").toString());
        mspPolicy.setPsaApproval(jsonObject.get("psaApproval").toString());

        try{
                status = partnerRegistrationService.updateMOSIPPartnerRegistration(mosipPartner,jsonObject.get("partnerId").toString());
                if(status){
                    mspStatus = mspPartnerRegistratioService.updateMSPPartnerRegistration(mspPolicy,jsonObject.get("partnerId").toString());
                    if(mspStatus){
                   
                        returnVal ="true";
                    }

                }else{
               
                    returnVal ="false";
                }


        }catch(Exception e){
            e.printStackTrace();
           
            returnVal ="false";
        }

        return returnVal;
    }

    @RequestMapping("/updateDevicepartner")
    public String updateDevicepartner(@RequestBody String partnerRegistration){
        org.json.JSONObject jsonObject = new org.json.JSONObject(partnerRegistration);
        PartnerRegistration mosipDevice = new PartnerRegistration();
        MSPDeviceModelRegistration mspDevice = new MSPDeviceModelRegistration();
        String returnVal= "";
        boolean status;
        boolean mspStatus;
        int updateVal;

        mosipDevice.setAddress(jsonObject.get("address").toString());
        mosipDevice.setContact(jsonObject.get("contactNumber").toString());

        mspDevice.setAddress(jsonObject.get("address").toString());
        mspDevice.setMobilenumber(jsonObject.get("contactNumber").toString());
        mspDevice.setDeviceType(jsonObject.get("devicetype").toString());
        mspDevice.setDeviceModel(jsonObject.get("devicemodel").toString());
        mspDevice.setBrandName(jsonObject.get("brandname").toString());

//        mspDevice.setMobileNumber(jsonObject.get("contactNumber").toString());/**/

        try{

            status = partnerRegistrationService.updateMOSIPPartnerRegistration(mosipDevice,jsonObject.get("deviceId").toString());
            if(status){
                mspStatus = mspDeviceRegistratioService.updateMSPPartnerRegistration(mspDevice,jsonObject.get("deviceId").toString());
                if(mspStatus){
                    returnVal ="Partner Registration Updated Successfully";
                }

            }else{
                returnVal =" Partner Registration Update Failed";
            }


        }catch(Exception e){
            e.printStackTrace();
            returnVal =" Partner Registration Update Failed";
        }

        return returnVal;
    }

    @RequestMapping(value = "/saveBasicDocument")
    public String  updateBasicDocument(@RequestBody  String partnerRegistration ) {
        org.json.JSONObject jsonObject = new org.json.JSONObject(partnerRegistration);
        System.out.println("basic document:"+jsonObject);

        MSPPartnerRegistration mspPolicy = new MSPPartnerRegistration();
   
        String returnVal= "false";
        boolean status;
        boolean mspStatus;
        int updateVal;


        mspPolicy.setOtherDocument(jsonObject.get("otherDocum").toString());
        mspPolicy.setNonDisclosureAgreement(jsonObject.get("disclosure").toString());
        mspPolicy.setSelfAssessment(jsonObject.get("selfAssessment").toString());
        mspPolicy.setPsaApproval(jsonObject.get("psaApproval").toString());


        try{
                mspStatus = mspPartnerRegistratioService.updateBasicDocumentMSPPartnerRegistration(mspPolicy,jsonObject.get("partnerId").toString());
                if(mspStatus){
                  
                    returnVal ="true";
                }
            else{
      
                returnVal ="false";
            }


        }catch(Exception e){
            e.printStackTrace();
       
            returnVal ="false";
        }

        return returnVal;
    }

