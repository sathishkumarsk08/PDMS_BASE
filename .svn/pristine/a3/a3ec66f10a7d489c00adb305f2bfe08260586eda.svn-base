package com.msp.service.msp_pms;

import com.msp.pms.msppmsmodel.DeviceRevoked;
import com.msp.pms.msppmsrepository.MSPDeviceRevokeRepository;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.beans.factory.annotation.Qualifier;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

@Service
@Qualifier("mspPmsTransactionManager")
@Transactional("mspPmsTransactionManager")
public class MSPDeviceRevokeService {

    @Autowired
    private MSPDeviceRevokeRepository mspDeviceRevokeRepository;


    public boolean save(DeviceRevoked policy) {
        boolean out = true;
        try {
            mspDeviceRevokeRepository.save(policy);
        } catch (Exception e) {
            e.printStackTrace();
            out = false;
        }

        return out;

    }
}
