package com.msp.pms.msppmsmodel;

import javax.persistence.*;
import java.time.LocalDateTime;
@Entity
@Table(name = "policy_type" ,schema ="msppms")
public class MSPPolicyType implements java.io.Serializable{

        private boolean isDeleted;
        private LocalDateTime delDateTime;
        private String policyGroupId;
        private String policyTypeId;
        private String policyTypeName;
        private String policyTypeDescription;
        private String fileId;
        private String policyType;
        private String policySchema;
        private LocalDateTime validtodate;
        private boolean isActive;
        private Integer updatedBy;
        private LocalDateTime upDtTime;
        private String  createdBy;
        private  LocalDateTime crDtTime;
        private Integer sno;
        private int flag;
        private int rejectApprovalStatus;
        private String  reason;
        private String  rejectApprovalBy;

    @Column(name = "rej_app_by")
    public String getRejectApprovalBy() {
        return rejectApprovalBy;
    }

    public void setRejectApprovalBy(String rejectApprovalBy) {
        this.rejectApprovalBy = rejectApprovalBy;
    }

    @Column(name = "reason")

    public String getReason() {
        return reason;
    }

    public void setReason(String reason) {
        this.reason = reason;
    }
    @Column(name = "rej_app_status")
    public int getRejectApprovalStatus() {
        return rejectApprovalStatus;
    }

    public void setRejectApprovalStatus(int rejectApprovalStatus) {
        this.rejectApprovalStatus = rejectApprovalStatus;
    }

    @Column(name = "notifi_flag")

    public int getFlag() {
        return flag;
    }

    public void setFlag(int flag) {
        this.flag = flag;
    }

    //        private PolicyGroupPms policyGroup;

    @Column(name = "policy_group_id")
    public String getPolicyGroupId() {
        return policyGroupId;
    }

    public void setPolicyGroupId(String policyGroupId) {
        this.policyGroupId = policyGroupId;
    }


