        List<Object[]> report;
        if(jsonObject.get("mode").toString().equals("approved")){
            report = partnerRegistrationService.noOnboardedDevice(jsonObject.get("mode").toString(),startDateTime,endDateTime,"Device_Provider");
        } else if (jsonObject.get("mode").toString().equals("suspended")) {
            report = deviceModelRegistrationMSPService.suspendedDeviceList(jsonObject.get("mode").toString(), startDateTime, endDateTime);
        } else if (jsonObject.get("mode").toString().equals("backlist")) {
            report = deviceModelRegistrationMSPService.backlistDeviceList(jsonObject.get("mode").toString(), startDateTime, endDateTime);
        } else {
            report = deviceModelRegistrationMSPService.revokeDeviceList(jsonObject.get("mode").toString(), startDateTime, endDateTime);
        }
//
//
//        for(MSPDeviceModelRegistration val : report) {
//            ReportLogBean bean= new ReportLogBean();
//            bean.setPartnerId(val.getId());
//            bean.setOrganisation(val.getName());
//            bean.setMobile(val.getMobilenumber());
//            bean.setEmail(val.getEmail());
//            bean.setStatus(val.getStatus());
//            rptBean.add(bean);
//        }

        for(Object[] val : report){
            ReportLogBean bean= new ReportLogBean();
            bean.setPartnerId(val[0].toString());
            bean.setOrganisation(val[1].toString());
            bean.setMobile(val[2].toString());
            bean.setEmail(val[3].toString());
            bean.setStatus(val[4].toString());
            rptBean.add(bean);
        }

        return rptBean;
    }

    @RequestMapping("/noOnboardApiLicenseKey")
    public  ArrayList<ReportLogBean> noOnboardApiLicenseKey(@RequestBody String reports){
        logger.info("calling  mspPartnerPolicyService from ReportsController for noOnboardDeviceList");
        org.json.JSONObject jsonObject = new org.json.JSONObject(reports);
        DateTimeFormatter formatter1 = DateTimeFormatter.ofPattern("dd-MM-yyyy");
        ArrayList<ReportLogBean> rptBean = new ArrayList<ReportLogBean>();
        String startDate = jsonObject.get("strtDate").toString();
        System.out.println("strtDate" + startDate);

        DateTimeFormatter formatter = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss");
        LocalDateTime startDateTime = LocalDateTime.parse(startDate + " 00:00:00", formatter);
        String endDate = jsonObject.get("endDate").toString();
        System.out.println("strtDate" + endDate);
        System.out.println(startDateTime);
        LocalDateTime endDateTime = LocalDateTime.parse(endDate + " 23:59:59", formatter);
        System.out.println(endDateTime);
        if(jsonObject.get("mode").toString().equals("API"))        {
            System.out.println("enter into" +jsonObject.get("mode").toString());
//            List<MSPPartnerPolicy> report =   mspPartnerPolicyService.getOnboardedApi(startDateTime ,endDateTime );
            List<PartnerPolicy> report =   partnerPolicyService.getOnboardedApi(startDateTime ,endDateTime );

//        List<MSPDeviceModelRegistration> report = deviceModelRegistrationMSPService.noOnboardedDevice(jsonObject.get("mode").toString(),startDateTime,endDateTime);
        for(PartnerPolicy val : report){
            ReportLogBean bean= new ReportLogBean();
            bean.setPartnerId(val.getPartId());
            bean.setApi_license(val.getId());
            LocalDateTime validFrom = val.getValidFrom();

            String dateValidFrom = validFrom.format(formatter1);

            bean.setValidFrom(dateValidFrom);
            LocalDateTime validTo = val.getValidTo();
            String dateValidTo = validTo.format(formatter1);

            bean.setValidTo(dateValidTo);
            bean.setActiveStatus(val.isActive());
            rptBean.add(bean);
        }
        }else{
//            List<MSPMosipLicense> report =   mspMsipLicenseService.getOnboardedLicense(startDateTime ,endDateTime );
            List<MispLicenseKey> report =   mispLicenseKeyService.getOnboardedLicense(startDateTime ,endDateTime );
            for(MispLicenseKey val : report){
                ReportLogBean bean= new ReportLogBean();
                bean.setPartnerId(val.getId());
                bean.setApi_license(val.getKey());
                LocalDateTime validFrom = val.getValidFrom();

                String dateValidFrom = validFrom.format(formatter1);

                bean.setValidFrom(dateValidFrom);
                LocalDateTime validTo = val.getValidTo();
                String dateValidTo = validTo.format(formatter1);

                bean.setValidTo(dateValidTo);
                bean.setActiveStatus(val.isActive());
                rptBean.add(bean);
            }
        }
        return rptBean;
    }
//dashboard screen
    @RequestMapping("/dashboardPartner")
    public  ArrayList<ReportLogBean> dashboardPartnerList(@RequestBody String reports) {
        logger.info("calling  partnerRegistrationMSPService from ReportsController for dashboardPartner");
        org.json.JSONObject jsonObject = new org.json.JSONObject(reports);
        ArrayList<ReportLogBean> rptBean = new ArrayList<ReportLogBean>();
        String startDate = jsonObject.get("strtDate").toString();
        System.out.println("strtDate" + startDate);
        System.out.println(startDate);
        DateTimeFormatter formatter = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm");
        LocalDateTime startDateTime = LocalDateTime.parse(startDate + " 00:00", formatter);
        String endDate = jsonObject.get("endDate").toString();
        System.out.println("strtDate" + endDate);
        System.out.println(endDate);
        LocalDateTime endDateTime = LocalDateTime.parse(endDate + " 00:00", formatter);
//        List<Object[]> report = partnerRegistrationMSPService.noOfDashboardPolicyGrpList(startDateTime,endDateTime);
        List<Object[]> report = partnerRegistrationService.noOfDashboardPolicyGrpList(startDateTime,endDateTime);
        for(Object[] val : report){
            ReportLogBean bean= new ReportLogBean();
            bean.setCount((BigInteger) val[0]);
            bean.setPolicyGroup(val[2].toString());
            rptBean.add(bean);
        }
        return rptBean;
    }
    @RequestMapping("/dashboardAPILIcense")
    public  ArrayList<ReportLogBean> dashboardAPILicenseList(@RequestBody String reports) {
        logger.info("calling  partnerRegistrationMSPService from ReportsController for dashboardAPILIcense");
