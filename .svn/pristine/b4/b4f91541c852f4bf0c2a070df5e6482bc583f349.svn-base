//        BigInteger licenseReport = mspMsipLicenseService.getDashboarLicenseList(startDateTime ,endDateTime );
        BigInteger licenseReport = mispLicenseKeyService.getDashboarLicenseList(startDateTime ,endDateTime );
            ReportLogBean beanRpt= new ReportLogBean();
            beanRpt.setCount(licenseReport);
            beanRpt.setApi_license("MISP License");
            rptBean.add(beanRpt);
        return rptBean;
    }
