@RequestMapping("/noOnboardPartnerList")
    public  ArrayList<ReportLogBean> noOnboardedPartner(@RequestBody String reports){
    logger.info("calling  partnerRegistrationMSPService from ReportsController for noOnboardPartnerList");
    org.json.JSONObject jsonObject = new org.json.JSONObject(reports);
    ArrayList<ReportLogBean> rptBean = new ArrayList<ReportLogBean>();
    String startDate = jsonObject.get("strtDate").toString();
    System.out.println("strtDate" + startDate);

    DateTimeFormatter formatter = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss");
    LocalDateTime startDateTime = LocalDateTime.parse(startDate + " 00:00:00", formatter);
    String endDate = jsonObject.get("endDate").toString();
    System.out.println("strtDate" + endDate);
    System.out.println(startDateTime);
    LocalDateTime endDateTime = LocalDateTime.parse(endDate + " 23:59:59", formatter);
    System.out.println(endDateTime);
    List<Object[]> report;
    if(jsonObject.get("mode").toString().equals("approved")){
        report = partnerRegistrationService.noOnboardedPartner(jsonObject.get("mode").toString(),jsonObject.get("policyGroup").toString(),startDateTime,endDateTime,"Auth_Partner");
    }else if(jsonObject.get("mode").toString().equals("suspended")){
       report = partnerRegistrationMSPService.suspendedPartnerList(jsonObject.get("mode").toString(),startDateTime,endDateTime);
    }else if(jsonObject.get("mode").toString().equals("backlist")) {
        report = partnerRegistrationMSPService.backlistPartnerList(jsonObject.get("mode").toString(),startDateTime,endDateTime);
    }else{
        report = partnerRegistrationMSPService.revokePartnerList(jsonObject.get("mode").toString(),startDateTime,endDateTime);
    }

    for(Object[] val : report){
        ReportLogBean bean= new ReportLogBean();
        bean.setPolicyGroup(val[0].toString());
        bean.setPartnerId(val[1].toString());
        bean.setOrganisation(val[2].toString());
        bean.setMobile(val[3].toString());
        bean.setEmail(val[4].toString());
        bean.setStatus(val[5].toString());
        rptBean.add(bean);
    }

    return rptBean;
}


    @RequestMapping("/noOnboardDeviceList")
    public  ArrayList<ReportLogBean> noOnboardDeviceList(@RequestBody String reports){
        logger.info("calling  deviceModelRegistrationMSPService from ReportsController for noOnboardDeviceList");
