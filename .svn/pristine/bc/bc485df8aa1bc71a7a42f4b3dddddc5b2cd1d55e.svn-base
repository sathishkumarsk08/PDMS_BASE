    public boolean updateMSPPartnerRegistration(MSPPartnerRegistration user, String id) {
            boolean out = true;
            try {
                MSPPartnerRegistration s=partnerRegistrationRepository.findAllByPartnerId(id);
                s.setAuthenticationRepName(user.getAuthenticationRepName());
                s.setMobileNumber(user.getMobileNumber());
                String strOrg = user.getOtherDocument();
                String strDiclo = user.getNonDisclosureAgreement();
                String strSelfAss = user.getSelfAssessment();
                String strPsa = user.getPsaApproval();
                if (strOrg != null && !strOrg.isEmpty()) {
                    s.setOtherDocument(strOrg);
                }   if (strDiclo != null && !strDiclo.isEmpty()) {
                    s.setNonDisclosureAgreement(strDiclo);
                }
                    if (strSelfAss != null && !strSelfAss.isEmpty()) {
                    s.setSelfAssessment(strSelfAss);
                }
                    if (strPsa != null && !strPsa.isEmpty()) {
                    s.setSelfAssessment(strPsa);
                }

                partnerRegistrationRepository.save(s);

                out = true;
            } catch (Exception e) {
                e.printStackTrace();
                out = false;
            }

            return out;
        }
    public boolean updateBasicDocumentMSPPartnerRegistration(MSPPartnerRegistration user, String id) {
        boolean out = true;
        try {
            MSPPartnerRegistration s=partnerRegistrationRepository.findAllByPartnerId(id);
            String strOrg = user.getOtherDocument();
            String strDiclo = user.getNonDisclosureAgreement();
            String strSelfAss = user.getSelfAssessment();
            String strPsa = user.getPsaApproval();
            if (strOrg != null && !strOrg.isEmpty()) {
                s.setOtherDocument(strOrg);
            }   if (strDiclo != null && !strDiclo.isEmpty()) {
                s.setNonDisclosureAgreement(strDiclo);
            }
            if (strSelfAss != null && !strSelfAss.isEmpty()) {
                s.setSelfAssessment(strSelfAss);
            }
            if (strPsa != null && !strPsa.isEmpty()) {
                s.setSelfAssessment(strPsa);
            }

            partnerRegistrationRepository.save(s);

            out = true;
        } catch (Exception e) {
            e.printStackTrace();
            out = false;
        }

        return out;
    }


