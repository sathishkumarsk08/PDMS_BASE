package com.msp.pms.msppmsmodel;

import javax.persistence.*;
import java.time.LocalDateTime;

@Entity
@Table(name="partner_suspension",schema = "msppms")
public class MSPPartnerSuspension implements java.io.Serializable{
    private Integer sno;
    private String id;
    private String reason;
    private LocalDateTime startDate;
    private LocalDateTime endDate;
    private Integer createdBy;
    private LocalDateTime crdtime;
    private Integer userId;
    private Integer updBy;
    private LocalDateTime susUpdTime;
    private Boolean isDel;
    private LocalDateTime susDelDtime;
    private String susId;
    private Integer count;
    @Column (name = "count")
    public Integer getCount() {
        return count;
    }

    public void setCount(Integer count) {
        this.count = count;
    }

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    @Column (name = "sus_sno")
    public Integer getSno() {
        return sno;
    }

    public void setSno(Integer sno) {
        this.sno = sno;
    }
    @Column (name = "partner_id")
    public String getId() {
        return id;
    }

    public void setId(String id) {
        this.id = id;
    }
    @Column (name = "reason_for_sus")
    public String getReason() {
        return reason;
    }

    public void setReason(String reason) {
        this.reason = reason;
    }
    @Column (name = "eff_date_sus")
    public LocalDateTime getStartDate() {
        return startDate;
    }

    public void setStartDate(LocalDateTime startDate) {
        this.startDate = startDate;
    }
    @Column (name = "end_date_sus")
    public LocalDateTime getEndDate() {
        return endDate;
    }

    public void setEndDate(LocalDateTime endDate) {
        this.endDate = endDate;
    }
    @Column (name = "sus_created_by")
    public Integer getCreatedBy() {
        return createdBy;
    }

    public void setCreatedBy(Integer createdBy) {
        this.createdBy = createdBy;
    }
    @Column (name = "sus_crdtimes")
    public LocalDateTime getCrdtime() {
        return crdtime;
    }

    public void setCrdtime(LocalDateTime crdtime) {
        this.crdtime = crdtime;
    }
    @Column (name = "user_id")
    public Integer getUserId() {
        return userId;
    }

    public void setUserId(Integer userId) {
        this.userId = userId;
    }
    @Column (name = "sus_upd_by")
    public Integer getUpdBy() {
        return updBy;
    }

    public void setUpdBy(Integer updBy) {
        this.updBy = updBy;
    }
    @Column (name = "sus_updtimes")
    public LocalDateTime getSusUpdTime() {
        return susUpdTime;
    }

    public void setSusUpdTime(LocalDateTime susUpdTime) {
        this.susUpdTime = susUpdTime;
    }
    @Column (name = "is_deleted")
    public Boolean getDel() {
        return isDel;
    }

    public void setDel(Boolean del) {
        isDel = del;
    }
    @Column (name = "sus_del_dtimes")
    public LocalDateTime getSusDelDtime() {
        return susDelDtime;
    }

    public void setSusDelDtime(LocalDateTime susDelDtime) {
        this.susDelDtime = susDelDtime;
    }
    @Column (name = "sus_id")
    public String getSusId() {
        return susId;
    }

    public void setSusId(String susId) {
        this.susId = susId;
    }



}
