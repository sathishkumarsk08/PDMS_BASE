    @RequestMapping(value = "/getPoliciesDashboard")
    public ArrayList<DashboardCount> getPoliciesDashboard(@RequestBody String userId, HttpServletRequest request) throws JSONException, JsonProcessingException {
        logger.info("calling ReportService for Policy Dashboard");
        auditRequestFactory.buildRequest(AuditModules.PDMS_REPORT, AuditEvents.PDMS_REPORT, "NO_ID", "NO_IDTYPE", "Get all policy for dashboard", request);

        ArrayList<DashboardCount> viewpolicytype = new ArrayList<DashboardCount>();
        ArrayList<PolicyType> dashPolicyType = new ArrayList<PolicyType>();
        List<String> rejected = new ArrayList<>();
        List<String> approved = new ArrayList<>();
        List<String> waiting = new ArrayList<>();
        try {

            int role = userservice.getUserRole(userId);
            System.out.println("userRole:" + role);
            if (role == 1 || role == 3) {
//            int overall = policyTypeService.getCount();
//            DashboardCount policyCount = new DashboardCount();
//            policyCount.setCount(String.valueOf(overall));
//            policyCount.setEvent("Total Policies Count");
//            viewpolicytype.add(policyCount);
                rejected = mspPolicyTypeService.getRejectedPolicies();
                approved = mspPolicyTypeService.getApprovedPolicies();
                waiting = mspPolicyTypeService.getWaitingPolicies();
                dashPolicyType = (ArrayList<PolicyType>) policyTypeService.viewListPolicyType(waiting);
//                policyCount = viewpolicytype.size();
//                int countActive = policyTypeService.getActivePolicyRole();
                DashboardCount policyActiveCount = new DashboardCount();
                policyActiveCount.setCount(String.valueOf(dashPolicyType.size()));
                policyActiveCount.setEvent("Waiting");
                viewpolicytype.add(policyActiveCount);
                dashPolicyType = (ArrayList<PolicyType>) policyTypeService.viewListPolicyType(approved);
//                policyCount+= viewpolicytype.size();
                int countDeActive = policyTypeService.getDeActivePolicyRole();
                DashboardCount policyDeActiveCount = new DashboardCount();
                policyDeActiveCount.setCount(String.valueOf(dashPolicyType.size()));
                policyDeActiveCount.setEvent("Approved");
                viewpolicytype.add(policyDeActiveCount);

                dashPolicyType = (ArrayList<PolicyType>) policyTypeService.viewListPolicyType(rejected);
//                policyCount+= viewpolicytype.size();

                int countExpiry = policyTypeService.getExpiryPolicyRole();
                DashboardCount policyExpiryCount = new DashboardCount();
                policyExpiryCount.setCount(String.valueOf(dashPolicyType.size()));
                policyExpiryCount.setEvent("Rejected");
                viewpolicytype.add(policyExpiryCount);
                System.out.println("report" + viewpolicytype);

            } else {
                rejected = mspPolicyTypeService.getRejectedPolicies(userId);
                approved = mspPolicyTypeService.getApprovedPolicies(userId);
                waiting = mspPolicyTypeService.getWaitingPolicies(userId);
                dashPolicyType = (ArrayList<PolicyType>) policyTypeService.viewListPolicyType(waiting);
//                policyCount = viewpolicytype.size();
//                int countActive = policyTypeService.getActivePolicyRole();
                DashboardCount policyActiveCount = new DashboardCount();
                policyActiveCount.setCount(String.valueOf(dashPolicyType.size()));
                policyActiveCount.setEvent("Waiting");
                viewpolicytype.add(policyActiveCount);
                dashPolicyType = (ArrayList<PolicyType>) policyTypeService.viewListPolicyType(approved);
//                policyCount+= viewpolicytype.size();
                int countDeActive = policyTypeService.getDeActivePolicyRole();
                DashboardCount policyDeActiveCount = new DashboardCount();
                policyDeActiveCount.setCount(String.valueOf(dashPolicyType.size()));
                policyDeActiveCount.setEvent("Approved");
                viewpolicytype.add(policyDeActiveCount);

                dashPolicyType = (ArrayList<PolicyType>) policyTypeService.viewListPolicyType(rejected);
//                policyCount+= viewpolicytype.size();

                int countExpiry = policyTypeService.getExpiryPolicyRole();
                DashboardCount policyExpiryCount = new DashboardCount();
                policyExpiryCount.setCount(String.valueOf(dashPolicyType.size()));
                policyExpiryCount.setEvent("Rejected");
                viewpolicytype.add(policyExpiryCount);
                System.out.println("report" + viewpolicytype);

            }
        } catch (Exception e) {
            logger.error("calling mspPolicyTypeService from RPController for viewPolicyType", e.getMessage());
            e.printStackTrace();
        }
        return viewpolicytype;
    }

    @RequestMapping(value = "/getPartnerDashboard")
    public ArrayList<DashboardCount> getPartnerDashboard(@RequestBody String userId, HttpServletRequest request) throws JSONException, JsonProcessingException {
        logger.info("calling ReportService for Partner Dashboard");
        auditRequestFactory.buildRequest(AuditModules.PDMS_REPORT, AuditEvents.PDMS_REPORT, "NO_ID", "NO_IDTYPE", "Get all partner for dashboard", request);

        ArrayList<DashboardCount> viewpolicytype = new ArrayList<DashboardCount>();
        List<String> regMSPPartner = null;
        try {
            int role = userservice.getUserRole(userId);
            regMSPPartner = partnerRegistrationMSPService.getMSPPartnerRegAuthList();
            if (role == 1 || role == 3) {
                System.out.println("userRole:" + role);
//            int overall = partnerRegistrationService.getAuthPartnerCount();
//            DashboardCount policyCount = new DashboardCount();
//            policyCount.setCount(String.valueOf(overall));
//            policyCount.setEvent("Total Partner Count");
//            viewpolicytype.add(policyCount);

                int countActive = partnerRegistrationService.getUploadPendingCountRole(regMSPPartner);
                DashboardCount policyActiveCount = new DashboardCount();
                policyActiveCount.setCount(String.valueOf(countActive));
                policyActiveCount.setEvent("Upload Pending");
                viewpolicytype.add(policyActiveCount);
                int countDeActive = partnerRegistrationService.getActiveCountRole(regMSPPartner);
                DashboardCount policyDeActiveCount = new DashboardCount();
                policyDeActiveCount.setCount(String.valueOf(countDeActive));
                policyDeActiveCount.setEvent("Active");
                viewpolicytype.add(policyDeActiveCount);
                int countExpiry = partnerRegistrationService.getDeActiveCountRole(regMSPPartner);
                DashboardCount policyExpiryCount = new DashboardCount();
                policyExpiryCount.setCount(String.valueOf(countExpiry));
                policyExpiryCount.setEvent("De-Active");
                viewpolicytype.add(policyExpiryCount);
                System.out.println("partner report" + viewpolicytype);
            } else {

                int countActive = partnerRegistrationService.getUploadPendingCount(userId, regMSPPartner);
                DashboardCount policyActiveCount = new DashboardCount();
                policyActiveCount.setCount(String.valueOf(countActive));
                policyActiveCount.setEvent("Upload Pending");
                viewpolicytype.add(policyActiveCount);
                int countDeActive = partnerRegistrationService.getActiveCount(userId, regMSPPartner);
                DashboardCount policyDeActiveCount = new DashboardCount();
                policyDeActiveCount.setCount(String.valueOf(countDeActive));
                policyDeActiveCount.setEvent("Active");
                viewpolicytype.add(policyDeActiveCount);
                int countExpiry = partnerRegistrationService.getDeActiveCount(userId, regMSPPartner);
                DashboardCount policyExpiryCount = new DashboardCount();
                policyExpiryCount.setCount(String.valueOf(countExpiry));
                policyExpiryCount.setEvent("De-Active");
                viewpolicytype.add(policyExpiryCount);
                System.out.println("partner report" + viewpolicytype);
            }

        } catch (Exception e) {
            logger.error("calling mspPolicyTypeService from RPController for viewPolicyType", e.getMessage());
            e.printStackTrace();
        }
        return viewpolicytype;
    }

    @RequestMapping(value = "/getDeviceDashboard")
    public ArrayList<DashboardCount> getDeviceDashboard(@RequestBody String userId,HttpServletRequest request) throws JSONException, JsonProcessingException {
        logger.info("calling ReportService for Device Dashboard");
        auditRequestFactory.buildRequest(AuditModules.PDMS_REPORT, AuditEvents.PDMS_REPORT, "NO_ID", "NO_IDTYPE", "Get all device for dashboard", request);

        ArrayList<DashboardCount> viewpolicytype = new ArrayList<DashboardCount>();
        try {
            int role = userservice.getUserRole(userId);
            if (role == 1 || role == 3) {
                System.out.println("userRole:" + role);
                List<String> iris = deviceModelRegistrationMSPService.getDeviceTypeId("iris");
                List<String> face = deviceModelRegistrationMSPService.getDeviceTypeId("face");
                List<String> finger = deviceModelRegistrationMSPService.getDeviceTypeId("finger");
                int irisCount = partnerRegistrationService.getIrisCountRole(iris);
                DashboardCount deviceIrisCount = new DashboardCount();
                deviceIrisCount.setCount(String.valueOf(irisCount));
                deviceIrisCount.setEvent("IRIS");
                viewpolicytype.add(deviceIrisCount);
                int faceCount = partnerRegistrationService.getIrisCountRole(face);
                DashboardCount deviceFaceCount = new DashboardCount();
                deviceFaceCount.setCount(String.valueOf(faceCount));
                deviceFaceCount.setEvent("FACE");
                viewpolicytype.add(deviceFaceCount);
                int fingerCount = partnerRegistrationService.getIrisCountRole(finger);
                DashboardCount deviceFingerCount = new DashboardCount();
                deviceFingerCount.setCount(String.valueOf(fingerCount));
                deviceFingerCount.setEvent("Finger");
                viewpolicytype.add(deviceFingerCount);
            } else {
                List<String> iris = deviceModelRegistrationMSPService.getDeviceTypeId("iris");
                List<String> face = deviceModelRegistrationMSPService.getDeviceTypeId("face");
                List<String> finger = deviceModelRegistrationMSPService.getDeviceTypeId("finger");
                int irisCount = partnerRegistrationService.getIrisCount(iris, userId);
                DashboardCount deviceIrisCount = new DashboardCount();
                deviceIrisCount.setCount(String.valueOf(irisCount));
                deviceIrisCount.setEvent("IRIS");
                viewpolicytype.add(deviceIrisCount);
                int faceCount = partnerRegistrationService.getIrisCount(face, userId);
                DashboardCount deviceFaceCount = new DashboardCount();
                deviceFaceCount.setCount(String.valueOf(faceCount));
                deviceFaceCount.setEvent("FACE");
                viewpolicytype.add(deviceFaceCount);
                int fingerCount = partnerRegistrationService.getIrisCount(finger, userId);
                DashboardCount deviceFingerCount = new DashboardCount();
                deviceFingerCount.setCount(String.valueOf(fingerCount));
                deviceFingerCount.setEvent("Finger");
                viewpolicytype.add(deviceFingerCount);

            }
        } catch (Exception e) {
            logger.error("calling ReportService for Device Dashboard", e.getMessage());
            e.printStackTrace();
        }
        System.out.println("device dashboard" + viewpolicytype);
        return viewpolicytype;
    }
}
