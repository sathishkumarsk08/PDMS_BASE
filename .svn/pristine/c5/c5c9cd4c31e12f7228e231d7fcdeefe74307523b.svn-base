    @RequestMapping("/noOnboardPartnerList")
    public ArrayList<ReportLogBean> noOnboardedPartner(@RequestBody String reports, HttpServletRequest request) throws JsonProcessingException {
        logger.info("calling  partnerRegistrationMSPService from ReportsController for noOnboardPartnerList");
        auditRequestFactory.buildRequest(AuditModules.PDMS_PARTNER, AuditEvents.PARTNER_EVENT, "NO_ID", "NO_IDTYPE", "Get all onboard partner list", request);

        org.json.JSONObject jsonObject = new org.json.JSONObject(reports);
        ArrayList<ReportLogBean> rptBean = new ArrayList<ReportLogBean>();
        String startDate = jsonObject.get("strtDate").toString();
        System.out.println("strtDate" + startDate);
        int role = userservice.getUserRole(jsonObject.get("userId").toString());
        DateTimeFormatter formatter = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss");
        LocalDateTime startDateTime = LocalDateTime.parse(startDate + " 00:00:00", formatter);
        String endDate = jsonObject.get("endDate").toString();
        System.out.println("strtDate" + endDate);
        System.out.println(startDateTime);
        LocalDateTime endDateTime = LocalDateTime.parse(endDate + " 23:59:59", formatter);
        System.out.println(endDateTime);
        List<Object[]> report;
        List<String> regMSPPartner;
        if (role == 1 || role == 3) {
            if (jsonObject.get("mode").toString().equals("approved")) {
                report = partnerRegistrationService.noOnboardedPartner(jsonObject.get("mode").toString(), jsonObject.get("policyGroup").toString());
            } else if (jsonObject.get("mode").toString().equals("suspended")) {
                regMSPPartner = partnerRegistrationMSPService.getMSPSusBlackPartnerRegAuthList(jsonObject.get("mode").toString());
                report = partnerRegistrationService.suspendedPartnerList(regMSPPartner);
            } else if (jsonObject.get("mode").toString().equals("blacklist")) {
                regMSPPartner = partnerRegistrationMSPService.getMSPSusBlackPartnerRegAuthList(jsonObject.get("mode").toString());
                report = partnerRegistrationService.suspendedPartnerList(regMSPPartner);
            } else {
                regMSPPartner = partnerRegistrationMSPService.getMSPSusBlackPartnerRegAuthList(jsonObject.get("mode").toString());
                report = partnerRegistrationService.suspendedPartnerList(regMSPPartner);
            }

        } else {
            if (jsonObject.get("mode").toString().equals("approved")) {
                report = partnerRegistrationService.noOnboardedPartner(jsonObject.get("mode").toString(), jsonObject.get("policyGroup").toString(), jsonObject.get("userId").toString());
            } else if (jsonObject.get("mode").toString().equals("suspended")) {
                regMSPPartner = partnerRegistrationMSPService.getMSPSusBlackPartnerRegAuthList(jsonObject.get("mode").toString());
                report = partnerRegistrationService.suspendedPartnerList(regMSPPartner, jsonObject.get("userId").toString());
            } else if (jsonObject.get("mode").toString().equals("blacklist")) {
                regMSPPartner = partnerRegistrationMSPService.getMSPSusBlackPartnerRegAuthList(jsonObject.get("mode").toString());
                report = partnerRegistrationService.suspendedPartnerList(regMSPPartner, jsonObject.get("userId").toString());
            } else {
                regMSPPartner = partnerRegistrationMSPService.getMSPSusBlackPartnerRegAuthList(jsonObject.get("mode").toString());
                report = partnerRegistrationService.suspendedPartnerList(regMSPPartner, jsonObject.get("userId").toString());
            }

        }

        for (Object[] val : report) {
            ReportLogBean bean = new ReportLogBean();
            bean.setPolicyGroup(val[0].toString());
            bean.setPartnerId(val[1].toString());
            bean.setOrganisation(val[2].toString());
            bean.setMobile(val[3].toString());
            bean.setEmail(val[4].toString());
            if (jsonObject.get("mode").toString().equals("approved")) {
                bean.setStatus("Approved");
            } else if (jsonObject.get("mode").toString().equals("suspended")) {
                bean.setStatus("Suspended");
            } else if (jsonObject.get("mode").toString().equals("blacklist")) {
                bean.setStatus("Blacklist");
            } else {
                bean.setStatus("Revoke");
            }

            rptBean.add(bean);
        }

        return rptBean;
    }


