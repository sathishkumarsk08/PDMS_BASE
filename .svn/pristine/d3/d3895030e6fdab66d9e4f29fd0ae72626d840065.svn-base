package com.msp.mosip_pms.repository;

import com.msp.mosip_pms.model.MispLicenseKey;
import com.msp.mosip_pms.model.PartnerRegistration;
import com.msp.pms.msppmsmodel.MSPMosipLicense;
import org.springframework.data.jpa.repository.Modifying;
import org.springframework.data.jpa.repository.Query;
import org.springframework.data.repository.CrudRepository;
import org.springframework.stereotype.Component;
import org.springframework.stereotype.Repository;

import java.math.BigInteger;
import java.time.LocalDateTime;
import java.util.List;

@Component
@Repository
public interface MispLicenseKeyRepository extends CrudRepository<MispLicenseKey, String> {


    @Query("select u from MispLicenseKey u order by u.crDtimes desc")
    List<MispLicenseKey> getOnboardedLicense();

    @Query("select count(u) from MispLicenseKey u where u.active=true ")
    BigInteger getDashboarLicenseList();

    @Query(value = "SELECT t  from MispLicenseKey t where t.active=:status order by t.crDtimes desc")
    List<MispLicenseKey> viewPartnerLicense(boolean status);

//    @Modifying
//    @Query(value = "update  MispLicenseKey t set t.deleted=true, t.delDtimes=CURRENT_TIMESTAMP where t.id=:partId and t.key=:licenseKey")
//    int DeleteLicenseKey(String partId, String licenseKey);

    @Modifying
    @Query(value = "delete from  MispLicenseKey t  where t.id=:partId and t.key=:licenseKey")
    int DeleteLicenseKey(String partId, String licenseKey);


    @Modifying
    @Query(value = "update  MispLicenseKey t set t.active=:status where t.id=:providerId and t.key=:licenseKey")
    int updateStatus(boolean status, String providerId, String licenseKey);

    @Query(value = "SELECT t  from MispLicenseKey t where t.active=true and t.deleted=false order by t.crDtimes desc")
    List<MispLicenseKey> getTSPPartnerDetails();

    @Query(value = "SELECT t  from MispLicenseKey t where t.id=:partnerId and t.deleted=false")
    MispLicenseKey getLicenseKeyDetails(String partnerId);
}
