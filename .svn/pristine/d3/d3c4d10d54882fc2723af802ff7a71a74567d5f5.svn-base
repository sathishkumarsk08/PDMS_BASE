    @RequestMapping(value = "/viewDeviceReg")
    public ArrayList<MSPDeviceModelRegistration> viewDeviceReg(@RequestBody String statusName) throws JSONException {
        logger.info("calling  from DeviceManagementController  for viewDeviceReg");
        org.json.JSONObject jsonObject = new org.json.JSONObject(statusName);
        ArrayList<MSPDeviceModelRegistration> devicereg=null;
        String partStatus = jsonObject.get("status").toString();
        String partperform = jsonObject.get("perform").toString();
        boolean status = false;
        if (jsonObject.get("active").equals("true")) {
            status = true;
        } else {
            status = false;
        }
        if(jsonObject.get("status").equals("Active")){
            partStatus = "approved";
        }else if(jsonObject.get("status").equals("De-Active")){
            partStatus ="approved";
        }
        try {
            System.out.println("testing" + jsonObject.get("status").toString() + "," + status);
            devicereg = (ArrayList<MSPDeviceModelRegistration>) deviceModelRegistrationMSPService.viewDeviceReg(partStatus,partperform);
            System.out.println("testing" +devicereg);

        } catch (Exception e) {
            logger.info("calling  from DeviceManagementController  for viewDeviceReg");
            e.printStackTrace();
        }
        return devicereg;
    }

