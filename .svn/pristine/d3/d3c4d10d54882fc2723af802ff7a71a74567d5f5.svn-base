    @RequestMapping("/createDevicepartner")
    public String reigsterDevicePartner(@RequestBody String DevicePartner ,HttpServletRequest request) throws JsonParseException, JsonMappingException, JsonProcessingException, IOException, NoSuchAlgorithmException, KeyManagementException {
        System.out.println("1.enter in device creation");
        logger.info("calling device Model Registration MSPService from DeviceManagementController  for create Device partner");
        auditRequestFactory.buildRequest(AuditModules.PDMS_DEVICE, AuditEvents.DEVICE_EVENT,"NO_ID","NO_IDTYPE","create device request",request);
        String record = "";
        String returnVal = "";
        String text = null;
        try {
            turnOffSslChecking();
            APIConnection.authenticate();
            ResourceBundle bundle = APIConnection.readConfig();
            org.json.JSONObject jsonDeviceObject = new org.json.JSONObject(DevicePartner);
            Integer maxSno = 0;
            String deviceId = null, FTMId = null;
            String deviceText = null, ftmText = null;
            String userIdGenerate = partnerRegistrationService.maxUserid();
//        String deviceOrganization= jsonDeviceObject.get("organizationName").toString();
//        String FtmOrganization= jsonDeviceObject.get("organizationName").toString();
//            for (int i = 0; i <= 1; i++) {

                try {

                    String prefix;
                    String deviceType = jsonDeviceObject.getString("devicetype");
                    if(deviceType.equals("iris")){
                         prefix = "IR";
                    }else if(deviceType.equals("face")){
                        prefix = "FA";
                    }else {
                        prefix = "FP";
                    }

                    System.out.println("userId" + userIdGenerate);
                    if (userIdGenerate == null || userIdGenerate.length() == 0 || userIdGenerate.length() <= 5) {
                        deviceText = "00001";
                        deviceId = prefix + APIConnection.formatToGenerateID(APIConnection.getUTCCurrentDateTime()) + deviceText;
                    } else {
                        String sentence=userIdGenerate;
                        String name= new StringBuilder(sentence).reverse().toString();
                        String val= name.substring(0,5);
                        String name2= new StringBuilder(val).reverse().toString();
                        text = String.format("%0" + name2.length() + "d", Long.parseLong(name2) + 1);
                        deviceId = prefix + APIConnection.formatToGenerateID(APIConnection.getUTCCurrentDateTime()) + text;

                    }


                    System.out.println("Device id  " + deviceId);
//                    else {
//                        FTMId = "FTM" + APIConnection.formatToGenerateID(APIConnection.getUTCCurrentDateTime()) + ftmText;
//                    }
                    org.json.JSONObject template = new org.json.JSONObject(bundle.getString("template"));
                    org.json.JSONObject requestTemp = template.getJSONObject("request");

                    MSPDeviceModelRegistration partnerreg = new MSPDeviceModelRegistration();
                    requestTemp.put("contactNumber", jsonDeviceObject.get("contactNumber"));
               
                        requestTemp.put("partnerId", deviceId);
                        requestTemp.put("organizationName", jsonDeviceObject.get("organizationName"));
                        requestTemp.put("partnerType", "Device_Provider");
                        requestTemp.put("address", jsonDeviceObject.get("address"));
                        requestTemp.put("emailId", jsonDeviceObject.get("emailId"));
                        template.put("requesttime", APIConnection.formatToISOString(APIConnection.getUTCCurrentDateTime()));
                        template.put("request", requestTemp);
                        partnerreg.setId(deviceId);
                        partnerreg.setName(jsonDeviceObject.get("organizationName").toString());
                        partnerreg.setPartnerType("Device_Provider");
                        partnerreg.setEmail(jsonDeviceObject.get("emailId").toString());
                        partnerreg.setFlag(0);
                        partnerreg.setMobilenumber(jsonDeviceObject.get("contactNumber").toString());
                        partnerreg.setStatus("InProgress");
                        partnerreg.setDeviceType(jsonDeviceObject.get("devicetype").toString());
                        partnerreg.setDeviceModel(jsonDeviceObject.get("devicemodel").toString());
                        partnerreg.setBrandName(jsonDeviceObject.get("brandname").toString());
//                        partnerreg.setDeviceStatus(jsonDeviceObject.get("status").toString());
                        partnerreg.setAddress(jsonDeviceObject.get("address").toString());
                        partnerreg.setCrDtTime(APIConnection.getUTCCurrentDateTime());
                        partnerreg.setCreatedBy(jsonDeviceObject.get("userId").toString());
                       String deviceCheck =  DeviceRegistrationMethod(0,"Device",template , partnerreg,"Device_Provider",jsonDeviceObject.get("emailId").toString(),jsonDeviceObject.get("organizationName").toString(), deviceId, jsonDeviceObject.get("contactNumber").toString(),jsonDeviceObject.get("userId").toString(),request);

                        org.json.JSONObject jsoninput = new org.json.JSONObject(deviceCheck);
                        String responseData = (jsoninput.get("response")).toString();
                        System.out.println("response " + responseData);
                        returnVal =deviceCheck;


                } catch (Exception e) {
                    logger.error("calling device Model Registration MSPService from DeviceManagementController  for create Device partner", e.getMessage());
                    e.printStackTrace();
                    auditRequestFactory.buildRequest(AuditModules.PDMS_DEVICE, AuditEvents.DEVICE_EVENT,"NO_ID","NO_IDTYPE","create device failed",request);

                }
//            }
        }catch (Exception e){
            e.printStackTrace();
            auditRequestFactory.buildRequest(AuditModules.PDMS_DEVICE, AuditEvents.DEVICE_EVENT,"NO_ID","NO_IDTYPE","create device failed",request);

        }
        return returnVal;
    }

