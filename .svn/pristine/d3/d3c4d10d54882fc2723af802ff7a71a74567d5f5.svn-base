    private String DeviceRegistrationMethod(int i,String message,JSONObject template, MSPDeviceModelRegistration partnerreg, String partnerType, String emailId, String organizationName,String DeviceId,String contact,String userId,HttpServletRequest request) throws JsonProcessingException {
      String returnVal="";
      String record="";
        ResourceBundle bundle = APIConnection.readConfig();
        try {
            int mosipPartnerTable = partnerRegistrationService.getMOSIPOrganizationEmailId(partnerType, emailId, organizationName);

            System.out.println("moisp count" +mosipPartnerTable);

            int pmsPartnerTable = deviceModelRegistrationMSPService.getPMSOrganizationEmailId(partnerType, emailId, organizationName);

            System.out.println("pms count" +pmsPartnerTable);

            if (mosipPartnerTable >= 1 && pmsPartnerTable >= 1) {
                System.out.println("Device already exsist");

            } else {
                if (mosipPartnerTable == 0 && pmsPartnerTable == 0) {
                    System.out.println("Device need to insert in both table");
                    try{
                        deviceModelRegistrationMSPService.save(partnerreg);
                            record = APIConnection.connectApi(bundle.getString("base.url") + bundle.getString("version") + bundle.getString("partnermanager.partner.url"),
                                    "POST", template.toString(), "Cookie");
                            org.json.JSONObject jsoninput = new org.json.JSONObject(record);
                            String responseData = (jsoninput.get("response")).toString();
                            System.out.println("response " + responseData);
                            if (responseData.equals("null")) {
                                returnVal = record;
                                deviceModelRegistrationMSPService.deleteById(DeviceId);
                                mspAuditLogs.setAuditRequestDto(PartnerManageEnum.GET_PARTNER_FAILURE,request);
                                auditRequestFactory.buildRequest(AuditModules.PDMS_DEVICE, AuditEvents.DEVICE_EVENT,"NO_ID","NO_IDTYPE","create device failed",request);

                            }else {
                                returnVal =  record;
                                mspAuditLogs.setAuditRequestDto(PartnerManageEnum.GET_PARTNER_SUCCESS,request);
                                partnerRegistrationService.changeUserId(DeviceId,userId);
                                auditRequestFactory.buildRequest(AuditModules.PDMS_DEVICE, AuditEvents.DEVICE_EVENT,"NO_ID","NO_IDTYPE","create device success. and device id :"+DeviceId,request);

                                mailTemplate(i,organizationName,DeviceId,"",emailId,contact);
                                notificationSystem.saveDeviceRegistration(partnerreg,userId);
                            }


                    }catch (Exception e){
                        auditRequestFactory.buildRequest(AuditModules.PDMS_DEVICE, AuditEvents.DEVICE_EVENT,"NO_ID","NO_IDTYPE","create device failed",request);

                        e.printStackTrace();
                    }
                    return returnVal;
                }else {
                    if (mosipPartnerTable >= 1) {
                        if (pmsPartnerTable == 0) {
                            System.out.println("Device not in local pms table need in insert in local update in amin ");
                            try{
                                PartnerRegistration mosipPartnerId1 = partnerRegistrationService.getMOSIPPartnerId(partnerType, emailId, organizationName);
                                partnerreg.setId(mosipPartnerId1.getId());
                               deviceModelRegistrationMSPService.save(partnerreg);
                                    org.json.JSONObject updateTemplate = new org.json.JSONObject(bundle.getString("template"));
                                    org.json.JSONObject requestUptTemp = updateTemplate.getJSONObject("request");
                                    requestUptTemp.put("address", template.get("address"));
                                    requestUptTemp.put("contactNumber", template.get("contactNumber"));
                                    requestUptTemp.put("emailId", template.get("emailId"));
                                    requestUptTemp.put("is_Active", mosipPartnerId1.getActive() );
                                    updateTemplate.put("requesttime", APIConnection.formatToISOString(APIConnection.getUTCCurrentDateTime()));
                                    updateTemplate.put("request", requestUptTemp);
                                    //                                    record = APIConnection.connectApi(bundle.getString("base.url") + bundle.getString("version") + bundle.getString("partnermanager.partner.url") +  "/" + mosipPartnerId ,
//                                            "PUT", updateTemplate.toString(), "Cookie");
                                    record = APIConnection.connectApi(bundle.getString("base.url") + bundle.getString("version") + bundle.getString("partnermanager.partner.url") +  "/" + mosipPartnerId1.getId() +"/contact/add",
                                            "POST", updateTemplate.toString(), "Cookie");
                                    org.json.JSONObject jsoninput = new org.json.JSONObject(record);
                                    String responseData = (jsoninput.get("response")).toString();
                                    System.out.println("response " + responseData);
                                    if (responseData.equals("null")) {
                                        returnVal =  record;
                                        deviceModelRegistrationMSPService.deleteById(mosipPartnerId1.getId());
                                        mspAuditLogs.setAuditRequestDto(PartnerManageEnum.GET_PARTNER_FAILURE,request);
                                        auditRequestFactory.buildRequest(AuditModules.PDMS_DEVICE, AuditEvents.DEVICE_EVENT,"NO_ID","NO_IDTYPE","create device failed",request);

                                    } else {
                                        returnVal =  record;
                                        mspAuditLogs.setAuditRequestDto(PartnerManageEnum.GET_PARTNER_SUCCESS,request);
                                        auditRequestFactory.buildRequest(AuditModules.PDMS_DEVICE, AuditEvents.DEVICE_EVENT,"NO_ID","NO_IDTYPE","create device success. and device id :"+DeviceId,request);

                                        mailTemplate(i,organizationName,mosipPartnerId1.getId(),"",emailId,contact);
                                    }


                            }catch (Exception e){
                                auditRequestFactory.buildRequest(AuditModules.PDMS_DEVICE, AuditEvents.DEVICE_EVENT,"NO_ID","NO_IDTYPE","create device failed",request);
                                e.printStackTrace();
                            }
                            return returnVal;
                        }

                    }
                    if (pmsPartnerTable >= 1) {
                        if (mosipPartnerTable == 0) {
                            System.out.println("partner not in main pms table need in insert in main update in local ");
                            try{
                                String pmsPartnerId = deviceModelRegistrationMSPService.getPmsPartnerId(partnerType, emailId, organizationName);
                                int val = deviceModelRegistrationMSPService.update(pmsPartnerId,contact);
                                if(val >= 1){
//                                    requestTemp.remove("partnerId");
//                                    template.remove("request");
//                                    requestTemp.put("partnerId", pmsPartnerId);
//                                    template.put("request", requestTemp);
                                    record = APIConnection.connectApi(bundle.getString("base.url") + bundle.getString("version") + bundle.getString("partnermanager.partner.url") ,
                                            "POST", template.toString(), "Cookie");
                                    org.json.JSONObject jsoninput = new org.json.JSONObject(record);
                                    String responseData = (jsoninput.get("response")).toString();
                                    System.out.println("response " + responseData);
                                    if (responseData.equals("null")) {
                                        returnVal = record;
                                        deviceModelRegistrationMSPService.deleteById(pmsPartnerId);
                                        mspAuditLogs.setAuditRequestDto(PartnerManageEnum.GET_PARTNER_FAILURE,request);
                                        auditRequestFactory.buildRequest(AuditModules.PDMS_DEVICE, AuditEvents.DEVICE_EVENT,"NO_ID","NO_IDTYPE","create device failed",request);

                                    } else {
                                        returnVal =  record;
                                        mspAuditLogs.setAuditRequestDto(PartnerManageEnum.GET_PARTNER_SUCCESS,request);
                                        auditRequestFactory.buildRequest(AuditModules.PDMS_DEVICE, AuditEvents.DEVICE_EVENT,"NO_ID","NO_IDTYPE","create device success. and device id :"+DeviceId,request);

                                        mailTemplate(i,organizationName,pmsPartnerId,"",emailId,contact);
                                    }
                                }else{
                                    returnVal = record;
                                }
                            }catch (Exception e){
                                e.printStackTrace();
                                auditRequestFactory.buildRequest(AuditModules.PDMS_DEVICE, AuditEvents.DEVICE_EVENT,"NO_ID","NO_IDTYPE","create device failed",request);


                            }
                            return returnVal;

                        }

                    }
                }
            }
        }catch(Exception e){
//            returnVal = message+" Saved Failed";
            e.printStackTrace();
            logger.error("Error in creatring  Partner Registration Service from RPController for partner creation", e.getMessage());
            mspAuditLogs.setAuditRequestDto(PartnerManageEnum.GET_PARTNER_FAILURE,request);
            auditRequestFactory.buildRequest(AuditModules.PDMS_DEVICE, AuditEvents.DEVICE_EVENT,"NO_ID","NO_IDTYPE","create device failed",request);


        }
        return returnVal;
    }



    private void mailTemplate(int i,String organizationName, String partnerId, String policyGrp, String emailId, String contactNumber) {

        try {
            ResourceBundle mailBundle = APIConnection.readConfig();
            EmailNotifyResponseDto response = new EmailNotifyResponseDto();
            String val = "";
            if (i == 0) {
                String subject = "Device Registration Details";
                String   mailTemplate = "Dear " + organizationName+ ", <br>\n<br>\n\n" +
                        "                                DeviceId :  " + partnerId + " <br>\n<br>\n\n" +
                        "                        registered successfully <br>\n<br>\n\n" +
                        "                                Thanks & Regards,  <br>\n<br>\n\n" +
                        "                               PhilSys";

                response = mailService.emailNotification(emailId, subject, mailTemplate,"");
                String smsTemplate = "Dear" + organizationName + " Device Id :" + partnerId + " registered successfully";
                val = AdminApprovalController.sendSMS(smsTemplate, contactNumber);
            } else {
                String subject = "FTM Registration Details";
                String  mailTemplate = "Dear " + organizationName + ", <br>\n<br>\n\n" +
                        "                                FTM ID :  " + partnerId + " <br>\n<br>\n\n" +
                        "                        registered successfully <br>\n<br>\n\n" +
                        "                                Thanks & Regards,  <br>\n<br>\n\n" +
                        "                                PhilSys";

                response = mailService.emailNotification(emailId, subject, mailTemplate,"");
                String smsTemplate = "Dear" + organizationName + " FTM Id :" + partnerId + " registered successfully";
                val = AdminApprovalController.sendSMS(smsTemplate, contactNumber);
            }

            System.out.println("mail testing:" + response);

            System.out.println("5. Mail & sms send success :" + val);
        } catch (Exception e) {

            e.printStackTrace();
            logger.error("Response from RPController for partner creation", e.getMessage());
        }

    }

    @RequestMapping("/deviceapiSubmitRequest")
    public String deviceapiRequests(@RequestBody String request) throws JsonParseException, JsonMappingException, JsonProcessingException, IOException, NoSuchAlgorithmException, KeyManagementException {
        logger.info("calling  from DeviceManagementController  for device api-Submit-Request");
        turnOffSslChecking();
        APIConnection.authenticate();
        ResourceBundle bundle = APIConnection.readConfig();
        org.json.JSONObject template = new org.json.JSONObject(bundle.getString("template"));
        org.json.JSONObject jsonObject = new org.json.JSONObject(request);
        try{
            org.json.JSONObject requestTemp = template.getJSONObject("request");
            requestTemp.put("policyName",jsonObject.get("policyname"));
            requestTemp.put("useCaseDescription"," mapping Partner to policyName");
            template.put("requesttime",APIConnection.formatToISOString(APIConnection.getUTCCurrentDateTime()));
            template.put("request",requestTemp);
        }catch (Exception e){
            logger.error("calling  from DeviceManagementController  for device api-Submit-Request",e.getMessage());
            e.printStackTrace();
        }
        System.out.println("Chk Template :"+template.toString());
        //         /v1/partnermanager/partners/"+partnerId+"/apikey/request
        return APIConnection.connectApi(bundle.getString("base.url")+bundle.getString("version")+bundle.getString("partnermanager.partner.url")+
                "/"+jsonObject.get("partnerId")+"/apikey/request","PATCH",template.toString(),"Cookie");
    }

