    @RequestMapping(value = "/editDevice")
    public String editPartner(@RequestBody String groupname , HttpServletRequest request) throws NoSuchAlgorithmException,
            KeyManagementException, JsonProcessingException {
        logger.info("calling from RPController for activate and Deactivate Device");
//		System.out.println("1.enter in Partner  ");
        System.out.println("testing:"+groupname);
        turnOffSslChecking();
        APIConnection.authenticate();
        String returnVal = null;
        ResourceBundle bundle = APIConnection.readConfig();
        org.json.JSONObject template = new org.json.JSONObject(bundle.getString("template"));
        org.json.JSONObject jsonObject = new org.json.JSONObject(groupname);
        auditRequestFactory.buildRequest(AuditModules.PDMS_DEVICE,AuditEvents.DEVICE_EVENT,"NO_ID","NO_IDTYPE",jsonObject.get("Status").toString()+" request for this device :"+jsonObject.get("Id").toString(),request);
        try {
            org.json.JSONObject requestTemp = template.getJSONObject("request");
            requestTemp.put("status", jsonObject.get("Status"));
            template.put("requesttime", APIConnection.formatToISOString(APIConnection.getUTCCurrentDateTime()));
            template.put("request", requestTemp);
//			template.put("id","mosip.partnermanagement.misp.status.update" );
            System.out.println("template:"+template.toString());
        } catch (Exception e) {
            logger.error("calling from RPController for activate and deactivate device",e.getMessage());
            e.printStackTrace();
        }
        System.out.println("2. Template to Msoip:" + template.toString());
        //         /v1/policymanager/policies/group/newSystem.out.println();
        System.out.println("url:"+bundle.getString("base.url") + bundle.getString("version") + bundle.getString("partnermanager.partner.url")+"/"+jsonObject.get("Id"));
        String record = APIConnection.connectApi(bundle.getString("base.url") + bundle.getString("version") + bundle.getString("partnermanager.partner.url")+"/"+jsonObject.get("Id"),
                "PATCH", template.toString(), "Cookie");
        System.out.println("3. output from Mosip :" + record);
        org.json.JSONObject jsoninput = new org.json.JSONObject(record);
        String responseData = (jsoninput.get("response")).toString();
        if (responseData.equals("null")) {
            returnVal = "false";
            JSONArray responseApi = jsoninput.getJSONArray("errors");
            org.json.JSONObject rec = responseApi.getJSONObject(0);
            returnVal = rec.getString("message");
            auditRequestFactory.buildRequest(AuditModules.PDMS_DEVICE,AuditEvents.DEVICE_EVENT,"NO_ID","NO_IDTYPE",jsonObject.get("Status").toString()+" failed for this device :"+jsonObject.get("Id").toString(),request);


        } else {
            returnVal = "true";
            boolean statusVal;
            System.out.println("id :"+jsonObject.get("Id").toString());
            if(jsonObject.get("Status").equals("active") || jsonObject.get("Status").equals("Active") ){
                statusVal = true;
            }else{
                statusVal = false;
            }
            deviceModelRegistrationMSPService.UpdateStatus( jsonObject.get("Id").toString(),statusVal);
            auditRequestFactory.buildRequest(AuditModules.PDMS_DEVICE,AuditEvents.DEVICE_EVENT,"NO_ID","NO_IDTYPE",jsonObject.get("Status").toString()+" success for this device :"+jsonObject.get("Id").toString(),request);

            System.out.println("4. data saved in local pms :");
        }
        return returnVal;

    }
