    @RequestMapping( value = "/getPartnerRequestforApproval")
    public String getPArtnerforApproval (HttpServletRequest request) throws NoSuchAlgorithmException, KeyManagementException, JsonProcessingException {
        logger.info("calling from Admin Approval Controller getPartnerRequestforApproval");
        final String transactionId=Transaction.generateTransaction();
        auditRequestFactory.buildRequest(AuditModules.PDMS_ADMIN, AuditEvents.PDMS_ADMIN_EVENT,"NO_ID",transactionId,"Get partner approval request",request);

        turnOffSslChecking();
        APIConnection.authenticate();
        ResourceBundle bundle = APIConnection.readConfig();
        //         /v1/partnermanager/partners
        return APIConnection.connectApi(bundle.getString("base.url")+bundle.getString("version")+bundle.getString("partnermanager.partner.url"),
                "GET","","Cookie");
    }

    private static void allowMethods(String... methods) {
        try {
            Field methodsField = HttpURLConnection.class.getDeclaredField("methods");

            Field modifiersField = Field.class.getDeclaredField("modifiers");
            modifiersField.setAccessible(true);
            modifiersField.setInt(methodsField, methodsField.getModifiers() & ~Modifier.FINAL);

            methodsField.setAccessible(true);

            String[] oldMethods = (String[]) methodsField.get(null);
            Set<String> methodsSet = new LinkedHashSet<>(Arrays.asList(oldMethods));
            methodsSet.addAll(Arrays.asList(methods));
            String[] newMethods = methodsSet.toArray(new String[0]);

            methodsField.set(null/*static field*/, newMethods);
        } catch (NoSuchFieldException | IllegalAccessException e) {
            logger.info("calling from Admin Approval Controller getPartnerRequestforApproval");
            throw new IllegalStateException(e);
        }
    }

