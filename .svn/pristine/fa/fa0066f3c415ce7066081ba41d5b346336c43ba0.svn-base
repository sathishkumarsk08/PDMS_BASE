    public static String sendSMS(String message, String number) throws NoSuchAlgorithmException, KeyManagementException {
        turnOffSslChecking();
        APIConnection.authenticate();
        ResourceBundle bundle = APIConnection.readConfig();
        JSONObject template = new JSONObject(bundle.getString("template"));

        try{
            JSONObject auth_request = template.getJSONObject("request");
            auth_request.put("message",message);
            auth_request.put("number",number);
            template.put("requesttime",APIConnection.formatToISOString(APIConnection.getUTCCurrentDateTime()));
            template.put("request",auth_request);
        }catch (Exception e){
            e.printStackTrace();
        }
        System.out.println("Chk Template :"+template.toString());
        boolean val1 = Boolean.parseBoolean(bundle.getString("sms.notification.enable"));

        if(val1) {

            String record = APIConnection.connectApi(bundle.getString("base.url") + bundle.getString("version") + bundle.getString("sms.url"),
                    "POST", template.toString(), "Cookie");
            System.out.println("sms enable");
        }else{
            System.out.println("sms disabled");
        }
        //         /v1/partnermanager/partners/{"+partnerId+"}
//        APIConnection.connectApi(bundle.getString("base.url")+bundle.getString("version")+bundle.getString("partnermanager.partner.url")+
//                "/{"+jsonObject.get("partnerId")+"}","PATCH",template.toString(),"Cookie");
        return "";
    }
