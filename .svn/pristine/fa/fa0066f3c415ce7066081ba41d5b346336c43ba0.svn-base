    @RequestMapping("/approval")
    public void adminApproval(@RequestBody String adminResult,HttpServletRequest request) throws KeyManagementException, NoSuchAlgorithmException, ParseException, JsonProcessingException {
        logger.info("calling from Admin Approval Controller for approval");
        final String transactionId= Transaction.generateTransaction();
        auditRequestFactory.buildRequest(AuditModules.PDMS_ADMIN, AuditEvents.PDMS_ADMIN_EVENT,"NO_ID",transactionId,"Partner approval request :"+adminResult,request);

        turnOffSslChecking();
        APIConnection.authenticate();
        ResourceBundle bundle = APIConnection.readConfig();
        JSONObject template = new JSONObject(bundle.getString("template"));
        JSONObject jsonObject = new JSONObject(adminResult);
        try{
            JSONObject auth_request = template.getJSONObject("request");
            auth_request.put("status",jsonObject.get("statusApp"));
            template.put("requesttime",APIConnection.formatToISOString(APIConnection.getUTCCurrentDateTime()));
            template.put("request",auth_request);
        }catch (Exception e){
            logger.info("calling from Admin Approval Controller for approval");
            e.printStackTrace();
        }
        System.out.println("Chk Template :"+template.toString());
        //         /v1/partnermanager/partners/{"+partnerId+"}
        APIConnection.connectApi(bundle.getString("base.url")+bundle.getString("version")+bundle.getString("partnermanager.partner.url")+
                        "/{"+jsonObject.get("partnerId")+"}","PATCH",template.toString(),"Cookie");
    }

