    @RequestMapping( value = "/partnerSuspension")
    public boolean partnerSuspension(@RequestBody String suspensionDetail , HttpServletRequest request) throws JsonProcessingException {
        logger.info("calling from Admin Approval Controller partnerSuspension");
        final String transactionId=Transaction.generateTransaction();
        System.out.println("enteres:" +suspensionDetail);
        JSONObject jsonObject = new JSONObject(suspensionDetail);
        String text="";
        String suspenId="";
        boolean check=false;
        String actionPerformed= jsonObject.get("actionPerformed").toString();
        String partnerId= jsonObject.getString("partnerId");

        auditRequestFactory.buildRequest(AuditModules.PDMS_ADMIN,AuditEvents.PDMS_ADMIN_EVENT,"NO_ID",transactionId,"partner suspension request for this partner :"+partnerId,request);

        String userIdGenerate = mspPartnerSuspensionService.maxUserid();
        if (userIdGenerate == null || userIdGenerate.length() == 0 || userIdGenerate.length() <= 5) {
            suspenId = "SP"+APIConnection.formatToGenerateID(APIConnection.getUTCCurrentDateTime())+"00001";
        }else{
            String sentence=userIdGenerate;
            String name= new StringBuilder(sentence).reverse().toString();
            String val= name.substring(0,5);
            String name2= new StringBuilder(val).reverse().toString();
            text = String.format("%0" + name2.length() + "d", Long.parseLong(name2) + 1);
            suspenId = "SP"+APIConnection.formatToGenerateID(APIConnection.getUTCCurrentDateTime())+text;
        }
        PartnerRegistration test = partnerRegistrationService.getEmailId(partnerId);
//        String sentence=partnerId;
//        String name= new StringBuilder(sentence).reverse().toString();
//        String val1= name.substring(0,5);
//        String name2= new StringBuilder(val1).reverse().toString();
//        text = String.format("%0" + text.length() + "d", Long.parseLong(text) + 1);
//        System.out.println("checking:"+text);
//        if(actionPerformed.equals("suspended")){
//            suspenId = "SP"+APIConnection.formatToGenerateID(APIConnection.getUTCCurrentDateTime())+name2;
//            suspenId = "SP"+name2;
//        }else if( actionPerformed.equals("revoke")){
//            suspenId = "RC"+APIConnection.formatToGenerateID(APIConnection.getUTCCurrentDateTime())+text;
//        }else{
//            suspenId = "BL"+APIConnection.formatToGenerateID(APIConnection.getUTCCurrentDateTime())+text;
//        }
        try{
            int count = mspPartnerSuspensionService.checkPartnerId(partnerId);
            if(count <= 2) {
                MSPPartnerSuspension suspen = new MSPPartnerSuspension();
                suspen.setId(jsonObject.get("partnerId").toString());
                suspen.setReason(jsonObject.get("reason").toString());
                String startDate = jsonObject.get("startDate").toString();
                DateTimeFormatter formatter = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm");
                LocalDateTime startDateTime = LocalDateTime.parse(startDate + " 00:00", formatter);
                String endDate = jsonObject.get("endDate").toString();
                LocalDateTime endDateTime = null;
                if (endDate.equals("") || endDate.equals(null)) {
                    endDateTime = null;
                } else {
                    endDateTime = LocalDateTime.parse(endDate + " 00:00", formatter);
                }
                suspen.setStartDate(startDateTime);
                suspen.setEndDate(endDateTime);
                suspen.setCrdtime(APIConnection.getUTCCurrentDateTime());
                suspen.setSusId(suspenId);
                suspen.setCount(++count);
                boolean susCheck = mspPartnerSuspensionService.save(suspen);
                if (susCheck) {
                    auditRequestFactory.buildRequest(AuditModules.PDMS_ADMIN,AuditEvents.PDMS_ADMIN_EVENT,"NO_ID",transactionId,"partner suspension success for this partner :"+partnerId,request);


                    try {
                    String subject = "Partner Suspension Details";
                    String mailTemplate = "Dear " + jsonObject.get("partnerId") + ", <br>\n<br>\n\n" +
                            "                                PartnerId :  " + partnerId + " <br>\n<br>\n\n" +
                            "                                SuspensionId :  " + suspenId + " <br>\n<br>\n\n" +
                            "                                Reason for Suspension :  " + jsonObject.get("reason") + " <br>\n<br>\n\n" +
                            "                                Thanks & Regards,  <br>\n<br>\n\n" +
                            "                                PhilSys";
                    String smsTemplate = "PartnerId :" + partnerId + "SuspensionId :  " + suspenId;

                    EmailNotifyResponseDto response = mailService.emailNotification(test.getEmail(), subject, mailTemplate, "");
                    test = partnerRegistrationService.getEmailId(partnerId);

                    check = partnerRegistrationService.DeActivate(partnerId);

                    partnerRegistrationMSPService.suspendedPartner(actionPerformed, partnerId, suspenId);

                    System.out.println("mail testing:" + response);
                    String val = AdminApprovalController.sendSMS(smsTemplate, test.getContact());
                    System.out.println("5. Mail & sms send success :" + val);

                } catch (Exception e) {
                    suspenId = "";
                    e.printStackTrace();
                    logger.error("Response from RPController for partner suspension", e.getMessage());
                }
                System.out.println("4. data saved in local msppms-partner suspension :");
                logger.info("Response from Admin Approval Controller for partner suspension");
            } else {
                    auditRequestFactory.buildRequest(AuditModules.PDMS_ADMIN,AuditEvents.PDMS_ADMIN_EVENT,"NO_ID",transactionId,"partner suspension failed for this partner :"+partnerId,request);

                }

            }else{
                jsonObject.remove("actionPerformed");
                jsonObject.put("actionPerformed", "blacklist");
                check= partnerBlacklist(jsonObject.toString(),request);

            }

        }catch (Exception e){
            auditRequestFactory.buildRequest(AuditModules.PDMS_ADMIN,AuditEvents.PDMS_ADMIN_EVENT,"NO_ID",transactionId,"partner suspension failed for this partner :"+partnerId,request);

            logger.info("calling from Admin Approval Controller partnerSuspension");
            e.printStackTrace();
        }
        return check;
    }
