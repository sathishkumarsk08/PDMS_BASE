    @RequestMapping("/notificationList")
    public List<NotificationSystem> notificationList(@RequestBody String loginUserId,HttpServletRequest request) throws JsonProcessingException {
        logger.info("calling mspPartnerPolicyRequestService from Admin Approval Controller notificationList");
        final String transactionId=Transaction.generateTransaction();
        auditRequestFactory.buildRequest(AuditModules.PDMS_ADMIN, AuditEvents.PDMS_ADMIN_EVENT,"NO_ID",transactionId,"Notification request",request);

        List<NotificationSystem> list= null;
        try {
            int role = userservice.getUserRole(loginUserId);
            if(role == 2){
                list=  notificationSystem.notificationList(loginUserId);
            }else if(role == 3){
                list=  notificationSystem.notificationListPolicyAdmin();
            } else if( role == 1){
                list=  notificationSystem.notificationListSuperAdmin();
            }



        }catch (Exception e){
            logger.error("calling mspPartnerPolicyRequestService from Admin Approval Controller notificationList",e.getMessage());
            e.printStackTrace();
        }
        return list;
    }
