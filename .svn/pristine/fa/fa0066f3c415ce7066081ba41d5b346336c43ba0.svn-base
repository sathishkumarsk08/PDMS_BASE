    @RequestMapping( value = "/getMispLicense")

    public String getMispLicense(@RequestBody String license,HttpServletRequest request) throws JsonParseException, JsonMappingException, JsonProcessingException, IOException, NoSuchAlgorithmException, KeyManagementException {

        logger.info("calling from Admin Approval Controller getMispLicense");
        final String transactionId=Transaction.generateTransaction();
        mspAuditLogs.setAuditRequestDto(PartnerManageEnum.TSP_LICENSE_KEY ,request);
        System.out.println("1.enter in misp license ");
        turnOffSslChecking();
        APIConnection.authenticate();
        ResourceBundle bundle = APIConnection.readConfig();
        JSONObject template = new JSONObject(bundle.getString("template"));
        JSONObject jsonObject = new JSONObject(license);
        auditRequestFactory.buildRequest(AuditModules.PDMS_ADMIN, AuditEvents.PDMS_ADMIN_EVENT,"NO_ID",transactionId,"Generate tsp license key request for this partner :"+jsonObject.get("partnerId").toString(),request);

        String returnVal="";
        try{
            JSONObject requestTemp =  template.getJSONObject("request");
            requestTemp.put("providerId",jsonObject.get("partnerId"));
            template.put("requesttime",APIConnection.formatToISOString(APIConnection.getUTCCurrentDateTime()));
            template.put("request",requestTemp);
        }catch (Exception e){
            e.printStackTrace();
        }
        System.out.println("2. Template to Msoip:"+template.toString());
        //         /v1/partnermanager/misps
        String record= APIConnection.connectApi(bundle.getString("base.url")+bundle.getString("version")+bundle.getString("partnermanager.partner.misp"),
                "POST",template.toString(),"Cookie");
        System.out.println("3. output from Mosip :"+ record);
        org.json.JSONObject jsoninput = new org.json.JSONObject(record);
        String responseData=(jsoninput.get("response")).toString();
        if( responseData.equals("null")) {
            mspAuditLogs.setAuditRequestDto(PartnerManageEnum.TSP_LICENSE_KEY_FAILURE,request);
            auditRequestFactory.buildRequest(AuditModules.PDMS_ADMIN, AuditEvents.PDMS_ADMIN_EVENT,"NO_ID",transactionId,"Generate tsp license key failed for this partner :"+jsonObject.get("partnerId").toString(),request);

            returnVal="false";
        } else {
            returnVal = "true";
            org.json.JSONObject jsoninput1 = new org.json.JSONObject(responseData);

            MSPMosipLicense lic= new MSPMosipLicense();
            lic.setId(jsonObject.get("partnerId").toString());
            lic.setKey(jsoninput1.get("licenseKey").toString());
            String startDate =jsoninput1.get("licenseKeyExpiry").toString();
            String validFrom =jsoninput.get("responsetime").toString();
//            DateTimeFormatter formatter = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss");
//            DateTimeFormatter formatter = DateTimeFormatter.ofPattern("yyyy-MM-dd'T'HH:mm:ss.SSSXXX");
//            DateTimeFormatter output =  DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss");
//            Date d = sdf.parse(time);
//            String formattedTime = output.format(d);
