    @RequestMapping(value = "/viewMSPPartnerReg")
    public ArrayList<MSPPartnerRegistration> viewMSPPartnerReg(@RequestBody String statusName,HttpServletRequest request) throws JSONException, JsonProcessingException {
        logger.info("calling from RPController for view Partner Registration");
        final String transactionId=Transaction.generateTransaction();
        auditRequestFactory.buildRequest(AuditModules.PDMS_ADMIN, AuditEvents.PDMS_ADMIN_EVENT,"NO_ID",transactionId,"View partner request",request);

        org.json.JSONObject jsonObject = new org.json.JSONObject(statusName);
        ArrayList<MSPPartnerRegistration> regpartner = null;
//		ArrayList<PartnerRegistration> regpartner = null;
        String partStatus = jsonObject.get("status").toString();
        String partnerType = jsonObject.get("type").toString();
        boolean status = false;
        if (jsonObject.get("active").equals("true")) {
            status = true;
        } else {
            status = false;
        }
        if(jsonObject.get("status").equals("Active")){
            partStatus = "approved";
        }else if(jsonObject.get("status").equals("De-Active")){
            partStatus ="approved";
        }
        try {
            System.out.println("testing" + jsonObject.get("status").toString() + "," + status);
//            regpartner = (ArrayList<MSPPartnerRegistration>) mspPartnerSuspensionService.viewPartnerReg(partStatus,status);
            regpartner = (ArrayList<MSPPartnerRegistration>) partnerRegistrationMSPService.viewPartnerReg(partStatus);
//			regpartner = (ArrayList<PartnerRegistration>) partnerRegistrationService.viewPartnerReg(partStatus,status,partnerType);

        } catch (Exception e) {
            logger.error("calling from RPController for view Partner Registration",e.getMessage());
            e.printStackTrace();
        }
        return regpartner;
    }

    @RequestMapping("/apiSubmitRequest")
    public String apiRequests(@RequestBody String request,HttpServletRequest reques) throws JsonParseException, JsonMappingException, JsonProcessingException, IOException, NoSuchAlgorithmException, KeyManagementException {
        logger.info("calling from Admin Approval Controller apiSubmitRequesth");
        final String transactionId=Transaction.generateTransaction();
        auditRequestFactory.buildRequest(AuditModules.PDMS_ADMIN, AuditEvents.PDMS_ADMIN_EVENT,"NO_ID",transactionId,"Api submit request :"+request,reques);

        System.out.println("1.enter in api request  ");
        turnOffSslChecking();
        APIConnection.authenticate();
        ResourceBundle bundle = APIConnection.readConfig();
        JSONObject template = new JSONObject(bundle.getString("template"));
        JSONObject requestFrmUI = new JSONObject(request);
        String returnVal= "";
        String partnerId="";
        try{
            System.out.println("coding testing:"+requestFrmUI);
            JSONObject requestTemp = template.getJSONObject("request");
            requestTemp.put("policyName",requestFrmUI.get("policyTypeId"));
            requestTemp.put("useCaseDescription",requestFrmUI.get("useCaseDesc"));
            template.put("request",requestTemp);
            template.put("requesttime",APIConnection.formatToISOString(APIConnection.getUTCCurrentDateTime()));

            System.out.println("2. Template to Msoip:"+template.toString());
             partnerId= requestFrmUI.get("partnerId").toString();
//    //  /v1/partnermanager/partners/"+partnerId+"/apikey/request
        }catch (Exception e){
            logger.info("callinge from Admin Approval Controller apiSubmitRequesth");
            e.printStackTrace();
        }
        String record=  APIConnection.connectApi(bundle.getString("base.url")+bundle.getString("version")+bundle.getString("partnermanager.partner.url")
                +"/"+partnerId+"/apikey/request","PATCH",template.toString(),"Cookie");

        System.out.println("3. output from Mosip :"+ record);
        org.json.JSONObject jsoninput = new org.json.JSONObject(record);
        String responseData=(jsoninput.get("response")).toString();
        System.out.println("response "+responseData);
        if( responseData.equals("null")) {
            returnVal="false";
        } else {
            returnVal = "true";
            org.json.JSONObject jsoninput1 = new org.json.JSONObject(responseData);
            System.out.println("response data :"+ jsoninput1);
            System.out.println("response value:" + jsoninput1.get("apiRequestId"));
            MSPPartnerPolicyRequest req= new MSPPartnerPolicyRequest();
            req.setApiKey(jsoninput1.get("apiRequestId").toString());
            req.setPartId(requestFrmUI.get("partnerId").toString());
            req.setPolicyId(requestFrmUI.get("policyTypeId").toString());
            req.setRequestDtime(APIConnection.getUTCCurrentDateTime());
            req.setRequestDet(requestFrmUI.get("useCaseDesc").toString());
            req.setCrBy("11011");
            req.setCrDtime(APIConnection.getUTCCurrentDateTime());
            req.setStatusCode("InProgress");
            System.out.println("4. data saved in local pms :");
            mspPartnerPolicyRequestService.save(req);

        }
        return record;
    }

    @RequestMapping("/approveApi")
    public String approveApi(@RequestBody String request,HttpServletRequest reques) throws NoSuchAlgorithmException, KeyManagementException, JsonProcessingException {
        logger.info("calling from Admin Approval Controller approveApi");
        final String transactionId=Transaction.generateTransaction();
        auditRequestFactory.buildRequest(AuditModules.PDMS_ADMIN, AuditEvents.PDMS_ADMIN_EVENT,"NO_ID",transactionId,"Approval request :"+request,reques);

        System.out.println("1.enter in approval api ");
        turnOffSslChecking();
        APIConnection.authenticate();
        String returnVal="";
        ResourceBundle bundle = APIConnection.readConfig();
        JSONObject template = new JSONObject(bundle.getString("template"));
        JSONObject jsonObject = new JSONObject(request);
        try{
            JSONObject requestTemp = template.getJSONObject("request");
            requestTemp.put("status",jsonObject.get("status"));
            template.put("requesttime",APIConnection.formatToISOString(APIConnection.getUTCCurrentDateTime()));
            template.put("request",requestTemp);
        }catch (Exception e){
            logger.info("callinge from Admin Approval Controller approveApi");
            e.printStackTrace();
        }
        System.out.println("2. Template to Msoip:"+template.toString());
        //         /v1/partnermanager/partners/apikey/"+apiKey
        String record= APIConnection.connectApi(bundle.getString("base.url")+bundle.getString("version")+bundle.getString("partnermanager.partner.url")+
                "/apikey/"+jsonObject.get("apiKey"),"PATCH",template.toString(),"Cookie");
        System.out.println("3. output from Mosip :"+ record);
        org.json.JSONObject jsoninput = new org.json.JSONObject(record);
        String responseData=(jsoninput.get("response")).toString();
        System.out.println("response "+responseData);
        if( responseData.equals("null")) {
            returnVal="false";
        } else {
            returnVal = "true";
            if(jsonObject.get("status").toString().equals("Approved")){
                mspPartnerPolicyRequestService.changeStatus(jsonObject.get("apiKey").toString());
                PartnerPolicy getApi=  partnerPolicyService.getAPiKeyDetails(jsonObject.get("apiKey").toString());
                MSPPartnerPolicy setApi= new MSPPartnerPolicy();
                setApi.setId(getApi.getId());
                setApi.setPartId(getApi.getPartId());
                setApi.setPolicyId(getApi.getPolicyId());
                setApi.setValidFrom(getApi.getValidFrom());
                setApi.setValidTo(getApi.getValidTo());
                setApi.setActive(getApi.isActive());
                setApi.setCrBy(getApi.getCrBy());
                setApi.setCrtDtime(getApi.getCrtDtime());
                setApi.setDelDtime(getApi.getDelDtime());
                setApi.setDeleted(getApi.isDeleted());
                mspPartnerPolicyService.save(setApi);
//                MSPPartnerRegistration reg = partnerRegistrationMSPService.getEmailId(jsonObject.get("apiKey").toString());
                PartnerRegistration reg = partnerRegistrationService.getEmailId(getApi.getPartId());

                ResourceBundle mailBundle = APIConnection.readConfig();
//			JsonMapper jsonMapper = new JsonMapper();
                String subject="API Key Details";
                String mailTemplate = "Dear " + reg.getName() + ", <br>\n<br>\n\n" +
                        "                                Partner Policy Key(API Key) :  " + getApi.getId() + " <br>\n<br>\n\n" +
                        "                                Thanks & Regards,  <br>\n<br>\n\n" +
                        "                                PhilSys";

//                boolean mailResponse = new ApiController().sendmailprocess( reg.getEmailId(), "Partner Policy Key", mailTemplate);
////				boolean mailResponse = new ApiController().sendmailprocess( "arunkrishna1410@gmail.com", "PARTNER Captcha", mailTemplate);
//                if(mailResponse){
//                    System.out.println("------APIKey send------");
//
//                }else{
//                    returnVal = "";
//                }
                try{
                    EmailNotifyResponseDto response = mailService.emailNotification(reg.getEmail(),subject,mailTemplate,"");
                    System.out.println("mail testing:"+response);
                }catch (Exception e){
                    e.printStackTrace();
                }
                System.out.println("4. data saved in local pms :");

            }
        }
        return record;
    }

