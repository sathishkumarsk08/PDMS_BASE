    @RequestMapping(value = "/validationMail")
    public String validationMispLicense(){
        LocalDate now = LocalDate.now();
        LocalDate thirty = now.plusDays( 30 );
        LocalDate sixty = now.plusDays( 60 );
        LocalDate ninety = now.plusDays( 90 );
        LocalDate week = now.plusDays( 7 );
        LocalDate oneDay = now.plusDays( 1 );
        LocalDate expired = now;
        LocalDate dates[] = {thirty, sixty, ninety, week, oneDay,expired };
        String number []= {" Expires with in 30 days"," Expires with in 60 days"," Expires with in 90 days"," Expires with in 1 week"," Expires with in one Day" ,"Expired"};
        List<MSPMosipLicense> thirtyValidateSchedule = null;
        String subject = "License Expiry Date";
        for(int j=0;j <dates.length ;j++) {
            DateTimeFormatter formatter = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss");
            LocalDateTime startDateTime = LocalDateTime.parse(dates[j] + " 00:00:00", formatter);
            LocalDateTime endDateTime = LocalDateTime.parse(dates[j] + " 23:59:59", formatter);
            thirtyValidateSchedule = mspMsipLicenseService.getValidationSchedule(startDateTime, endDateTime);
            for (int i = 0; i < thirtyValidateSchedule.size(); i++) {
                MSPPartnerRegistration reg = partnerRegistrationMSPService.getEmailId(thirtyValidateSchedule.get(i).getId());
                String mailTemplate = "Dear " + reg.getOrganisationName() + ", <br>\n<br>\n\n" +
                        "                               License "+ number[j] +" <br>\n<br>\n\n" +
                        "                                Thanks & Regards,  <br>\n<br>\n\n" +
                        "                                PhilSys";

//				boolean mailResponse = new ApiController().sendmailprocess(reg.getEmailId(), "Signed Certificate", mailTemplate);

//				if (mailResponse) {
//					System.out.println("------partnerId send------");
//
//				}
                try{
                    EmailNotifyResponseDto response = mailService.emailNotification(reg.getEmailId(),subject,mailTemplate,"");

                    System.out.println("mail testing:"+response);
                }catch (Exception e){
                    e.printStackTrace();
                }

                System.out.println("4. data saved in local pms -signed  :");
            }
        }
        return "success";
    }
    @RequestMapping("/CountPartnerSuspension")
    public int getCountPartnerSuspension(@RequestBody Map<String, String> requestParams){
        logger.info("calling count partner suspension in admin controller");
        String partnerId = requestParams.get("partnerId");
        String val = requestParams.get("type");
        int count=0;
        if(val.equals("partner")){
             count = mspPartnerSuspensionService.checkPartnerId(partnerId);
        }else{
            count = mspDeviceSuspensionService.checkPartnerId(partnerId);
        }

        return count;

    }

}