    @RequestMapping(value = "/validationBlacklistDetail")
    public void validationBlacklistDetail(){
        LocalDate now = LocalDate.now();
        LocalDate expired = now;
        ArrayList<partnerblacklisted> expiredBlacklisted = null;

        String partnerId="";
        int updatedId = 0;
        DateTimeFormatter formatter = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss");
        LocalDateTime startDateTime = LocalDateTime.parse(now + " 00:00:00", formatter);
        LocalDateTime endDateTime = LocalDateTime.parse(now + " 23:59:59", formatter);
        expiredBlacklisted = mspBacklistService.getExpiredBlackListed(startDateTime, endDateTime);
        System.out.println("expiredSuspension " );
        for (int i = 0; i < expiredBlacklisted.size(); i++) {
            partnerId = expiredBlacklisted.get(i).getPartnerId();
            try{
                int val = partnerRegistrationMSPService.deleteBlackListId(partnerId);
                PartnerRegistration getDetails = partnerRegistrationService.getEmailId(partnerId);
                if(getDetails.getCertificate() != null && getDetails.getApprovalStatus() != "InProgress"  ){
                     updatedId = partnerRegistrationService.updatePartnerStatus(partnerId);
                }
                if(val >0 || updatedId > 0){
                    String subject = "Partner Activate Details";
                    String mailTemplate = "Dear " + getDetails.getName() + ", <br>\n<br>\n\n" +
                            "                                PartnerId :  " + partnerId + " <br>\n<br>\n\n" +
                            "                                Blacklisted Partner Activated now. <br>\n<br>\n\n" +
                            "                                Thanks & Regards,  <br>\n<br>\n\n" +
                            "                                PhilSys";
                    String smsTemplate = "PartnerId :" + partnerId + " Blacklisted Partner Activated now.";

                    EmailNotifyResponseDto response = mailService.emailNotification(getDetails.getEmail(), subject, mailTemplate, "");
                    System.out.println("mail testing:" + response);
                    String val1 = AdminApprovalController.sendSMS(smsTemplate, getDetails.getContact());
                }
                System.out.println("expiredSuspension of:" +partnerId );
            }catch(Exception e){
                e.printStackTrace();
            }

        }
    }
