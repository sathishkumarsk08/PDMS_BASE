        String backId="";
        String userIdGenerate = mspDeviceBlacklistedService.maxUserid();
        if (userIdGenerate == null || userIdGenerate.length() == 0 || userIdGenerate.length() <= 5) {
//            suspenId = "SP"+APIConnection.formatToGenerateID(APIConnection.getUTCCurrentDateTime())+"00001";
            backId="BL"+APIConnection.formatToGenerateID(APIConnection.getUTCCurrentDateTime())+"00001";
        }else{
            String sentence=userIdGenerate;
            String name= new StringBuilder(sentence).reverse().toString();
            String val= name.substring(0,5);
            String name2= new StringBuilder(val).reverse().toString();
            text = String.format("%0" + name2.length() + "d", Long.parseLong(name2) + 1);
//            suspenId = "SP"+APIConnection.formatToGenerateID(APIConnection.getUTCCurrentDateTime())+text;
            backId="BL"+APIConnection.formatToGenerateID(APIConnection.getUTCCurrentDateTime())+text;
        }

        try{
            DeviceBlacklisted devback = new DeviceBlacklisted();
            devback.setDeviceId(jsonObject.get("partnerId").toString());
            devback.setReason(jsonObject.get("reason").toString());
            String startDate =jsonObject.get("startDate").toString();
            DateTimeFormatter formatter = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm");
            LocalDateTime startDateTime = LocalDateTime.parse(startDate+" 00:00", formatter);
            String endDate =jsonObject.get("endDate").toString();
            LocalDateTime endDateTime = null;
            if(endDate.equals("") || endDate.equals(null)){
                endDateTime= null;
            }else{
                endDateTime = LocalDateTime.parse(endDate+" 00:00", formatter);
            }
            devback.setEffdate(startDateTime);
            devback.setEnddate(endDateTime);
            devback.setCrDtTime(APIConnection.getUTCCurrentDateTime());
            devback.setId(backId);
            PartnerRegistration test = partnerRegistrationService.getEmailId(partnerId);
            System.out.println(test.getEmail());
            System.out.println(test.getContact());
//
//            mspBacklistService.save(backpen);
            boolean susCheck =   mspDeviceBlacklistedService.save(devback);
            if(susCheck){
                auditRequestFactory.buildRequest(AuditModules.PDMS_ADMIN,AuditEvents.PDMS_ADMIN_EVENT,"NO_ID",transactionId,"blacklisting success for this device :"+partnerId,request);


                try {
                    String subject = "Device Blacklisted Details";
                    String mailTemplate = "Dear " + jsonObject.get("partnerId") + ", <br>\n<br>\n\n" +
                            "                                DeviceId :  " + partnerId + " <br>\n<br>\n\n" +
                            "                                BacklistedId :  " + backId + " <br>\n<br>\n\n" +
                            "                                Reason for backlisted :  " + jsonObject.get("reason") + " <br>\n<br>\n\n" +
                            "                                Thanks & Regards,  <br>\n<br>\n\n" +
                            "                                PhilSys";
                    String smsTemplate = "DeviceId :" + partnerId + "BacklistedId :  " + backId ;

                    EmailNotifyResponseDto response = mailService.emailNotification(test.getEmail(), subject, mailTemplate,"");
                    check=partnerRegistrationService.DeActivate(partnerId);
                    deviceModelRegistrationMSPService.suspendedDevice(actionPerformed,partnerId,backId);

                    System.out.println("mail testing:" + response);
                    String val= AdminApprovalController.sendSMS(smsTemplate , test.getContact());
                    System.out.println("5. Mail & sms send success :"+val);

                } catch (Exception e) {
                    backId = "";
                    e.printStackTrace();
                    logger.error("Response from RPController for partner backlisted",e.getMessage());
                }
                System.out.println("4. data saved in local msppms-partner backlisted :");
                logger.info("Response from Admin Approval Controller for partner backlisted");
            }
            else {
                auditRequestFactory.buildRequest(AuditModules.PDMS_ADMIN,AuditEvents.PDMS_ADMIN_EVENT,"NO_ID",transactionId,"blacklisting failed for this device :"+partnerId,request);

            }

        }catch (Exception e){
            logger.error("calling from Admin Approval Controller device Backlist",e.getMessage());
            e.printStackTrace();
            auditRequestFactory.buildRequest(AuditModules.PDMS_ADMIN,AuditEvents.PDMS_ADMIN_EVENT,"NO_ID",transactionId,"blacklisting failed for this device :"+partnerId,request);

        }
        return check;
    }

