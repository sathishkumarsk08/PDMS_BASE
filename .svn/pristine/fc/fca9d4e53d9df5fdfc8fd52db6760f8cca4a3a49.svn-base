    public boolean updateMSPPartnerRegistration(MSPDeviceModelRegistration mspDevice, String deviceId) {
            boolean out = true;
            try {
                MSPDeviceModelRegistration s=mspDeviceRegistrationRepository.findAllById(deviceId);
//                s.setDeviceStatus(mspDevice.getDeviceStatus());
              s.setAddress(mspDevice.getAddress());
              s.setMobilenumber(mspDevice.getMobilenumber());
//              s.setDeviceModel(mspDevice.getDeviceModel());
//              s.setDeviceType(mspDevice.getDeviceType());
//              s.setBrandName(mspDevice.getBrandName());
                mspDeviceRegistrationRepository.save(s);

                out = true;
            } catch (Exception e) {
                e.printStackTrace();
                out = false;
            }

            return out;

    }

