    public boolean updateMOSIPPartnerRegistration(PartnerRegistration user, String id) {
            boolean out = true;
            try {
                PartnerRegistration s=partnerRegistrationRepository.findAllById(id);
                s.setAddress(user.getAddress());
                s.setContact(user.getContact());
//                s.setActive(user.getActive());
                partnerRegistrationRepository.save(s);

                out = true;
            } catch (Exception e) {
                e.printStackTrace();
                out = false;
            }

            return out;
        }

